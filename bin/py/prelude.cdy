;;; Prelude: definitions every program gets (doc/hl_rqmt/system_prelude.md). It is a module
;;; that every other file imports without saying so, kept next to the translator, like
;;; system.cdy. A file's own definitions win over the prelude's, as over any import.
;;;
;;; The list, string and map operations are built-ins (system.cdy), since lists, strings
;;; and maps are the host's (doc/hl_rqmt/library.md, "Built-in or prelude"); for lists it
;;; is also speed, since Candy adds to a list by copying it. The prelude holds what is
;;; built on top of them.

;; All of `xs` but the first item; the empty list's rest is empty, as `drop`'s.
(sig rest (Fn ((List a)) (List a)))
(defn rest (xs) (drop 1 xs))

;; An optional value, *lasting* (spec/60-library.md, library.maybe): `(Some v)`, or `None`.
(deft (Maybe a) (Some ((v a))) (None))

;; A result that may be an expected failure, *lasting* (spec/60-library.md, library.errors):
;; `(Ok v)`, or `(Err err)`, taken apart with `match`. A bug is a panic, `fail`.
(deft (Result a e) (Ok ((v a))) (Err ((err e))))

;; The first item of `xs` that `keep` is true of.
(sig find (Fn ((Fn (a) Bool) (List a)) (Maybe a)))
(defn find (keep xs) (let ((i (find-index keep xs))) (if (< i 0) None (Some (at xs i)))))

;; The index of the first item of `xs` equal to `x`.
(sig index-of (Fn (equatable (List equatable)) (Maybe Int)))
(defn index-of (x xs) (let ((i (elem-index x xs))) (if (< i 0) None (Some i))))

;; `m`'s value, or `fallback` if it is None.
(sig with-default (Fn (a (Maybe a)) a))
(defn with-default (fallback m) (match m ((Some v) v) ((None) fallback)))

;; `m` with the value at `key` replaced by `f` of it; `key` must be in `m`.
(sig map-update (Fn ((Map k v) k (Fn (v) v)) (Map k v)))
(defn map-update (m key f) (map-set m key (f (map-get m key))))
