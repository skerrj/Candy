;;; The prelude's macros: every file can use them without import-macros (expand.cdy).
;;; Like any macro file, this one can't use its own macros, so it is written without cond.

;; (cond (test expr)* (else expr)?): the expr of the first test that is true, or nil.
;; The clauses become nested ifs: (if test1 expr1 (if test2 expr2 ...)); with no else, the
;; last is an if with no else, checked as one (spec/25-checking.md, checking.if).
(defmacro cond clauses
  (if (= (len clauses) 0)
    (fail "needs at least one (test expr) clause")
    (cond-from clauses (- (len clauses) 1) empty-list)))

;; The clauses up to `i` as nested ifs around `other`, the form for the clauses after it,
;; none for the last (built from the last clause back, as a loop).
(sig cond-from (Fn ((List Form) Int (List Form)) Form))
(defn cond-from (clauses i other)
  (if (< i 0)
    (at other 0)
    (let ((items (list-items (at clauses i))))
      (if (!= (len items) 2)
        (fail "clause must be (test expr)")
        (if (= (sym-name (at items 0)) "else")
          (if (= i (- (len clauses) 1))
            (cond-from clauses (- i 1) (to-list (at items 1)))
            (fail "(else expr) must be the last clause"))
          (cond-from clauses (- i 1)
            (to-list
              (if (= (len other) 0)
                (quasi (if (unq (at items 0)) (unq (at items 1))))
                (quasi (if (unq (at items 0)) (unq (at items 1)) (unq (at other 0))))))))))))

;; (put x*): the values' texts (`text`: a String or a Char as itself, anything else as
;; `show` writes it), a space between them, as one line (library.put).
(defmacro put args
  (if (= (len args) 0)
    (quasi (put-line ""))
    (if (= (len args) 1)
      (quasi (put-line (text (unq (at args 0)))))
      (quasi (put-line (++ (unq-sp (put-parts args 1 (to-list (quasi (text (unq (at args 0)))))))))))))

;; The texts of `args` from `i` on, each after a " ", added to `acc`.
(sig put-parts (Fn ((List Form) Int (List Form)) (List Form)))
(defn put-parts (args i acc)
  (if (= i (len args))
    acc
    (put-parts args (+ i 1) (++ acc (List (quasi " ") (quasi (text (unq (at args i)))))))))
