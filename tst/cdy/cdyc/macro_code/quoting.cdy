;; quo and quasi build Form values (doc/hl_rqmt/macros.md, step 2). They are only allowed
;; in macro code, so test_self_host.py translates this as macro code, with Form from the
;; translator's form.cdy, as a macro program has it.
(import ../../../../src/cdy/form)

;; A form written back as text.
(sig show (Fn (Form) String))
(defn show (form)
  (match form
    ((Sym name _) name)
    ((Lst items _) (format "({(join (show-all items empty-list) \" \")})"))
    ((Txt val _) (format "\"{val}\""))
    ((IntLit val _) (format "{val}"))
    ((LongLit val _) (format "{val}l"))
    ((ByteLit val _) (format "{val}b"))
    ((FloatLit val _) (format "{val}f"))
    ((DoubleLit val _) (format "{val}"))
    ((CharLit val _) (format "\\{val}"))
    ((BoolLit val _) (if val "true" "false"))))

(sig show-all (Fn ((List Form) (List String)) (List String)))
(defn show-all (forms acc)
  (if (= (len forms) 0) acc (show-all (rest-of forms) (++ acc (to-list (show (at forms 0)))))))

(put-line (show (quo (if (< x 1) "small" (f x 2.5 3.0f 7l 2b \c true ())))))
(put-line (text (= (form-pos (quo x)) NOWHERE)))

(sig test Form)
(def test (quo (ready)))
(sig args (List Form))
(def args (Tup (quo a) (quo (b c))))
(put-line (show (quasi (when (unq test) (go (unq-sp args)) (unq-sp empty-list) done))))
(put-line (show (quasi (unq (Sym "plain" NOWHERE)))))
(put-line (show (quasi ((unq-sp args)))))
