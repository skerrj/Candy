;; A name list (spec/10-programs.md, programs.import): (import m (a b)) makes only the names
;; it lists unqualified, and the module's others are reached as m.name. lib/shapes and
;; lib/tags both define `label`, but only one import lists it, so it isn't a clash; (import
;; m ()) makes no name unqualified.
(import lib/shapes (Shape Circle area label))
(import lib/tags ())

(sig sq Shape)
(def sq (shapes.Square 2.0))

(put label tags.label (area (Circle 1.0)) (area sq))
(put (match sq ((Circle _) "circle") ((shapes.Square s) (format "square {s}"))))
(put (get (shapes.origin nil) y) (tags.tag nil))
