;; The prelude (src/cdy/prelude.cdy), which every file gets without importing it.
(sig nums (List Int))
(def nums (tup 1 2 3 4 5))

(put (rest nums))
(put (map (fn (n) (* n n)) nums))
(put (filter (fn (n) (= (quot n 2) (/ n 2.0))) nums))
(put (fold (fn (acc n) (+ acc n)) 0 nums))
(put (fold (fn (acc s) (+ acc s)) "" (map (fn (n) (format "{n}")) nums)))
(put (rest (tup "only")))
