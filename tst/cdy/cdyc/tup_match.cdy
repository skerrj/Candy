;; Taking a tup apart with match, anywhere an expression goes (not only in a let binding).
(sig divmod (Fn (Int Int) (Tup Int Int)))
(defn divmod (a b) (tup (quot a b) (- a (* b (quot a b)))))

(sig show (Fn ((Tup Int Int)) String))
(defn show (qr) (match qr ((tup q r) (format "q={q} r={r}"))))

(put (show (divmod 17 5)))
(put (+ 1 (match (divmod 17 5) ((tup q _) q))))
(put (match (tup "a" 2 true) ((tup _ _ flag) flag)))

;; In a tail position, and nested: the names shadow outer ones.
(sig swap-sum (Fn ((Tup Int Int)) Int))
(defn swap-sum (p)
  (match p
    ((tup a b)
      (match (tup b a)
        ((tup a b) (- a b))))))
(put (swap-sum (tup 10 3)))
