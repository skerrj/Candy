;;; Slice 1a of the self-hosted translator: literals, symbols, calls, if, cond, do,
;;; sig, def, defn.

(sig sq (Fn (Int) Int))
(defn sq (x) (* x x))

(sig fact (Fn (Int) Int))
(defn fact (n) (if (< n 2) 1 (* n (fact (- n 1)))))

(sig sign (Fn (Int) String))
(defn sign (n)
  (cond
    ((< n 0) "negative")
    ((= n 0) "zero")
    (else "positive")))

(sig shout (Fn (String) Unit))
(defn shout (s) (do (put s) (put (+ s "!"))))

;; A do in value position needs a temporary.
(sig noisy (Fn (Int) Int))
(defn noisy (n) (+ 1 (if (> n 0) (do (put "pos") n) 0)))

(sig ten Int)
(def ten (sq (+ 1 2)))

(put ten (fact 5) (sign -3) (sign 0) (sign 7))
(shout "hey")
(put (noisy 4) (noisy -1))
(put (and true (not false)) (or false true) 2.5 1500l \c (at "abc" 1) (slice "hello" 1 3))
(put (len "abc") PI)
