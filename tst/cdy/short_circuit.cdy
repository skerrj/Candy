;; `and` and `or` short-circuit, even when a later argument needs statements first (here a
;; `do`, whose earlier forms run for effect).
(sig loud (Fn (String Bool) Bool))
(defn loud (msg val) (do (put msg) val))

(put (and false (do (put "and: never") true)))
(put (or true (do (put "or: never") false)))
(put (and true (do (put "and: second") true) (do (put "and: third") false) (do (put "and: never") true)))
(put (or false (do (put "or: second") false) (do (put "or: third") true) (do (put "or: never") true)))
(put (and (loud "and: first" true) (do (put "and: last") true)))

(sig check (Fn (Int) String))
(defn check (n)
  (if (or (< n 0) (do (put "  checking") (> n 10))) "out" "in"))
(put (check -1))
(put (check 5))
