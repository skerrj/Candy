{
  "name": "candy",
  "displayName": "Candy",
  "description": "Syntax highlighting for Candy (.cdy)",
  "version": "0.1.0",
  "publisher": "candy-local",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "candy",
        "aliases": [
          "Candy",
          "candy",
          "cdy"
        ],
        "extensions": [
          ".cdy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "candy",
        "scopeName": "source.candy",
        "path": "./syntaxes/candy.tmLanguage.json"
      }
    ]
  }
}
