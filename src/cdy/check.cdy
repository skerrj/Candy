;;; Check: Candy's type checker, on Core (doc/hl_rqmt/type_checker.md). Every top-level
;;; name has its sig, every built-in its type (system.cdy); locals get fresh type
;;; variables, solved by unification (no let-polymorphism). A type variable the checker
;;; makes is named ?N; one a sig writes (a) is rigid in its definition and instantiated
;;; with fresh ones at each use. A fresh one for a constraint variable (`number`,
;;; spec/25-checking.md, checking.constraints) carries the constraint in its name, after a
;;; colon, ?N:number (keep-constraint), which bind-constrained reads back: the name keeps
;;; unify a function of the substitution alone. No program can write a ?-name (it isn't
;;; lowercase, so it is read as a type), and a message shows one as its constraint. `Any`
;;; unifies with everything.
;;; A type error is the translator's error (type-check), at the innermost node with a
;;; position. Checked, every node of Core has its type (`t`; see "typed Core", below).

(import form)
(import core)

;; What the checker knows, read-only while it checks a definition: each global's type,
;; each record's and variant's type variables and fields, each variant's sum, each sum's
;; type variables and variants, the built-ins, where the node being checked is (for the
;; messages), the locals' types, by local-key, and, inside a match clause on a local, the
;; local's variant (narrowing, spec/25-checking.md, checking.narrowing).
(deft Ctx
  ((globals (Map String CType))
   (shapes (Map String Shape))
   (sums (Map String Shape))
   (builtins (Map String Builtin))
   (here Pos)
   (env (Map String CType))
   (narrowed (Map String String))))

;; A record's, variant's or sum's type variables, its fields (none for a sum) and, for a
;; variant, its sum (else "").
(deft Shape ((tvars (List String)) (fields (List (Tup String CType))) (sum String)))

;; The checker's state, threaded through: the substitution (each ?N's type), the next N,
;; the messages so far, the type of each node checked, by its name (?eK, typed Core), and
;; the definition's field constraints still to solve.
(deft St ((subst (Map String CType)) (n Int) (errors (List String)) (types (Map String CType)) (pending (List Pending))))

;; A field constraint (checking.order): a get or assoc (`what`) of `field` on `obj`, whose
;; type, `on`, was a variable when it was read; the field's type is to be `t`. Solved once
;; the definition is checked (solve-pending), at `here`.
(deft Pending ((obj Expr) (field String) (what String) (on CType) (t CType) (here Pos)))

;; An expression's type, and the state after it.
(deft Res ((t CType) (st St)))

(sig tcon (Fn (String) CType))
(defn tcon (name) (TCon name empty-list))

;; --- the program ---

;; `tops`, a whole program (every module's, by global name), if it type-checks; else fail
;; with the first type error.
(sig type-check (Fn ((List Top) (Map String Builtin)) (List Top)))
(defn type-check (tops builtins)
  (let (((typed-tops errors) (check-program tops builtins))
        (order-errors (if (= (len errors) 0) (check-order tops (order-of tops) empty-map) empty-list)))
    (cond
      ((> (len errors) 0) (fail (at errors 0)))
      ((> (len order-errors) 0) (fail (at order-errors 0)))
      (else typed-tops))))

;; `tops` typed, and the type errors in them, in order.
(sig check-program (Fn ((List Top) (Map String Builtin)) (Tup (List Top) (List String))))
(defn check-program (tops builtins)
  (let ((ctx (Ctx (top-types tops) (top-shapes tops) (top-sums tops) builtins NOWHERE empty-map empty-map)))
    (check-tops tops ctx (St empty-map 0 empty-list empty-map empty-list))))

;; Each definition named (typed Core), checked, then typed with what the check found.
(sig check-tops (Fn ((List Top) Ctx St) (Tup (List Top) (List String))))
(defn check-tops (tops ctx st)
  (let (((st1 done)
          (map-acc
            (fn (s top)
              (let ((named (retype-top top (fn (t k) (TVar (format "?e{k}")))))
                    (s1 (solve-pending ctx (check-top named ctx (assoc (assoc s subst empty-map) types empty-map)))))
                (Tup s1 (retype-top named (fn (t k) (node-type t s1))))))
            st
            tops)))
    (Tup done (get st1 errors))))

(sig check-top (Fn (Top Ctx St) St))
(defn check-top (top ctx st)
  (match top
    ((TDef name init t pos)
      (check-expr init t (format "def {(shown-name name)}") (assoc ctx here pos) st))
    ((TDefn name params body t pos)
      (let ((c (assoc ctx here pos)))
        (match t
          ((TFn ptypes ret)
            (let ((inside (body-types ptypes)))
              (check-expr body ret (format "defn {(shown-name name)}") (assoc c env (bind-all params inside (get c env) 0)) (typed-all params inside st))))
          (else st))))
    ((TExpr e) (get (infer e ctx st) st))
    (else st)))

;; A function's parameter types as its body sees them: a rest parameter, `(Rest t)`, is a
;; `(List t)` (types.rest).
(sig body-types (Fn ((List CType)) (List CType)))
(defn body-types (ptypes)
  (map (fn (p) (if (is-rest p) (TCon "List" (rest-item p)) p)) ptypes))

;; `env` with each of `params` (Locals) bound to the type at its index in `types`.
(sig bind-all (Fn ((List Expr) (List CType) (Map String CType) Int) (Map String CType)))
(defn bind-all (params types env i)
  (if (or (= i (len params)) (= i (len types)))
    env
    (bind-all params types (map-set env (local-key (at params i)) (at types i)) (+ i 1))))

(sig local-key (Fn (Expr) String))
(defn local-key (e)
  (match e
    ((Local name id _ _) (format "{name}#{id}"))
    (else "")))

;; The type of each def and defn (its sig), record and variant (its constructor).
(sig top-types (Fn ((List Top)) (Map String CType)))
(defn top-types (tops)
  (fold
    (fn (acc top)
      (match top
        ((TDef name _ t _) (map-set acc name t))
        ((TDefn name _ _ t _) (map-set acc name t))
        ((TDeft name tvars fields) (map-set acc name (TFn (fields-types fields) (TCon name (tvar-types tvars)))))
        ((TDeftSum name tvars variants) (variant-types variants (TCon name (tvar-types tvars)) acc))
        (else acc)))
    empty-map
    tops))

(sig variant-types (Fn ((List Variant) CType (Map String CType)) (Map String CType)))
(defn variant-types (variants sum start)
  (fold (fn (acc v) (map-set acc (get v name) (TFn (fields-types (get v fields)) sum))) start variants))

(sig fields-types (Fn ((List (Tup String CType))) (List CType)))
(defn fields-types (fields) (map (fn (f) (let (((_name t) f)) t)) fields))

(sig tvar-types (Fn ((List String)) (List CType)))
(defn tvar-types (names) (map (fn (name) (TVar name)) names))

(sig top-shapes (Fn ((List Top)) (Map String Shape)))
(defn top-shapes (tops)
  (fold
    (fn (acc top)
      (match top
        ((TDeft name tvars fields) (map-set acc name (Shape tvars fields "")))
        ((TDeftSum name tvars variants) (variant-shapes variants tvars name acc))
        (else acc)))
    empty-map
    tops))

(sig variant-shapes (Fn ((List Variant) (List String) String (Map String Shape)) (Map String Shape)))
(defn variant-shapes (variants tvars sum start)
  (fold (fn (acc v) (map-set acc (get v name) (Shape tvars (get v fields) sum))) start variants))

;; Each sum's type variables, its variants' names as its "fields" (with no types).
(sig top-sums (Fn ((List Top)) (Map String Shape)))
(defn top-sums (tops)
  (fold
    (fn (acc top)
      (match top
        ((TDeftSum name tvars variants)
          (map-set acc name (Shape tvars (map (fn (v) (Tup (get v name) ANY)) variants) "")))
        (else acc)))
    empty-map
    tops))

;; --- expressions ---

;; `e` checked against the type `want`: an if's branches, a do's last form, a let's body
;; and a match's clauses each against it, a fn as check-lambda does, anything else
;; inferred and then accepted (accepts).
(sig check-expr (Fn (Expr CType String Ctx St) St))
(defn check-expr (e want what outer st)
  (let ((ctx (at-node e outer)))
    (match e
      ((If test then other _ _)
        ;; Against a variable not yet solved (a generic function's argument), the branches
        ;; are inferred, so that two that differ say so ("if: the branches are ...").
        (if (is-var (prune want (get st subst)))
          (infer-expect e want what ctx st)
          (let ((rt (infer test ctx st))
                (st1 (expect-is (tcon "Bool") (get rt t) "if: the test" ctx (get rt st))))
            (typed e want (check-expr other want what ctx (check-expr then want what ctx st1))))))
      ((Do body _ _)
        (typed e want
          (if (= (len body) 0)
            (expect want (tcon "Unit") what ctx st)
            (check-expr (at body (- (len body) 1)) want what ctx (get (infer-do (slice body 0 (- (len body) 1)) ctx (Res ANY st)) st)))))
      ((Call callee args _ _)
        (match callee
          ((Lambda params body _ _)
            (if (= (len params) (len args))
              (let (((ts st0) (infer-all args ctx st))
                    (st1 (typed-all params ts (typed callee (TFn ts want) (typed e want st0)))))
                (check-expr body want what (assoc ctx env (bind-all params ts (get ctx env) 0)) st1))
              (infer-expect e want what ctx st)))
          (else (infer-expect e want what ctx st))))
      ((Lambda _ _ _ _) (check-lambda e want what ctx st))
      ((MatchE subject clauses default _ _)
        (if (is-any (prune want (get st subst)))
          (get (infer e ctx st) st)
          (infer-expect e want what ctx st)))
      (else (infer-expect e want what ctx st)))))

;; `ctx` at `e`, if `e` has a position.
(sig at-node (Fn (Expr Ctx) Ctx))
(defn at-node (e ctx)
  (let ((pos (node-pos e)))
    (if (= (get pos line) 0) ctx (assoc ctx here pos))))

(sig node-pos (Fn (Expr) Pos))
(defn node-pos (e)
  (match e
    ((Lit form _) (form-pos form))
    ((Local _ _ pos _) pos)
    ((Global _ pos _) pos)
    ((Prim _ pos _) pos)
    ((Do _ pos _) pos)
    ((Call _ _ pos _) pos)
    ((If _ _ _ pos _) pos)
    ((Lambda _ _ pos _) pos)
    ((Tuple _ pos _) pos)
    ((ListOf _ pos _) pos)
    ((Fmt _ pos _) pos)
    ((Field _ _ pos _) pos)
    ((Assoc _ _ pos _) pos)
    ((MatchE _ _ _ pos _) pos)
    (else NOWHERE)))

;; Whether an if's `other` is the `nil` analysis writes for a missing else (`NIL`, at no
;; position; `cond`'s, from a macro, likewise), not one the program wrote.
(sig is-missing-else (Fn (Expr) Bool))
(defn is-missing-else (e)
  (match e
    ((Prim name pos _) (and (= name "nil") (= pos NOWHERE)))
    (else false)))

(sig infer-expect (Fn (Expr CType String Ctx St) St))
(defn infer-expect (e want what ctx st)
  (let ((r (infer e ctx st))) (expect want (get r t) what ctx (get r st))))

;; `e`'s type, recorded as its node's (typed Core).
(sig infer (Fn (Expr Ctx St) Res))
(defn infer (e ctx st)
  (let ((r (infer-node e ctx st)))
    (Res (get r t) (typed e (get r t) (get r st)))))

(sig infer-node (Fn (Expr Ctx St) Res))
(defn infer-node (e outer st)
  (let ((ctx (at-node e outer)))
    (match e
      ((Lit form _) (Res (literal-type form) st))
      ((Local name _ _ _)
        (let ((key (local-key e)))
          (Res (if (map-has (get ctx env) key) (map-get (get ctx env) key) ANY) st)))
      ((Global _ _ _) (as-value (name-type e ctx st)))
      ((Prim _ _ _) (as-value (name-type e ctx st)))
      ((Call callee args _ _) (infer-call callee args ctx st))
      ((If test then other _ _)
        (let ((rt (infer test ctx st))
              (st1 (expect-is (tcon "Bool") (get rt t) "if: the test" ctx (get rt st)))
              (ra (infer then ctx st1))
              (rb (infer other ctx (get ra st))))
          (if (is-missing-else other)
            (Res (tcon "Unit") (expect-is (tcon "Unit") (get ra t) "if: with no else, the then" ctx (get rb st)))
            (join-types (get ra t) (get rb t) "if: the branches" ctx (get rb st)))))
      ((Do body _ _) (infer-do body ctx (Res (tcon "Unit") st)))
      ((Lambda params body _ _) (infer-lambda params body ctx st))
      ((Tuple items _ _)
        (let (((ts st1) (infer-all items ctx st)))
          (Res (TCon "Tup" ts) st1)))
      ((ListOf items _ _) (infer-list-of items ctx st))
      ((Fmt parts _ _) (Res (tcon "String") (infer-holes parts ctx st)))
      ((Field obj field _ _) (infer-field obj field ctx st))
      ((Assoc obj fields _ _) (infer-assoc obj fields ctx st))
      ((MatchE subject clauses default _ _) (infer-match subject clauses default ctx st))
      (else (Res ANY st)))))

(sig literal-type (Fn (Form) CType))
(defn literal-type (form)
  (match form
    ((Txt _ _) (tcon "String"))
    ((IntLit _ _) (tcon "Int"))
    ((LongLit _ _) (tcon "Long"))
    ((ByteLit _ _) (tcon "Byte"))
    ((FloatLit _ _) (tcon "Float"))
    ((DoubleLit _ _) (tcon "Double"))
    ((CharLit _ _) (tcon "Char"))
    ((BoolLit _ _) (tcon "Bool"))
    (else ANY)))

;; A name's type, instantiated: a global's sig or constructor's, or a built-in's. A
;; variadic function's keeps its `(Rest t)`, which a call reads (infer-callee).
(sig name-type (Fn (Expr Ctx St) Res))
(defn name-type (e ctx st)
  (match e
    ((Global name _ _)
      (if (map-has (get ctx globals) name) (instantiate (map-get (get ctx globals) name) st) (Res ANY st)))
    ((Prim name _ _) (prim-type name ctx st))
    (else (Res ANY st))))

;; A variadic function as a value is the function of its arguments before the rest
;; (types.rest).
(sig as-value (Fn (Res) Res))
(defn as-value (r)
  (match (get r t)
    ((TFn params ret)
      (if (is-variadic (get r t)) (Res (TFn (slice params 0 (- (len params) 1)) ret) (get r st)) r))
    (else r)))

;; A callee's type: a name's with its rest parameter, if it has one; its node is typed as
;; the name's value.
(sig infer-callee (Fn (Expr Ctx St) Res))
(defn infer-callee (callee ctx st)
  (match callee
    ((Global _ _ _) (callee-typed callee (name-type callee ctx st)))
    ((Prim _ _ _) (callee-typed callee (name-type callee ctx st)))
    (else (infer callee ctx st))))

(sig callee-typed (Fn (Expr Res) Res))
(defn callee-typed (callee r)
  (Res (get r t) (typed callee (get (as-value r) t) (get r st))))

;; A built-in as a value: its type, instantiated (an operator's too: system.cdy).
(sig prim-type (Fn (String Ctx St) Res))
(defn prim-type (name ctx st)
  (if (map-has (get ctx builtins) name)
    (match (map-get (get ctx builtins) name)
      ((Typed type) (instantiate type st))
      (else (Res ANY st)))
    (Res ANY st)))

(sig infer-all (Fn ((List Expr) Ctx St) (Tup (List CType) St)))
(defn infer-all (es ctx st)
  (let (((st1 ts) (map-acc (fn (s e) (let ((r (infer e ctx s))) (Tup (get r st) (get r t)))) st es)))
    (Tup ts st1)))

;; (List item*): a (List t), each item a t (the first item's type, or a new variable).
(sig infer-list-of (Fn ((List Expr) Ctx St) Res))
(defn infer-list-of (items ctx st)
  (let ((rv (fresh st))
        (st1 (fold (fn (s e) (infer-expect e (get rv t) "List: an item" ctx s)) (get rv st) items)))
    (Res (TCon "List" (to-list (get rv t))) st1)))

(sig infer-do (Fn ((List Expr) Ctx Res) Res))
(defn infer-do (body ctx start)
  (fold (fn (last e) (infer e ctx (get last st))) start body))

(sig infer-holes (Fn ((List FPart) Ctx St) St))
(defn infer-holes (parts ctx start)
  (fold
    (fn (st p)
      (match p
        ((FHole e) (get (infer e ctx st) st))
        (else st)))
    start
    parts))

;; A fn as a value: fresh types for its parameters.
(sig infer-lambda (Fn ((List Expr) Expr Ctx St) Res))
(defn infer-lambda (params body ctx st)
  (let (((ptypes st1) (fresh-types (len params) st empty-list))
        (inner (assoc ctx env (bind-all params ptypes (get ctx env) 0)))
        (r (infer body inner (typed-all params ptypes st1))))
    (Res (TFn ptypes (get r t)) (get r st))))

(sig fresh-types (Fn (Int St (List CType)) (Tup (List CType) St)))
(defn fresh-types (count st acc)
  (if (= count 0)
    (Tup acc st)
    (fresh-types (- count 1) (assoc st n (+ (get st n) 1)) (++ acc (to-list (TVar (format "?{(get st n)}")))))))

(sig fresh (Fn (St) Res))
(defn fresh (st) (Res (TVar (format "?{(get st n)}")) (assoc st n (+ (get st n) 1))))

;; --- calls ---

(sig infer-call (Fn (Expr (List Expr) Ctx St) Res))
(defn infer-call (callee args ctx st)
  (match callee
    ((Lambda params body _ _)
      (if (= (len params) (len args))
        (typed-callee callee args (infer-applied params body args ctx st))
        (infer-called callee args ctx st)))
    ((Prim name _ _)
      (cond
        ((contains name (List "=" "!=")) (infer-compare name callee args ctx st))
        ((and (= name "at") (is-tup-item args)) (typed-callee callee args (infer-tup-item args ctx st)))
        (else (infer-called callee args ctx st))))
    (else (infer-called callee args ctx st))))

;; A let's binding, ((fn (x) body) init): x has init's type (no let-polymorphism).
(sig infer-applied (Fn ((List Expr) Expr (List Expr) Ctx St) Res))
(defn infer-applied (params body args ctx st)
  (let (((ts st1) (infer-all args ctx st))
        (inner (assoc ctx env (bind-all params ts (get ctx env) 0))))
    (infer body inner (typed-all params ts st1))))

;; A call of anything else: its type is a function, Any, or not known yet.
(sig infer-called (Fn (Expr (List Expr) Ctx St) Res))
(defn infer-called (callee args ctx st)
  (let ((rc (infer-callee callee ctx st))
        (ct (prune (get rc t) (get (get rc st) subst)))
        (name (callee-name callee)))
    (match ct
      ((TFn params ret)
        (cond
          ((is-variadic ct)
            (if (< (len args) (- (len params) 1))
              (let ((st1 (report (format "({name} ...) takes at least {(- (len params) 1)} argument(s), got {(len args)}") ctx (get rc st))))
                (Res ret (args-st args ctx st1)))
              (Res ret (check-args args (spread-rest params (len args)) name ctx (get rc st)))))
          ((!= (len params) (len args))
            (let ((unit (if (map-has (get ctx shapes) (global-of callee)) "field(s)" "argument(s)"))
                  (st1 (report (format "({name} ...) takes {(len params)} {unit}, got {(len args)}") ctx (get rc st))))
              (Res ret (args-st args ctx st1))))
          (else (Res ret (check-args args params name ctx (get rc st))))))
      ((TVar v)
        (if (is-flexible v)
          (let (((ts st1) (infer-all args ctx (get rc st)))
                (rr (fresh st1))
                ((_ok s) (unify ct (TFn ts (get rr t)) (get (get rr st) subst))))
            (Res (get rr t) (assoc (get rr st) subst s)))
          (Res ANY (report (format "expected a function, got {(show ct (get (get rc st) subst))}") ctx (get rc st)))))
      (else
        (if (is-any ct)
          (Res ANY (args-st args ctx (get rc st)))
          (Res ANY (report (format "expected a function, got {(show ct (get (get rc st) subst))}") ctx (get rc st))))))))

;; The state after inferring `args`, whose types aren't needed.
(sig args-st (Fn ((List Expr) Ctx St) St))
(defn args-st (args ctx st)
  (let (((_ts st1) (infer-all args ctx st))) st1))

;; A variadic function's parameter types for a call of `count` arguments: those before the
;; rest, then the rest's item type for each argument after them.
(sig spread-rest (Fn ((List CType) Int) (List CType)))
(defn spread-rest (params count)
  (let ((fixed (slice params 0 (- (len params) 1)))
        (item (at (rest-item (at params (- (len params) 1))) 0)))
    (++ fixed (map (fn (_) item) (range 0 (- count (len fixed)))))))

;; The arguments against the parameter types: the ones that aren't fns first, then the
;; fns, so their parameters' types are known when their bodies are read.
(sig check-args (Fn ((List Expr) (List CType) String Ctx St) St))
(defn check-args (args params name ctx st)
  (check-fn-args args params name ctx (check-plain-args args params name ctx st 0) 0))

(sig check-plain-args (Fn ((List Expr) (List CType) String Ctx St Int) St))
(defn check-plain-args (args params name ctx st i)
  (cond
    ((= i (len args)) st)
    ((is-lambda (at args i)) (check-plain-args args params name ctx st (+ i 1)))
    (else
      (check-plain-args args params name ctx (check-expr (at args i) (at params i) (arg-what i name) ctx st) (+ i 1)))))

(sig check-fn-args (Fn ((List Expr) (List CType) String Ctx St Int) St))
(defn check-fn-args (args params name ctx st i)
  (cond
    ((= i (len args)) st)
    ((is-lambda (at args i))
      (check-fn-args args params name ctx (check-lambda (at args i) (at params i) (arg-what i name) ctx st) (+ i 1)))
    (else (check-fn-args args params name ctx st (+ i 1)))))

(sig arg-what (Fn (Int String) String))
(defn arg-what (i name) (format "argument {(+ i 1)} of {name}"))

(sig is-lambda (Fn (Expr) Bool))
(defn is-lambda (e)
  (match e
    ((Lambda _ _ _ _) true)
    (else false)))

;; A fn checked against the type it is expected to have: a function type of its arity
;; gives its parameters their types.
(sig check-lambda (Fn (Expr CType String Ctx St) St))
(defn check-lambda (lam expected what ctx st)
  (match lam
    ((Lambda params body _ _)
      (match (prune expected (get st subst))
        ((TFn ptypes ret)
          (if (= (len ptypes) (len params))
            (check-expr body ret (format "{what}'s result") (assoc ctx env (bind-all params ptypes (get ctx env) 0)) (typed-all params ptypes (typed lam expected st)))
            (let ((r (infer lam ctx st))) (expect expected (get r t) what ctx (get r st)))))
        (else (let ((r (infer lam ctx st))) (expect expected (get r t) what ctx (get r st))))))
    (else st)))

;; The global name of `e`, or "".
(sig global-of (Fn (Expr) String))
(defn global-of (e)
  (match e
    ((Global name _ _) name)
    (else "")))

(sig callee-name (Fn (Expr) String))
(defn callee-name (e)
  (match e
    ((Global name _ _) (shown-name name))
    ((Prim name _ _) name)
    ((Local name _ _ _) name)
    (else "the function")))

;; A tup pattern's item, (at tmp i) on the pattern's _tup Local.
(sig is-tup-item (Fn ((List Expr)) Bool))
(defn is-tup-item (args)
  (and (= (len args) 2) (= (tup-name (at args 0)) "_tup") (>= (int-lit (at args 1)) 0)))

(sig tup-name (Fn (Expr) String))
(defn tup-name (e)
  (match e
    ((Local name _ _ _) name)
    (else "")))

;; The value of an Int literal, or -1.
(sig int-lit (Fn (Expr) Int))
(defn int-lit (e)
  (match e
    ((Lit form _)
      (match form
        ((IntLit k _) k)
        (else -1)))
    (else -1)))

(sig infer-tup-item (Fn ((List Expr) Ctx St) Res))
(defn infer-tup-item (args ctx st)
  (let ((r (infer (at args 0) ctx (typed (at args 1) (tcon "Int") st)))
        (i (int-lit (at args 1)))
        (tt (prune (get r t) (get (get r st) subst)))
        (items (tup-items tt)))
    (cond
      ((or (is-any tt) (is-var tt)) (Res ANY (get r st)))
      ((!= (tcon-name tt) "Tup")
        (Res ANY (if (= i 0) (report (format "a Tup pattern takes a tuple, not a {(show tt (get (get r st) subst))}") ctx (get r st)) (get r st))))
      ((< i (len items)) (Res (at items i) (get r st)))
      (else (Res ANY (report (format "a {(show tt (get (get r st) subst))} has {(len items)} items, not {(+ i 1)}") ctx (get r st)))))))

(sig tup-items (Fn (CType) (List CType)))
(defn tup-items (t)
  (match t
    ((TCon _ args) args)
    (else empty-list)))

;; --- equality (spec/40-expressions.md, expr.equality) ---

;; `=` and `!=`, typed `(Fn (a a (Rest a)) Bool)`, take any type but a function's: checked
;; as a call, then the type of their arguments looked into.
(sig infer-compare (Fn (String Expr (List Expr) Ctx St) Res))
(defn infer-compare (name callee args ctx st)
  (let ((r (infer-called callee args ctx st))
        (subst (get (get r st) subst))
        (t1 (if (= (len args) 0) ANY (resolve-type (recorded (at args 0) (get r st)) subst))))
    (if (has-fn t1 subst ctx empty-list)
      (Res (get r t) (report (format "{name}: a function can't be compared, got {(show t1 subst)}") ctx (get r st)))
      r)))

;; Whether `t` is, or holds, a function type: a list of them, say, or a record or variant
;; with one among its fields, or a sum with such a variant. `seen` holds the records and
;; sums already looked into, so that a recursive type ends.
(sig has-fn (Fn (CType (Map String CType) Ctx (List String)) Bool))
(defn has-fn (t subst ctx seen)
  (match (prune t subst)
    ((TFn _ _) true)
    ((TCon name args)
      (or (any (fn (a) (has-fn a subst ctx seen)) args)
          (and (not (contains name seen)) (fields-have-fn name subst ctx (++ seen (List name))))))
    (else false)))

;; Whether the record or variant `name` has a field holding a function, or the sum `name`
;; a variant that does.
(sig fields-have-fn (Fn (String (Map String CType) Ctx (List String)) Bool))
(defn fields-have-fn (name subst ctx seen)
  (cond
    ((map-has (get ctx shapes) name)
      (any (fn (f) (let (((_name t) f)) (has-fn t subst ctx seen))) (get (map-get (get ctx shapes) name) fields)))
    ((map-has (get ctx sums) name)
      (any (fn (v) (let (((variant _t) v)) (has-fn (TCon variant empty-list) subst ctx seen))) (get (map-get (get ctx sums) name) fields)))
    (else false)))

(sig join-all (Fn ((List CType) String Ctx Res) Res))
(defn join-all (types what ctx start)
  (fold (fn (r ty) (join-types (get r t) ty what ctx (get r st))) start (rest types)))

;; --- records, get and assoc ---

;; The shape of the record or variant `name`, and the types its type variables take in
;; `t`'s arguments: the field types, with them put in.
(sig field-of (Fn (CType String Ctx) (Tup Bool CType)))
(defn field-of (t field ctx)
  (match t
    ((TCon name args)
      (cond
        ((map-has (get ctx shapes) name)
          (let ((s (map-get (get ctx shapes) name)))
            (find-field (get s fields) field (zip-map (get s tvars) args empty-map))))
        ((map-has (get ctx sums) name) (sum-field (map-get (get ctx sums) name) args field ctx))
        (else (Tup false ANY))))
    (else (Tup false ANY))))

;; A field of a sum: every variant has it, with one type.
(sig sum-field (Fn (Shape (List CType) String Ctx) (Tup Bool CType)))
(defn sum-field (sum args field ctx)
  (let ((found (map (fn (v) (let (((variant _t) v)) (field-of (TCon variant args) field ctx))) (get sum fields))))
    (if (= (len found) 0)
      (Tup false ANY)
      (let (((_ok first) (at found 0)))
        (if (all (fn (f) (let (((ok t) f)) (and ok (= t first)))) found)
          (at found 0)
          (Tup false ANY))))))

;; Whether every variant of the sum `name` has `field`, of whatever type.
(sig in-every-variant (Fn (String String Ctx) Bool))
(defn in-every-variant (name field ctx)
  (and (map-has (get ctx sums) name)
       (all (fn (v) (let (((variant _t) v) ((ok _ft) (field-of (TCon variant empty-list) field ctx))) ok)) (get (map-get (get ctx sums) name) fields))))

(sig find-field (Fn ((List (Tup String CType)) String (Map String CType)) (Tup Bool CType)))
(defn find-field (fields field vars)
  (if (= (len fields) 0)
    (Tup false ANY)
    (let (((name t) (at fields 0)))
      (if (= name field) (Tup true (put-vars t vars)) (find-field (rest fields) field vars)))))

(sig zip-map (Fn ((List String) (List CType) (Map String CType)) (Map String CType)))
(defn zip-map (names types acc)
  (if (or (= (len names) 0) (= (len types) 0))
    acc
    (zip-map (rest names) (rest types) (map-set acc (at names 0) (at types 0)))))

;; `t` with each type variable in `vars` replaced.
(sig put-vars (Fn (CType (Map String CType)) CType))
(defn put-vars (t vars)
  (match t
    ((TVar name) (if (map-has vars name) (map-get vars name) t))
    ((TCon name args) (TCon name (map (fn (a) (put-vars a vars)) args)))
    ((TFn params ret) (TFn (map (fn (p) (put-vars p vars)) params) (put-vars ret vars)))))

(sig infer-field (Fn (Expr String Ctx St) Res))
(defn infer-field (obj field ctx st)
  (let ((r (infer obj ctx st))
        (ot (prune (get r t) (get (get r st) subst))))
    (field-type ot obj field "get" ctx (get r st))))

;; The type of `field` of `obj`, a value of type `ot` (narrowed), or a report; a fresh
;; variable and a field constraint if `ot` is a variable.
(sig field-type (Fn (CType Expr String String Ctx St) Res))
(defn field-type (ot0 obj field what ctx st)
  (let ((ot (narrow ot0 obj ctx)))
  (match ot
    ((TVar v)
      (if (is-flexible v)
        (let ((r (fresh st))
              (p (Pending obj field what ot (get r t) (get ctx here))))
          (Res (get r t) (assoc (get r st) pending (++ (get (get r st) pending) (to-list p)))))
        (Res ANY (report (format "{what}: {v} has no fields") ctx st))))
    (else
      (let (((found ft) (field-of ot field ctx)))
        (cond
          ((is-any ot) (Res ANY st))
          (found (Res ft st))
          (else
            (Res ANY
              (report
                (cond
                  ((in-every-variant (tcon-name ot) field ctx)
                    (format "{what}: field {field} of {(show ot (get st subst))} has different types in its variants"))
                  ((or (map-has (get ctx shapes) (tcon-name ot)) (map-has (get ctx sums) (tcon-name ot)))
                    (format "{what}: {(show ot (get st subst))} has no field {field}"))
                  (else (format "{what}: {(show ot (get st subst))} has no fields")))
                ctx st)))))))))

;; `ot`, the type of `obj`, narrowed: inside a match clause on the local `obj`, the
;; clause's variant (with the sum's type arguments), if `ot` is its sum; else `ot`.
(sig narrow (Fn (CType Expr Ctx) CType))
(defn narrow (ot obj ctx)
  (let ((key (match obj ((Local _ _ _ _) (local-key obj)) (else ""))))
    (if (map-has (get ctx narrowed) key)
      (let ((variant (map-get (get ctx narrowed) key)))
        (match ot
          ((TCon name args)
            (if (= name (get (map-get (get ctx shapes) variant) sum)) (TCon variant args) ot))
          (else ot)))
      ot)))

;; The state with the definition's field constraints solved: each whose value's type is
;; known now is checked as its get or assoc would have been; while any is, the rest again;
;; then each left (or met only Any, which gives Any) is the error it would have been.
(sig solve-pending (Fn (Ctx St) St))
(defn solve-pending (ctx st)
  (let ((ps (get st pending))
        ((st1 left) (solve-each ps ctx (assoc st pending empty-list) empty-list)))
    (cond
      ((= (len left) 0) st1)
      ((< (len left) (len ps)) (solve-pending ctx (assoc st1 pending (++ (get st1 pending) left))))
      (else (report-pending left ctx st1)))))

;; The state with each of `ps` solved, and those still on a variable after `left`.
(sig solve-each (Fn ((List Pending) Ctx St (List Pending)) (Tup St (List Pending))))
(defn solve-each (ps ctx start left)
  (fold
    (fn (acc p)
      (let (((st left) acc)
            (on (prune (get p on) (get st subst))))
        (cond
          ((map-has (get st subst) (++ "any" (tvar-name on)))
            (Tup (assoc st subst (mark-any (get p t) (get st subst))) left))
          ((is-var on) (Tup st (++ left (to-list p))))
          (else
            (let ((c (assoc ctx here (get p here)))
                  (r (field-type on (get p obj) (get p field) (get p what) c st))
                  (what (format "{(get p what)}: field {(get p field)} of {(show on (get (get r st) subst))}")))
              (Tup (expect-is (get p t) (get r t) what c (get r st)) left))))))
    (Tup start left)
    ps))

(sig report-pending (Fn ((List Pending) Ctx St) St))
(defn report-pending (ps ctx start)
  (fold
    (fn (st p)
      (report (format "{(get p what)}: the type of {(callee-name (get p obj))} isn't known here ({(get p field)})")
        (assoc ctx here (get p here)) st))
    start
    ps))

(sig tcon-name (Fn (CType) String))
(defn tcon-name (t)
  (match t
    ((TCon name _) name)
    (else "")))

(sig infer-assoc (Fn (Expr (List (Tup String Expr)) Ctx St) Res))
(defn infer-assoc (obj fields ctx st)
  (let ((r (infer obj ctx st))
        (ot (prune (get r t) (get (get r st) subst))))
    (Res (get r t) (assoc-values ot obj fields ctx (get r st)))))

(sig assoc-values (Fn (CType Expr (List (Tup String Expr)) Ctx St) St))
(defn assoc-values (ot obj fields ctx start)
  (fold
    (fn (st f)
      (let (((field val) f)
            (ft (field-type ot obj field "assoc" ctx st)))
        (check-expr val (get ft t) (format "assoc: field {field} of {(show ot (get st subst))}") ctx (get ft st))))
    start
    fields))

;; --- match ---

(sig infer-match (Fn (Expr (List Clause) (List Expr) Ctx St) Res))
(defn infer-match (subject clauses default ctx st)
  (let ((rs (infer subject ctx st))
        (variant (get (at clauses 0) variant))
        (sum (if (map-has (get ctx shapes) variant) (get (map-get (get ctx shapes) variant) sum) ""))
        (tvars (if (map-has (get ctx sums) sum) (get (map-get (get ctx sums) sum) tvars) empty-list))
        ((ftypes st0) (fresh-types (len tvars) (get rs st) empty-list))
        (vars (zip-map tvars ftypes empty-map))
        (want (TCon sum ftypes))
        (st1 (expect-is want (get rs t) "match: the subject" ctx st0))
        ((ctypes st2) (infer-clauses subject clauses vars ctx st1)))
    (if (= (len default) 0)
      (join-all ctypes "match: the clauses" ctx (Res (at ctypes 0) st2))
      (let ((rd (infer (at default 0) ctx st2)))
        (join-all (++ ctypes (to-list (get rd t))) "match: the clauses" ctx (Res (at ctypes 0) (get rd st)))))))

;; Each clause's type: its names bound to their fields' types, and a local subject
;; narrowed to the clause's variant (checking.narrowing).
(sig infer-clauses (Fn (Expr (List Clause) (Map String CType) Ctx St) (Tup (List CType) St)))
(defn infer-clauses (subject clauses vars ctx st)
  (let (((st1 ts)
          (map-acc
            (fn (s c)
              (let ((shape (if (map-has (get ctx shapes) (get c variant)) (map-get (get ctx shapes) (get c variant)) (Shape empty-list empty-list "")))
                    (bound (assoc ctx env (bind-fields (get c binds) (get shape fields) vars (get ctx env))))
                    (inner (match subject
                             ((Local _ _ _ _) (assoc bound narrowed (map-set (get ctx narrowed) (local-key subject) (get c variant))))
                             (else bound)))
                    (r (infer (get c body) inner (typed-binds (get c binds) (get inner env) s))))
                (Tup (get r st) (get r t))))
            st
            clauses)))
    (Tup ts st1)))

;; `env` with each (field, Local) of a pattern bound to the field's type.
(sig bind-fields (Fn ((List (Tup String Expr)) (List (Tup String CType)) (Map String CType) (Map String CType)) (Map String CType)))
(defn bind-fields (binds fields vars start)
  (fold
    (fn (env b)
      (let (((field loc) b)
            ((found ft) (find-field fields field vars)))
        (map-set env (local-key loc) (if found ft ANY))))
    start
    binds))

;; --- typed Core ---

;; While a definition is checked, each of its nodes has a name for its type, ?eK (K
;; counting its nodes; retype-top names them), under which the checker records the type
;; it finds (typed). Then each node gets that type, with the definition's substitution
;; put in (node-type). A node the checker never reached keeps its name ([[B127]]'s test
;; finds none in the translator); a ?N nothing solved stays a TVar, for each backend to
;; read as it likes (Python: Any).

;; The state with `t` recorded as `e`'s type.
(sig typed (Fn (Expr CType St) St))
(defn typed (e t st)
  (let ((key (tvar-name (get e t))))
    (if (starts-with key "?e") (assoc st types (map-set (get st types) key t)) st)))

;; Each of `es` recorded with the type at its index in `ts`.
(sig typed-all (Fn ((List Expr) (List CType) St) St))
(defn typed-all (es ts st)
  (if (or (= (len es) 0) (= (len ts) 0)) st (typed-all (rest es) (rest ts) (typed (at es 0) (at ts 0) st))))

;; A pattern's (field, Local) pairs, each Local recorded with its type in `env`.
(sig typed-binds (Fn ((List (Tup String Expr)) (Map String CType) St) St))
(defn typed-binds (binds env start)
  (fold
    (fn (st b)
      (let (((_field loc) b))
        (typed loc (if (map-has env (local-key loc)) (map-get env (local-key loc)) ANY) st)))
    start
    binds))

;; `r`, a call's result, with its callee recorded as the function from the arguments'
;; recorded types to the result's.
(sig typed-callee (Fn (Expr (List Expr) Res) Res))
(defn typed-callee (callee args r)
  (Res (get r t) (typed callee (TFn (map (fn (a) (recorded a (get r st))) args) (get r t)) (get r st))))

;; The type recorded for `e`, or Any.
(sig recorded (Fn (Expr St) CType))
(defn recorded (e st)
  (let ((key (tvar-name (get e t))))
    (if (map-has (get st types) key) (map-get (get st types) key) ANY)))

;; A node's type once its definition is checked: the type recorded under its name `t`,
;; with the substitution put in.
(sig node-type (Fn (CType St) CType))
(defn node-type (t st)
  (let ((key (tvar-name t)))
    (if (map-has (get st types) key) (final-type (map-get (get st types) key) (get st subst)) t)))

;; `t` resolved, a variable still unsolved that met `Any` (`mark-any`) as `Any`.
(sig final-type (Fn (CType (Map String CType)) CType))
(defn final-type (t subst)
  (match (prune t subst)
    ((TCon name args) (TCon name (map (fn (a) (final-type a subst)) args)))
    ((TFn params ret) (TFn (map (fn (p) (final-type p subst)) params) (final-type ret subst)))
    ((TVar name) (if (map-has subst (++ "any" name)) ANY (TVar name)))))

;; `top` with each node's type `(f t k)`, its old type and its number.
(sig retype-top (Fn (Top (Fn (CType Int) CType)) Top))
(defn retype-top (top f)
  (match top
    ((TDef name init t pos) (let (((e _n) (retype init f 0))) (TDef name e t pos)))
    ((TDefn name params body t pos)
      (let (((ps n1) (retype-all params f 0))
            ((b _) (retype body f n1)))
        (TDefn name ps b t pos)))
    ((TExpr e) (let (((e1 _n) (retype e f 0))) (TExpr e1)))
    (else top)))

;; `e` retyped (see retype-top), its nodes numbered from `n`; and the next number.
(sig retype (Fn (Expr (Fn (CType Int) CType) Int) (Tup Expr Int)))
(defn retype (e f n)
  (let ((k (+ n 1)))
    (match e
      ((Lit form t) (Tup (Lit form (f t n)) k))
      ((Local name id pos t) (Tup (Local name id pos (f t n)) k))
      ((Global name pos t) (Tup (Global name pos (f t n)) k))
      ((Prim name pos t) (Tup (Prim name pos (f t n)) k))
      ((Temp id t) (Tup (Temp id (f t n)) k))
      ((Call callee args pos t)
        (let (((c n1) (retype callee f k))
              ((xs n2) (retype-all args f n1)))
          (Tup (Call c xs pos (f t n)) n2)))
      ((If test then other pos t)
        (let (((a n1) (retype test f k))
              ((b n2) (retype then f n1))
              ((c n3) (retype other f n2)))
          (Tup (If a b c pos (f t n)) n3)))
      ((Do body pos t)
        (let (((xs n1) (retype-all body f k)))
          (Tup (Do xs pos (f t n)) n1)))
      ((Lambda params body pos t)
        (let (((ps n1) (retype-all params f k))
              ((b n2) (retype body f n1)))
          (Tup (Lambda ps b pos (f t n)) n2)))
      ((Tuple items pos t)
        (let (((xs n1) (retype-all items f k)))
          (Tup (Tuple xs pos (f t n)) n1)))
      ((ListOf items pos t)
        (let (((xs n1) (retype-all items f k)))
          (Tup (ListOf xs pos (f t n)) n1)))
      ((Fmt parts pos t)
        (let (((ps n1) (retype-parts parts f k)))
          (Tup (Fmt ps pos (f t n)) n1)))
      ((Field obj field pos t)
        (let (((o n1) (retype obj f k)))
          (Tup (Field o field pos (f t n)) n1)))
      ((Assoc obj fields pos t)
        (let (((o n1) (retype obj f k))
              ((fs n2) (retype-pairs fields f n1)))
          (Tup (Assoc o fs pos (f t n)) n2)))
      ((MatchE subject clauses default pos t)
        (let (((s n1) (retype subject f k))
              ((cs n2) (retype-clauses clauses f n1))
              ((d n3) (retype-all default f n2)))
          (Tup (MatchE s cs d pos (f t n)) n3))))))

(sig retype-all (Fn ((List Expr) (Fn (CType Int) CType) Int) (Tup (List Expr) Int)))
(defn retype-all (es f n)
  (let (((n1 out) (map-acc (fn (k e) (let (((e1 k1) (retype e f k))) (Tup k1 e1))) n es)))
    (Tup out n1)))

(sig retype-pairs (Fn ((List (Tup String Expr)) (Fn (CType Int) CType) Int) (Tup (List (Tup String Expr)) Int)))
(defn retype-pairs (pairs f n)
  (let (((n1 out)
          (map-acc (fn (k pair) (let (((name e) pair) ((e1 k1) (retype e f k))) (Tup k1 (Tup name e1)))) n pairs)))
    (Tup out n1)))

(sig retype-parts (Fn ((List FPart) (Fn (CType Int) CType) Int) (Tup (List FPart) Int)))
(defn retype-parts (parts f n)
  (let (((n1 out)
          (map-acc
            (fn (k part)
              (match part
                ((FHole e) (let (((e1 k1) (retype e f k))) (Tup k1 (FHole e1))))
                (else (Tup k part))))
            n
            parts)))
    (Tup out n1)))

(sig retype-clauses (Fn ((List Clause) (Fn (CType Int) CType) Int) (Tup (List Clause) Int)))
(defn retype-clauses (clauses f n)
  (let (((n1 out)
          (map-acc
            (fn (k c)
              (let (((bs k1) (retype-pairs (get c binds) f k))
                    ((b k2) (retype (get c body) f k1)))
                (Tup k2 (Clause (get c variant) bs b))))
            n
            clauses)))
    (Tup out n1)))

;; --- types: unification ---

;; Whether a type variable is one the checker made (?N, or ?N:number for a constraint
;; variable's), which unification may solve; a sig's (a) is rigid.
(sig is-flexible (Fn (String) Bool))
(defn is-flexible (name) (starts-with name "?"))

;; `t` with its solved variables followed, at the top.
(sig prune (Fn (CType (Map String CType)) CType))
(defn prune (t subst)
  (match t
    ((TVar name) (if (map-has subst name) (prune (map-get subst name) subst) t))
    (else t)))

;; `t` with every solved variable put in.
(sig resolve-type (Fn (CType (Map String CType)) CType))
(defn resolve-type (t subst)
  (match (prune t subst)
    ((TCon name args) (TCon name (map (fn (a) (resolve-type a subst)) args)))
    ((TFn params ret) (TFn (map (fn (p) (resolve-type p subst)) params) (resolve-type ret subst)))
    (else (prune t subst))))

(sig occurs (Fn (String CType (Map String CType)) Bool))
(defn occurs (v t subst)
  (match (prune t subst)
    ((TVar name) (= name v))
    ((TCon _ args) (any (fn (a) (occurs v a subst)) args))
    ((TFn params ret) (or (any (fn (p) (occurs v p subst)) params) (occurs v ret subst)))))

;; Whether `a` and `b` can be one type, and the substitution that makes them so.
(sig unify (Fn (CType CType (Map String CType)) (Tup Bool (Map String CType))))
(defn unify (a b subst)
  (let ((pa (prune a subst))
        (pb (prune b subst)))
    (cond
      ((is-any pa) (Tup true (mark-any pb subst)))
      ((is-any pb) (Tup true (mark-any pa subst)))
      ((is-var pa) (bind-var (tvar-name pa) pb subst))
      ((is-var pb) (bind-var (tvar-name pb) pa subst))
      (else
        (match pa
          ((TVar name) (Tup (match pb ((TVar other) (= name other)) (else false)) subst))
          ((TCon name args)
            (match pb
              ((TCon other bargs)
                (if (and (= name other) (= (len args) (len bargs))) (unify-all args bargs subst) (Tup false subst)))
              (else (Tup false subst))))
          ((TFn params ret)
            (match pb
              ((TFn bparams bret)
                (if (= (len params) (len bparams))
                  (let (((ok s) (unify-all params bparams subst)))
                    (if ok (unify ret bret s) (Tup false s)))
                  (Tup false subst)))
              (else (Tup false subst)))))))))

;; `Any` binds nothing it meets, but each variable it meets is marked, in the substitution
;; under its name with `any` before it (no variable's name starts so): one still unsolved
;; at the end is `Any` (`final-type`), as gradual inference defaults it; one that met
;; nothing stays a variable.
(sig mark-any (Fn (CType (Map String CType)) (Map String CType)))
(defn mark-any (t subst)
  (match (prune t subst)
    ((TVar name) (if (is-flexible name) (map-set subst (++ "any" name) ANY) subst))
    ((TCon _ args) (fold (fn (s a) (mark-any a s)) subst args))
    ((TFn params ret) (mark-any ret (fold (fn (s p) (mark-any p s)) subst params)))))

(sig unify-all (Fn ((List CType) (List CType) (Map String CType)) (Tup Bool (Map String CType))))
(defn unify-all (xs ys subst)
  (if (= (len xs) 0)
    (Tup true subst)
    (let (((ok s) (unify (at xs 0) (at ys 0) subst)))
      (if ok (unify-all (rest xs) (rest ys) s) (Tup false s)))))

(sig bind-var (Fn (String CType (Map String CType)) (Tup Bool (Map String CType))))
(defn bind-var (v t subst)
  (cond
    ((match t ((TVar other) (= other v)) (else false)) (Tup true subst))
    ((occurs v t subst) (Tup false subst))
    ((= (constraint-of v) "") (Tup true (map-set subst v t)))
    (else (bind-constrained v (constraint-of v) t subst))))

;; A variable of the constraint `c` (`?N:number`, checking.constraints) bound to `t`: a
;; type `c` lists; a variable, unconstrained or of a
;; constraint within `c` (bound to the narrower), or one that shares a single type with
;; `c` (both bound to it); a sig's variable only if its own constraint is within `c`.
(sig bind-constrained (Fn (String String CType (Map String CType)) (Tup Bool (Map String CType))))
(defn bind-constrained (v c t subst)
  (let ((takes (map-get CONSTRAINTS c)))
    (match t
      ((TCon name _)
        (cond
          ((contains name takes) (Tup true (map-set subst v t)))
          (else (Tup false subst))))
      ((TVar other)
        (let ((oc (constraint-of other)))
          (cond
            ((not (is-flexible other))
              (if (and (!= oc "") (within oc c)) (Tup true (map-set subst v t)) (Tup false subst)))
            ((= oc "") (Tup true (map-set subst other (TVar v))))
            ((within c oc) (Tup true (map-set subst other (TVar v))))
            ((within oc c) (Tup true (map-set subst v t)))
            (else
              (let ((both (filter (fn (x) (contains x (map-get CONSTRAINTS oc))) takes)))
                (if (and (= (len both) 1) (!= (at both 0) "List"))
                  (Tup true (map-set (map-set subst v (tcon (at both 0))) other (tcon (at both 0))))
                  (Tup false subst)))))))
      (else (Tup false subst)))))

;; Whether every type the constraint `a` takes, `b` takes too.
(sig within (Fn (String String) Bool))
(defn within (a b)
  (all (fn (x) (contains x (map-get CONSTRAINTS b))) (map-get CONSTRAINTS a)))

(sig is-any (Fn (CType) Bool))
(defn is-any (t)
  (match t
    ((TCon name _) (= name "Any"))
    (else false)))

;; Whether `t` is a variable the checker may solve.
(sig is-var (Fn (CType) Bool))
(defn is-var (t)
  (match t
    ((TVar name) (is-flexible name))
    (else false)))

(sig tvar-name (Fn (CType) String))
(defn tvar-name (t)
  (match t
    ((TVar name) name)
    (else "")))

;; Whether a value of type `actual` is accepted where `want` is expected: they unify. A
;; `(Tup t ...)` isn't a `(List t)` (since collections step 5), nor a `t` a `(Maybe t)`,
;; the prelude's sum.
(sig accepts (Fn (CType CType (Map String CType)) (Tup Bool (Map String CType))))
(defn accepts (want actual subst) (unify want actual subst))

;; The state with a report unless `actual` is accepted as `want`.
(sig expect (Fn (CType CType String Ctx St) St))
(defn expect (want actual what ctx st)
  (let (((ok s) (accepts want actual (get st subst))))
    (if ok
      (assoc st subst s)
      (let ((lead (if (= what "") "" (++ what ": "))))
        (report (format "{lead}expected {(show want (get st subst))}, got {(show actual (get st subst))}") ctx st)))))

;; Like expect, for what has one right type: "if: the test is Int, not Bool".
(sig expect-is (Fn (CType CType String Ctx St) St))
(defn expect-is (want actual what ctx st)
  (let (((ok s) (accepts want actual (get st subst))))
    (if ok
      (assoc st subst s)
      (report (format "{what} is {(show actual (get st subst))}, not {(show want (get st subst))}") ctx st))))

;; Two types that must be one (an if's branches, the operators' arguments).
(sig join-types (Fn (CType CType String Ctx St) Res))
(defn join-types (a b what ctx st)
  (let ((pa (prune a (get st subst)))
        (pb (prune b (get st subst))))
    (let (((ok s) (unify pa pb (get st subst))))
      (if ok
        (Res pa (assoc st subst s))
        (Res ANY (report (mismatch what (show pa (get st subst)) (show pb (get st subst)) ctx) ctx st))))))

;; Two types that aren't one: "if: the branches are Int and String".
(sig mismatch (Fn (String String String Ctx) String))
(defn mismatch (what a b ctx) (format "{what} are {a} and {b}"))

;; `t` with its rigid (sig) type variables replaced by fresh ones.
(sig instantiate (Fn (CType St) Res))
(defn instantiate (t st)
  (let ((names (rigid-vars t empty-list)))
    (if (= (len names) 0)
      (Res t st)
      (let (((ftypes st1) (fresh-types (len names) st empty-list))
            (vars (map (fn (i) (keep-constraint (at names i) (at ftypes i))) (range 0 (len names)))))
        (Res (put-vars t (zip-map names vars empty-map)) st1)))))

;; A fresh variable `?N` for the sig's variable `name`: `?N:number` if `name` is a
;; constraint variable (checking.constraints).
(sig keep-constraint (Fn (String CType) CType))
(defn keep-constraint (name fresh-var)
  (let ((c (constraint-of name)))
    (if (= c "") fresh-var (TVar (format "{(tvar-name fresh-var)}:{c}")))))

(sig rigid-vars (Fn (CType (List String)) (List String)))
(defn rigid-vars (t acc)
  (match t
    ((TVar name) (if (or (is-flexible name) (contains name acc)) acc (++ acc (to-list name))))
    ((TCon _ args) (fold (fn (a x) (rigid-vars x a)) acc args))
    ((TFn params ret) (rigid-vars ret (fold (fn (a x) (rigid-vars x a)) acc params)))))

;; --- def order (spec/10-programs.md, programs.def-order) ---

;; What each top-level name is ("def", "defn" or "deft", a record's or variant's
;; constructor), and each function's body.
(deft Order ((kinds (Map String String)) (bodies (Map String Expr))))

(sig order-of (Fn ((List Top)) Order))
(defn order-of (tops)
  (fold (fn (o top)
          (match top
            ((TDef name _ _ _) (assoc o kinds (map-set (get o kinds) name "def")))
            ((TDefn name _ body _ _)
              (Order (map-set (get o kinds) name "defn") (map-set (get o bodies) name body)))
            (else (fold (fn (o2 n) (assoc o2 kinds (map-set (get o2 kinds) n "deft"))) o (defined-by top)))))
        (Order empty-map empty-map) tops))

;; The names a top defines: a def's or defn's, a record's, a sum's variants.
(sig defined-by (Fn (Top) (List String)))
(defn defined-by (top)
  (match top
    ((TDeft name _ _) (List name))
    ((TDeftSum _ _ variants) (map (fn (v) (get v name)) variants))
    ((TDef name _ _ _) (List name))
    ((TDefn name _ _ _ _) (List name))
    ((TExpr _) empty-list)))

;; The order errors in `tops`, run in order: a def's initial value, or a top-level
;; expression, runs when the program starts, so each top-level name it uses must be
;; defined before it (`start` holds those defined before `tops`), and each name the
;; bodies of the functions it uses do, through them. A function's body itself runs only
;; when called.
(sig check-order (Fn ((List Top) Order (Map String Bool)) (List String)))
(defn check-order (tops order start)
  (let (((_defined errors)
          (map-acc
            (fn (defined top)
              (Tup
                (fold (fn (d n) (map-set d n true)) defined (defined-by top))
                (match top
                  ((TDef _ init _ _) (order-errors init order defined))
                  ((TExpr e) (order-errors e order defined))
                  (else empty-list))))
            start
            tops)))
    (concat errors)))

;; The order errors of `e`, run now: for each top-level name it uses, the name itself and,
;; if it is a function, every name its body reaches.
(sig order-errors (Fn (Expr Order (Map String Bool)) (List String)))
(defn order-errors (e order defined)
  (concat
    (map (fn (u)
           (let (((name pos) u)
                 (reached (reach (List name) order (map-from (List (Tup name true))))))
             (map (fn (n) (++ (pos-text pos) (used-early n name order)))
                  (filter (fn (n) (and (map-has (get order kinds) n) (not (map-has defined n)))) (map-keys reached)))))
         (uses e empty-list))))

;; The message for `n`, used before its definition, through `name` (unless it is `n`).
(sig used-early (Fn (String String Order) String))
(defn used-early (n name order)
  (let ((through (if (= n name) "" (++ ", through " (shown-name name)))))
    (format "{(shown-name n)} is used before its {(map-get (get order kinds) n)}{through}")))

;; The top-level names reached from `todo`, through the bodies of the functions among them;
;; `seen` holds those found so far.
(sig reach (Fn ((List String) Order (Map String Bool)) (Map String Bool)))
(defn reach (todo order seen)
  (if (= (len todo) 0)
    seen
    (let ((name (at todo 0))
          (found (if (map-has (get order bodies) name)
                   (filter (fn (n) (not (map-has seen n))) (map (fn (u) (let (((n _pos) u)) n)) (uses (map-get (get order bodies) name) empty-list)))
                   empty-list)))
      (reach (++ (rest todo) found) order (fold (fn (m n) (map-set m n true)) seen found)))))

;; The globals `e` uses, with where, added to `acc`: in a `fn` too, counted as called.
(sig uses (Fn (Expr (List (Tup String Pos))) (List (Tup String Pos))))
(defn uses (e acc)
  (match e
    ((Global name pos _) (++ acc (List (Tup name pos))))
    ((Call callee args _ _) (uses-all args (uses callee acc)))
    ((If test then other _ _) (uses other (uses then (uses test acc))))
    ((Do body _ _) (uses-all body acc))
    ((Lambda _ body _ _) (uses body acc))
    ((Tuple items _ _) (uses-all items acc))
    ((ListOf items _ _) (uses-all items acc))
    ((Fmt parts _ _) (fold (fn (a p) (match p ((FHole x) (uses x a)) (else a))) acc parts))
    ((Field obj _ _ _) (uses obj acc))
    ((Assoc obj fields _ _) (uses-all (map (fn (f) (let (((_name v) f)) v)) fields) (uses obj acc)))
    ((MatchE subject clauses default _ _)
      (uses-all default (uses-all (map (fn (c) (get c body)) clauses) (uses subject acc))))
    (else acc)))

(sig uses-all (Fn ((List Expr) (List (Tup String Pos))) (List (Tup String Pos))))
(defn uses-all (es acc)
  (fold (fn (a x) (uses x a)) acc es))

;; --- messages ---

(sig report (Fn (String Ctx St) St))
(defn report (msg ctx st)
  (assoc st errors (++ (get st errors) (to-list (++ (pos-text (get ctx here)) msg)))))

;; A type as a program writes it: (List Int), (Fn (a) a); a module's type without its
;; prefix; a variable the checker made as t1, t2.
(sig show (Fn (CType (Map String CType)) String))
(defn show (t subst)
  (match (resolve-type t subst)
    ((TCon name args)
      (if (= (len args) 0)
        (shown-name name)
        (format "({(shown-name name)} {(join (map (fn (a) (show a subst)) args) \" \")})")))
    ((TFn params ret) (format "(Fn ({(join (map (fn (p) (show p subst)) params) \" \")}) {(show ret subst)})"))
    ((TVar name)
      (cond
        ((not (is-flexible name)) name)
        ((!= (constraint-of name) "") (constraint-of name))
        (else (++ "t" (substring name 1 (str-len name))))))))

;; A global name as the program wrote it: util__greet is greet.
(sig shown-name (Fn (String) String))
(defn shown-name (name)
  (let ((parts (split name "__")))
    (if (= (len parts) 1) name (join (rest parts) "__"))))
