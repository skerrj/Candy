;;; Include: reading a program's files. A program is modules (doc/hl_rqmt/modules.md):
;;; `(import name)` at top level imports `name.cdy`, found in the importing file's
;;; directory, or else in the library's, next to the translator (`(import name (a b))` too, its names listed; its shape is special.cdy's), and read-modules returns each module after those it imports. A cycle is an
;;; error. Every file but the prelude itself also imports the prelude (prelude.cdy, next to
;;; the translator). `(import-macros name)` stays, with `name.cdy`'s path in place of the name, for
;;; expand.cdy to load. A macro file is read as modules too (cdyc.cdy, load-macro-file;
;;; doc/hl_rqmt/host_macros.md, step 4).

(import form)
(import read)
(import syntax)
(import translator)
(import string ())
(import map ())

;; --- modules ---

;; A module: its file (as the user would write the path; "" for text that isn't from a
;; file), its key (the absolute path), its stem, its forms without its imports, and what it
;; imports.
(deft Module ((path String) (key String) (stem String) (forms (List Form)) (imports (List Imp))))

;; An import: the imported module's key, where the import is, and the names it lists, if
;; it lists any (`(import m (a b))`), to make only those unqualified.
(deft Imp ((key String) (pos Pos) (only (Maybe (List Form)))))

;; The modules read so far, each after those it imports, and the keys read or being read.
(deft Mods ((done (List Module)) (seen (Map String Bool))))

;; The modules of the program whose top file is at `path`; the top module is last.
(sig read-modules (Fn (String) (List Module)))
(defn read-modules (path)
  (checked-stems (add-module path (path-resolve path) (read-source path (slurp path)) (path-dir path) empty-list (Mods empty-list map.empty))))

;; The modules of the program `text`, whose imports are found in the current directory.
(sig text-modules (Fn (String) (List Module)))
(defn text-modules (text)
  (checked-stems (add-module "" "" (read-source "" text) "." empty-list (Mods empty-list map.empty))))

;; `acc` with the module at `path` (whose key is `key`) and its imports added; `stack` holds
;; the keys of the modules importing it, to catch a cycle.
(sig add-module (Fn (String String (List Form) String (List String) Mods) Mods))
(defn add-module (path key forms dir stack acc)
  (let ((imports (++ (prelude-module key) (module-imports forms dir)))
        (inner
          (load-imports imports (++ stack (List key)) (assoc acc seen (map.set (get acc seen) key true)))))
    (assoc inner done
      (++ (get inner done)
         (List (Module path key (path-stem path) (other-forms forms dir) (imp-list imports)))))))

;; The prelude, as an import of the module `key`, unless it is the prelude or a declaration
;; module.
(sig prelude-module (Fn (String) (List (Tup String Imp))))
(defn prelude-module (key)
  (let ((path (library-path "prelude.cdy"))
        (prelude (path-resolve path)))
    (if (or (= prelude key) (is-declaration key)) empty-list (List (Tup path (Imp prelude NOWHERE None))))))

;; The library's directory: the translator's own (bin/py/; py_cdy/self_host.py copies the
;; library there).
(sig library-dir (Fn (Unit) String))
(defn library-dir (_) (module-dir sym-name))

;; The path of the library file `name` (form.cdy, special.cdy, system.cdy, the prelude and
;; its macros), which is kept next to the translator.
(sig library-path (Fn (String) String))
(defn library-path (name)
  (let ((dir (library-dir nil))
        (path (path-join dir name)))
    (if (file-exists path)
      path
      (fail (format "the translator needs {name} next to it, in {dir}")))))

;; The imports among `forms`: each imported file's path, with its Imp.
(sig module-imports (Fn ((List Form) String) (List (Tup String Imp))))
(defn module-imports (forms dir)
  (let ((shape (import-shape nil)))
    (map
      (fn (form)
        (let (((name only) (import-parts shape form))
              (path (import-path "import" dir name (form-pos form))))
          (Tup path (Imp (path-resolve path) (form-pos form) only))))
      (filter is-import forms))))

(sig imp-list (Fn ((List (Tup String Imp))) (List Imp)))
(defn imp-list (imports) (map (fn (i) (let (((_name imp) i)) imp)) imports))

;; `start` with the modules `imports` names read, unless they were already.
(sig load-imports (Fn ((List (Tup String Imp)) (List String) Mods) Mods))
(defn load-imports (imports stack start)
  (fold
    (fn (acc i)
      (let (((path imp) i)
            (key (get imp key)))
        (cond
          ((contains key stack)
            (fail (format "{(pos-text (get imp pos))}import: cycle {(cycle-text stack key)}")))
          ((map.has (get acc seen) key) acc)
          (else (add-module path key (read-source path (slurp path)) (path-dir path) stack acc)))))
    start
    imports))

;; The cycle that importing `key` again closes, by stem: a -> b -> a.
(sig cycle-text (Fn ((List String) String) String))
(defn cycle-text (stack key)
  (let ((cycle (drop (find-index (fn (k) (= k key)) stack) stack)))
    (++ (string.join (map path-stem cycle) " -> ") " -> " (path-stem key))))

;; `forms` without their imports; (import-macros name) as (import-macros "path").
(sig other-forms (Fn ((List Form) String) (List Form)))
(defn other-forms (forms dir)
  (map (fn (form) (macro-import form dir)) (filter (fn (form) (not (is-import form))) forms)))

;; The modules read, after checking that no two imported modules share a stem, which their
;; names' prefix comes from (the top module's names have none).
(sig checked-stems (Fn (Mods) (List Module)))
(defn checked-stems (mods)
  (let ((modules (get mods done))
        (checked (unique-stems (slice modules 0 (- (len modules) 1)) map.empty)))
    modules))

(sig unique-stems (Fn ((List Module) (Map String String)) Bool))
(defn unique-stems (modules start)
  (let ((_seen
          (fold
            (fn (seen m)
              (let ((stem (get m stem)))
                (if (map.has seen stem)
                  (fail (format "import: two modules are named {stem}: {(map.at seen stem)} and {(get m path)}"))
                  (map.set seen stem (get m path)))))
            start
            modules)))
    true))

;; (import-macros name) as (import-macros "path"), with `name.cdy` found in directory
;; `dir`; any other form as it is.
(sig macro-import (Fn (Form String) Form))
(defn macro-import (form dir)
  (let ((items (list-items form))
        (pos (form-pos form)))
    (cond
      ((or (= (len items) 0) (!= (sym-name (at items 0)) "import-macros")) form)
      ((and (= (len items) 2) (!= (sym-name (at items 1)) ""))
        (Lst (List (at items 0) (Txt (import-path "import-macros" dir (sym-name (at items 1)) pos) pos)) pos))
      (else (fail (++ (pos-text pos) "import-macros: expected (import-macros name)"))))))

;; Whether `form` is an import, `(import ...)`.
(sig is-import (Fn (Form) Bool))
(defn is-import (form)
  (let ((items (list-items form)))
    (and (> (len items) 0) (= (sym-name (at items 0)) "import"))))

;; import's shape, as special.cdy declares it (syntax.cdy).
(sig import-shape (Fn (Unit) (List Syntax)))
(defn import-shape (_)
  (let ((path (library-path "special.cdy")))
    (declared-shape (read-source path (slurp path)) "import")))

;; The import `form`'s module and the names it lists, if any, checked against `shape`.
(sig import-parts (Fn ((List Syntax) Form) (Tup String (Maybe (List Form)))))
(defn import-parts (shape form)
  (let ((args (rest (list-items form))))
    (cond
      ((not (fits-shape shape args))
        (fail (format "{(pos-text (form-pos form))}import: expected {(shape-text \"import\" shape)}")))
      ((= (len args) 1) (Tup (sym-name (at args 0)) None))
      (else (Tup (sym-name (at args 0)) (Some (list-items (at args 1))))))))

;; The library's declaration modules (doc/hl_rqmt/library_layers.md): each declares built-ins
;; the target defines, with bodiless sigs, and is always the library's, as what the
;; translator reads itself is. They are the modules the target's spellings name, each
;; built-in keyed by its module (core.cdy, builtin-key: `translator.fresh-name`), so no
;; list names them (doc/hl_rqmt/stdlib.md, step 1). system.cdy is one too, but its
;; built-ins keep their own names, and every file imports it implicitly, only qualified
;; (core.cdy, with-system), so it isn't among them.
(sig declaration-modules (Fn (Unit) (List String)))
(defn declaration-modules (_)
  (fold
    (fn (acc key)
      (let ((parts (string.split key ".")))
        (if (or (!= (len parts) 2) (= (at parts 0) "") (contains (at parts 0) acc)) acc (++ acc (List (at parts 0))))))
    empty-list
    (map.keys py-spellings)))

;; Whether `name` (an import's) is a declaration module's.
(sig is-declaration-name (Fn (String) Bool))
(defn is-declaration-name (name) (contains name (declaration-modules nil)))

;; Whether the module whose key is `key` is a declaration module, the library's.
(sig is-declaration (Fn (String) Bool))
(defn is-declaration (key)
  (any (fn (name) (= key (path-resolve (library-path (++ name ".cdy"))))) (declaration-modules nil)))

;; The library's files that aren't modules: the translator reads them itself.
(sig NOT_MODULES (List String))
(def NOT_MODULES (List "special" "prelude_macros"))

;; The path of `name.cdy`, imported at `pos` by `what` (import or import-macros): in
;; directory `dir`, or else in the library's (programs.import); a declaration module's is
;; always the library's. No import names `system`, which every file imports implicitly.
(sig import-path (Fn (String String String Pos) String))
(defn import-path (what dir name pos)
  (let ((file (++ name ".cdy"))
        (path (path-join dir file))
        (lib (path-join (library-dir nil) file)))
    (cond
      ((= (path-stem name) "system")
        (fail (format "{(pos-text pos)}{what}: every file imports system, implicitly")))
      ((is-declaration-name name) (library-path file))
      ((file-exists path) path)
      ((contains name NOT_MODULES)
        (fail (format "{(pos-text pos)}{what}: {name} is the translator's, not a module")))
      ((file-exists lib) lib)
      (else (fail (format "{(pos-text pos)}{what}: can't find {file} in {dir} or the library"))))))
