;;; Include: reading a program's files. A program is modules (doc/hl_rqmt/modules.md):
;;; `(import name)` at top level imports `name.cdy`, found in the importing file's
;;; directory, and read-modules returns each module after those it imports. A cycle is an
;;; error. Every file but the prelude itself also imports the prelude (prelude.cdy, next to
;;; the translator). `(import-macros name)` stays, with `name.cdy`'s path in place of the name, for
;;; expand.cdy to load.
;;;
;;; Macro files are still read with `import` as inclusion (read-program; step A of
;;; doc/hl_rqmt/self_host_cleanup.md): `(import name)` is replaced by the forms of
;;; `name.cdy`, and each file is included once.

(import form)
(import read)

;; --- modules ---

;; A module: its file (as the user would write the path; "" for text that isn't from a
;; file), its key (the absolute path), its stem, its forms without its imports, and what it
;; imports.
(deft Module ((path String) (key String) (stem String) (forms (List Form)) (imports (List Imp))))

;; An import: the imported module's key, and where the import is.
(deft Imp ((key String) (pos Pos)))

;; The modules read so far, each after those it imports, and the keys read or being read.
(deft Mods ((done (List Module)) (seen (Map String Bool))))

;; The modules of the program whose top file is at `path`; the top module is last.
(sig read-modules (Fn (String) (List Module)))
(defn read-modules (path)
  (checked-stems (add-module path (path-resolve path) (read-source path (slurp path)) (path-dir path) empty-list (Mods empty-list empty-map))))

;; The modules of the program `text`, whose imports are found in the current directory.
(sig text-modules (Fn (String) (List Module)))
(defn text-modules (text)
  (checked-stems (add-module "" "" (read-source "" text) "." empty-list (Mods empty-list empty-map))))

;; `acc` with the module at `path` (whose key is `key`) and its imports added; `stack` holds
;; the keys of the modules importing it, to catch a cycle.
(sig add-module (Fn (String String (List Form) String (List String) Mods) Mods))
(defn add-module (path key forms dir stack acc)
  (let ((imports (++ (prelude-module key) (module-imports forms dir)))
        (inner
          (load-imports imports (++ stack (List key)) (assoc acc seen (map-set (get acc seen) key true)))))
    (assoc inner done
      (++ (get inner done)
         (List (Module path key (path-stem path) (other-forms forms dir) (imp-list imports)))))))

;; The prelude, as an import of the module `key`, unless it is the prelude.
(sig prelude-module (Fn (String) (List (Tup String Imp))))
(defn prelude-module (key)
  (let ((path (library-path "prelude.cdy"))
        (prelude (path-resolve path)))
    (if (= prelude key) empty-list (List (Tup path (Imp prelude NOWHERE))))))

;; The path of the library file `name` (form.cdy, special.cdy, system.cdy, the prelude and its macros), which
;; is kept next to the translator (in bin/py/; py_cdy/self_host.py copies the library there).
(sig library-path (Fn (String) String))
(defn library-path (name)
  (let ((dir (module-dir sym-name))
        (path (path-join dir name)))
    (if (file-exists path)
      path
      (fail (format "the translator needs {name} next to it, in {dir}")))))

;; The imports among `forms`: each imported file's path, with its Imp.
(sig module-imports (Fn ((List Form) String) (List (Tup String Imp))))
(defn module-imports (forms dir)
  (map
    (fn (form)
      (let ((path (import-path "import" dir (import-name form) (form-pos form))))
        (Tup path (Imp (path-resolve path) (form-pos form)))))
    (filter (fn (form) (!= (import-name form) "")) forms)))

(sig imp-list (Fn ((List (Tup String Imp))) (List Imp)))
(defn imp-list (imports) (map (fn (i) (let (((_name imp) i)) imp)) imports))

;; `start` with the modules `imports` names read, unless they were already.
(sig load-imports (Fn ((List (Tup String Imp)) (List String) Mods) Mods))
(defn load-imports (imports stack start)
  (fold
    (fn (acc i)
      (let (((path imp) i)
            (key (get imp key)))
        (cond
          ((contains key stack)
            (fail (format "{(pos-text (get imp pos))}import: cycle {(cycle-text stack key)}")))
          ((map-has (get acc seen) key) acc)
          (else (add-module path key (read-source path (slurp path)) (path-dir path) stack acc)))))
    start
    imports))

;; The cycle that importing `key` again closes, by stem: a -> b -> a.
(sig cycle-text (Fn ((List String) String) String))
(defn cycle-text (stack key)
  (let ((cycle (drop (find-index (fn (k) (= k key)) stack) stack)))
    (++ (join (map path-stem cycle) " -> ") " -> " (path-stem key))))

;; `forms` without their imports; (import-macros name) as (import-macros "path").
(sig other-forms (Fn ((List Form) String) (List Form)))
(defn other-forms (forms dir)
  (map (fn (form) (macro-import form dir)) (filter (fn (form) (= (import-name form) "")) forms)))

;; The modules read, after checking that no two imported modules share a stem, which their
;; names' prefix comes from (the top module's names have none).
(sig checked-stems (Fn (Mods) (List Module)))
(defn checked-stems (mods)
  (let ((modules (get mods done))
        (checked (unique-stems (slice modules 0 (- (len modules) 1)) empty-map)))
    modules))

(sig unique-stems (Fn ((List Module) (Map String String)) Bool))
(defn unique-stems (modules start)
  (let ((_seen
          (fold
            (fn (seen m)
              (let ((stem (get m stem)))
                (if (map-has seen stem)
                  (fail (format "import: two modules are named {stem}: {(map-get seen stem)} and {(get m path)}"))
                  (map-set seen stem (get m path)))))
            start
            modules)))
    true))

;; --- inclusion (macro files) ---

;; The forms included so far, and the files they came from (absolute paths).
(deft Incl ((done (List Form)) (seen (Map String Bool))))

;; The forms of the Candy file at `path`, with its imports included.
(sig read-program (Fn (String) (List Form)))
(defn read-program (path)
  (get (include-file path (Incl empty-list empty-map)) done))

;; `forms` with their imports included, found in directory `dir`.
(sig include-imports (Fn ((List Form) String) (List Form)))
(defn include-imports (forms dir)
  (get (include-forms forms dir (Incl empty-list empty-map)) done))

;; `acc` with the forms of the file at `path` added, unless it was included already. The
;; forms' positions name the file by `path`, as the user would write it (an import's is
;; joined to its importer's directory); `seen` holds absolute paths, so each file counts
;; once.
(sig include-file (Fn (String Incl) Incl))
(defn include-file (path acc)
  (let ((key (path-resolve path)))
    (if (map-has (get acc seen) key)
      acc
      (include-forms
        (read-source path (slurp path))
        (path-dir path)
        (assoc acc seen (map-set (get acc seen) key true))))))

;; `forms`, whose imports are found in directory `dir`.
(sig include-forms (Fn ((List Form) String Incl) Incl))
(defn include-forms (forms dir start)
  (fold
    (fn (acc form)
      (let ((name (import-name form)))
        (if (= name "")
          (assoc acc done (++ (get acc done) (List (macro-import form dir))))
          (include-file (import-path "import" dir name (form-pos form)) acc))))
    start
    forms))

;; (import-macros name) as (import-macros "path"), with `name.cdy` found in directory
;; `dir`; any other form as it is.
(sig macro-import (Fn (Form String) Form))
(defn macro-import (form dir)
  (let ((items (list-items form))
        (pos (form-pos form)))
    (cond
      ((or (= (len items) 0) (!= (sym-name (at items 0)) "import-macros")) form)
      ((and (= (len items) 2) (!= (sym-name (at items 1)) ""))
        (Lst (List (at items 0) (Txt (import-path "import-macros" dir (sym-name (at items 1)) pos) pos)) pos))
      (else (fail (++ (pos-text pos) "import-macros: expected (import-macros name)"))))))

;; The name in `(import name)`, or "" if `form` isn't an import.
(sig import-name (Fn (Form) String))
(defn import-name (form)
  (let ((items (list-items form)))
    (cond
      ((or (= (len items) 0) (!= (sym-name (at items 0)) "import")) "")
      ((and (= (len items) 2) (!= (sym-name (at items 1)) "")) (sym-name (at items 1)))
      (else (fail (++ (pos-text (form-pos form)) "import: expected (import name)"))))))

;; The path of `name.cdy` in directory `dir`, imported at `pos` by `what` (import or
;; import-macros).
(sig import-path (Fn (String String String Pos) String))
(defn import-path (what dir name pos)
  (let ((path (path-join dir (++ name ".cdy"))))
    (if (file-exists path)
      path
      (fail (format "{(pos-text pos)}{what}: can't find {name}.cdy in {dir}")))))
