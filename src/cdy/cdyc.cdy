;;; cdyc: the Candy translator, written in Candy. Candy in, Python out. Its steps are in the
;;; files it imports: form (the forms), read (the reader), include (`import`), expand
;;; (macros), core (analyse into the Core AST), lower (the lowered IR) and emit (Python
;;; source). The checked-in
;;; build is bin/py/cdy_translator.py; it rebuilds itself from this file (see bin/README.md).
;;; Run it to translate a file: python bin/py/cdy_translator.py FILE.cdy [OUT.py] (`main`,
;;; at the end).

(import form)
(import read)
(import include)
(import core)
(import expand)
(import lower)
(import emit)

;; --- the whole translator: forms in, Python source out ---

;; A module with its macros expanded: its forms, its macros (format holes are expanded with
;; them), and what it exports.
(deft Ready ((module Module) (forms (List Form)) (macros (Map String Macro)) (exports Exports)))

;; The program `modules` (doc/hl_rqmt/modules.md), the top module last, as one Python
;; module. Each module is expanded and analysed on its own, seeing what it imports; then
;; their definitions are lowered and emitted together. `parse` reads the forms in `format`
;; holes: read-forms (see translate-text).
(sig translate-modules (Fn ((List Module) (Fn (String) (List Form))) String))
(defn translate-modules (modules parse)
  (let ((ready (expand-modules modules (- (len modules) 1) empty-list))
        (by-key (exports-by-key ready empty-map))
        (elsewhere (elsewhere-names (exports-of ready empty-list) empty-map))
        (builtins (library-builtins nil)))
    (python-of (analyse-modules ready by-key elsewhere builtins parse empty-list))))

;; Each of `modules` with its macros expanded; `top` is the top module's index.
(sig expand-modules (Fn ((List Module) Int (List Ready)) (List Ready)))
(defn expand-modules (modules top acc)
  (if (= (len acc) (len modules))
    acc
    (let ((m (at modules (len acc)))
          ((forms macros) (expand-program (get m forms) compile-macros))
          (prefix (if (= (len acc) top) "" (+ (get m stem) "__"))))
      (expand-modules modules top (+ acc (to-list (Ready m forms macros (module-exports forms (get m stem) prefix))))))))

(sig exports-by-key (Fn ((List Ready) (Map String Exports)) (Map String Exports)))
(defn exports-by-key (ready acc)
  (if (= (len ready) 0)
    acc
    (let ((r (at ready 0)))
      (exports-by-key (slice ready 1 (len ready)) (map-set acc (get (get r module) key) (get r exports))))))

(sig exports-of (Fn ((List Ready) (List Exports)) (List Exports)))
(defn exports-of (ready acc)
  (if (= (len ready) 0)
    acc
    (exports-of (slice ready 1 (len ready)) (+ acc (to-list (get (at ready 0) exports))))))

;; The definitions of all the modules, in order.
(sig analyse-modules
  (Fn ((List Ready) (Map String Exports) (Map String String) (Map String Builtin) (Fn (String) (List Form)) (List Top))
      (List Top)))
(defn analyse-modules (ready by-key elsewhere builtins parse acc)
  (if (= (len ready) 0)
    acc
    (let ((r (at ready 0))
          (macros (get r macros))
          (tops
            (analyse-module
              (get r forms)
              (get r exports)
              (imported (get (get r module) imports) by-key empty-list)
              elsewhere
              builtins
              (fn (text) (expand-all (parse text) macros empty-list))
              macros
              false)))
      (analyse-modules (slice ready 1 (len ready)) by-key elsewhere builtins parse (+ acc tops)))))

;; The exports of each import, with where it is.
(sig imported (Fn ((List Imp) (Map String Exports) (List (Tup Exports Pos))) (List (Tup Exports Pos))))
(defn imported (imps by-key acc)
  (if (= (len imps) 0)
    acc
    (let ((imp (at imps 0)))
      (imported (slice imps 1 (len imps)) by-key (+ acc (to-list (tup (map-get by-key (get imp key)) (get imp pos))))))))

;; A macro program (expand.cdy) as Python. It is macro code, so it can quote.
(sig compile-macros (Fn ((List Form)) String))
(defn compile-macros (forms) (translate-expanded forms read-forms empty-map true))

;; `forms`, one program with no imports and no macro calls left, as Python; `macros` are
;; the program's macros.
(sig translate-expanded (Fn ((List Form) (Fn (String) (List Form)) (Map String Macro) Bool) String))
(defn translate-expanded (forms parse macros quoting)
  (python-of (analyse-program forms (library-builtins nil) parse macros quoting)))

;; The definitions `tops` as a Python module.
(sig python-of (Fn ((List Top)) String))
(defn python-of (tops)
  (let ((stmts (lower-program tops 0 empty-list))
        (globals (global-names tops (Env empty-map empty-map empty-map (generic-variants tops empty-map) initial-table)))
        (env (bind-locals (bound-locals stmts empty-list) globals)))
    (+ HEADER
       (emit-imports PY_IMPORTS "")
       "\n"
       (emit-stmts stmts 0 env "")
       (if (has-main tops) (emit-main env) ""))))

;; Candy text in, Python source out, read by the Candy reader (read.cdy), which also
;; reads the forms in `format` holes. Its imports are found in the current directory.
(sig translate-text (Fn (String) String))
(defn translate-text (text) (translate-modules (text-modules text) read-forms))

;; The Candy file at `path` as Python source; its imports are found next to it.
(sig translate-file (Fn (String) String))
(defn translate-file (path) (translate-modules (read-modules path) read-forms))

;; --- the driver ---

(sig USAGE String)
(def USAGE "usage: cdy_translator.py FILE.cdy [OUT.py]")

;; Translate FILE.cdy into OUT.py, by default output/FILE.py (as py_cdy/main.py does).
(sig main (Fn ((List String)) Int))
(defn main (args)
  (if (or (= (len args) 0) (> (len args) 2))
    (do (put-err USAGE) 2)
    (let ((src (at args 0))
          (out (if (= (len args) 2) (at args 1) (path-join "output" (+ (path-stem src) ".py"))))
          (python (translate-file src)))
      (do
        (make-dirs (path-dir out))
        (spit out python)
        (put-err (format "candy: {src} -> {out}"))
        0))))
