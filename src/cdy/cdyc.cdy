;;; cdyc: the Candy translator, written in Candy. Candy in, Python out. Its steps are in the
;;; files it imports: form (the forms), read (the reader), include (`import`), expand
;;; (macros), core (analyse into the Core AST), lower (the lowered IR) and emit (Python
;;; source). The checked-in
;;; build is bin/py/cdy_translator.py; it rebuilds itself from this file (see bin/README.md).
;;; Run it to translate a file: python bin/py/cdy_translator.py FILE.cdy [OUT.py] (`main`,
;;; at the end).

(import form)
(import read)
(import include)
(import core)
(import expand)
(import lower)
(import emit)
(import check)
(import translator)

;; --- the whole translator: forms in, Python source out ---

;; A module with its macros expanded: its forms, its macros (format holes are expanded with
;; them), and what it exports.
(deft Ready ((module Module) (forms (List Form)) (macros (Map String Macro)) (exports Exports)))

;; The program `modules` (doc/hl_rqmt/modules.md), the top module last, as one Python
;; module. Each module is expanded and analysed on its own, seeing what it imports; then
;; their definitions are type-checked (check.cdy), lowered and emitted together. `parse`
;; reads the forms in `format` holes, at the hole's position: read-hole (see translate-text).
(sig translate-modules (Fn ((List Module) (Fn (String Pos) (List Form))) String))
(defn translate-modules (modules parse)
  (let ((builtins (library-builtins nil)))
    (python-of (type-check (program-tops modules parse builtins) builtins) (get (at modules (- (len modules) 1)) stem))))

;; The Expander for a translation: the built-ins read once, and the prelude's macros loaded
;; once, for every module ([[B66]], [[B62]]).
(sig expander (Fn ((Map String Builtin)) Expander))
(defn expander (builtins) (new-expander builtins (compile-macros builtins (macro-imports nil))))

;; The definitions of the program `modules`, analysed (see translate-modules); not yet
;; type-checked (check.cdy).
(sig program-tops (Fn ((List Module) (Fn (String Pos) (List Form)) (Map String Builtin)) (List Top)))
(defn program-tops (modules parse builtins)
  (let ((ready (expand-modules modules (expander builtins)))
        (by-key (exports-by-key ready))
        (elsewhere (elsewhere-names (exports-of ready))))
    (analyse-modules ready by-key elsewhere builtins parse)))

;; Each of `modules` with its macros expanded. A declaration module (translator.cdy) exports
;; what it declares, its built-ins, as well as what its definitions, ordinary Candy,
;; define (doc/hl_rqmt/stdlib.md, Question 2).
(sig expand-modules (Fn ((List Module) Expander) (List Ready)))
(defn expand-modules (modules ex)
  (map
    (fn (m)
      (let ((declaring (is-declaration (get m key)))
            (all (get m forms))
            ((forms macros) (expand-program (if declaring (definitions all) all) ex))
            (own (module-exports forms (get m stem))))
        (Ready m forms macros (if declaring (with-declared own all (get m stem)) own))))
    modules))

(sig exports-by-key (Fn ((List Ready)) (Map String Exports)))
(defn exports-by-key (ready)
  (fold (fn (m r) (map-set m (get (get r module) key) (get r exports))) empty-map ready))

(sig exports-of (Fn ((List Ready)) (List Exports)))
(defn exports-of (ready) (map (fn (r) (get r exports)) ready))

;; The definitions of all the modules, in order.
(sig analyse-modules
  (Fn ((List Ready) (Map String Exports) (Map String String) (Map String Builtin) (Fn (String Pos) (List Form)))
      (List Top)))
(defn analyse-modules (ready by-key elsewhere builtins parse)
  (concat
    (map
      (fn (r)
        (let ((macros (get r macros)))
          (analyse-module
            (get r forms)
            (get r exports)
            (imported (get (get r module) imports) by-key)
            elsewhere
            builtins
            (fn (text where) (expand-all (parse text where) macros))
            macros
            false)))
      ready)))

;; Each import, with its module's exports.
(sig imported (Fn ((List Imp) (Map String Exports)) (List Import)))
(defn imported (imps by-key)
  (map (fn (imp) (Import (map-get by-key (get imp key)) (get imp pos) (get imp only))) imps))

;; How a macro program (expand.cdy) becomes Python, with `builtins` and macro code's
;; `imports` (macro-imports), each read once per translation. It is macro code, so it can
;; quote.
(sig compile-macros (Fn ((Map String Builtin) (List Import)) (Fn ((List Form)) String)))
(defn compile-macros (builtins imports)
  (fn (forms) (translate-expanded forms read-hole empty-map true builtins imports)))

;; `forms`, one program with no imports and no macro calls left, as Python; `macros` are
;; the program's macros, `builtins` the built-ins, and `imports` what it imports
;; implicitly.
(sig translate-expanded
  (Fn ((List Form) (Fn (String Pos) (List Form)) (Map String Macro) Bool (Map String Builtin) (List Import)) String))
(defn translate-expanded (forms parse macros quoting builtins imports)
  (python-of (analyse-program forms imports builtins parse macros quoting) ""))

;; What macro code imports implicitly: translator, the library's (`gensym`, form.cdy,
;; calls fresh-name).
(sig macro-imports (Fn (Unit) (List Import)))
(defn macro-imports (_)
  (let ((path (library-path "translator.cdy")))
    (List (Import (declared-exports (read-source path (slurp path)) "translator") NOWHERE None))))

;; The definitions `tops` as a Python module, which first makes a panic stop the program
;; with its message (`stop_on_panic`; spec/60-library.md, library.errors); `top` is the
;; top module, whose names have no prefix ("" for macro code).
(sig python-of (Fn ((List Top) String) String))
(defn python-of (tops top)
  (let ((stmts (lower-program tops 0))
        (globals (global-names tops (Env empty-map empty-map empty-map (generic-variants tops) py-spellings empty-map (deft-field-types tops) top)))
        (env (bind-locals (bound-locals stmts empty-list) globals)))
    (++ HEADER
       (emit-imports PY_IMPORTS)
       "\ncdy_rt.primitives.stop_on_panic()\n"
       (emit-stmts stmts 0 env)
       (if (has-main tops top) (emit-main env) ""))))

;; Candy text in, Python source out, read by the Candy reader (read.cdy), which also
;; reads the forms in `format` holes. Its imports are found in the current directory.
(sig translate-text (Fn (String) String))
(defn translate-text (text) (translate-modules (text-modules text) read-hole))

;; The Candy file at `path` as Python source; its imports are found next to it.
(sig translate-file (Fn (String) String))
(defn translate-file (path) (translate-modules (read-modules path) read-hole))

;; --- the driver ---

(sig USAGE String)
(def USAGE "usage: cdy_translator.py FILE.cdy [OUT.py]")

;; Translate FILE.cdy into OUT.py, by default output/FILE.py (as py_cdy/main.py does).
(sig main (Fn ((List String)) Int))
(defn main (args)
  (if (or (= (len args) 0) (> (len args) 2))
    (do (put-err USAGE) 2)
    (let ((src (at args 0))
          (out (if (= (len args) 2) (at args 1) (path-join "output" (++ (path-stem src) ".py"))))
          (python (translate-file src)))
      (do
        (make-dirs (path-dir out))
        (spit out python)
        (put-err (format "candy: {src} -> {out}"))
        0))))
