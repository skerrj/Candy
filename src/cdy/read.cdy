;;; Read: Candy source text as Forms (stage 3 of doc/hl_rqmt/self_hosting_primo.md).
;;; A hand-written recursive-descent reader that accepts exactly what the Python
;;; translator's parse_cdy.py did (at tag self-host-py; see the grammar there). Like tst/cdy/read_sexpr.cdy it walks the text by
;;; position, so it needs no closures. An error fails with its line and column.

(import form)

(sig read-forms (Fn (String) (List Form)))
(defn read-forms (text) (read-all (Source "" empty-list NOWHERE) text (skip text 0) empty-list))

;; The forms in `text`, from the file `file` ("" for none), with their positions.
(sig read-source (Fn (String String) (List Form)))
(defn read-source (file text)
  (read-all (Source file (line-starts text 0 (List 0)) (Pos file 1 1)) text (skip text 0) empty-list))

;; The forms in a `format` hole's text, whose first character is at `where` (NOWHERE: no
;; positions, as read-forms).
(sig read-hole (Fn (String Pos) (List Form)))
(defn read-hole (text where)
  (if (= (get where line) 0)
    (read-forms text)
    (read-all (Source (get where file) (line-starts text 0 (List 0)) where) text (skip text 0) empty-list)))

;; What the reader knows about its text: the file it came from, where each line starts
;; (its offsets, in order), to give each form a Pos, and where the text starts in the file
;; (1:1 for a file; a format hole's position for its text). No line starts: forms are
;; NOWHERE (as for read-forms).
(deft Source ((file String) (starts (List Int)) (base Pos)))

(sig line-starts (Fn (String Int (List Int)) (List Int)))
(defn line-starts (text pos acc)
  (cond
    ((>= pos (str-len text)) acc)
    ((= (char-text text pos) "\n") (line-starts text (+ pos 1) (++ acc (List (+ pos 1)))))
    (else (line-starts text (+ pos 1) acc))))

;; The position of offset `pos`.
(sig pos-at (Fn (Source Int) Pos))
(defn pos-at (src pos)
  (let ((starts (get src starts)))
    (if (= (len starts) 0)
      NOWHERE
      (let ((i (line-of starts pos 0 (len starts))))
        (Pos
          (get src file)
          (+ i (get (get src base) line))
          (+ (- pos (at starts i)) (if (= i 0) (get (get src base) col) 1)))))))

;; The index of the last line start at or before `pos`, between `lo` and `hi` (binary search).
(sig line-of (Fn ((List Int) Int Int Int) Int))
(defn line-of (starts pos lo hi)
  (if (<= (- hi lo) 1)
    lo
    (let ((mid (quot (+ lo hi) 2)))
      (if (<= (at starts mid) pos) (line-of starts pos mid hi) (line-of starts pos lo mid)))))

(sig read-all (Fn (Source String Int (List Form)) (List Form)))
(defn read-all (src text pos acc)
  (if (>= pos (str-len text))
    acc
    (let (((form next) (read-form src text pos)))
      (read-all src text (skip text next) (++ acc (List form))))))

;; --- whitespace and comments ---

;; The position of the next character that isn't whitespace or in a `;` comment.
(sig skip (Fn (String Int) Int))
(defn skip (text pos)
  (cond
    ((>= pos (str-len text)) pos)
    ((isspace-at text pos) (skip text (+ pos 1)))
    ((= (char-at text pos) \;) (skip text (line-end text pos)))
    (else pos)))

(sig line-end (Fn (String Int) Int))
(defn line-end (text pos)
  (if (or (>= pos (str-len text)) (= (char-text text pos) "\n")) pos (line-end text (+ pos 1))))

;; Whether a literal may end just before `pos`: at the end, whitespace, a paren or a `;`.
(sig ends-at (Fn (String Int) Bool))
(defn ends-at (text pos)
  (or (>= pos (str-len text)) (isspace-at text pos) (str-contains (char-text text pos) "();")))

(sig word-end (Fn (String Int) Int))
(defn word-end (text pos) (if (ends-at text pos) pos (word-end text (+ pos 1))))

;; The character at `i` in `s`, as a String: to compare it with one that has no `Char`
;; literal (`"\n"`), or look for it in a string.
(sig char-text (Fn (String Int) String))
(defn char-text (s i) (text (char-at s i)))

;; --- forms ---

;; The form at `pos` (not whitespace), and the position after it.
(sig read-form (Fn (Source String Int) (Tup Form Int)))
(defn read-form (src text pos)
  (let ((ch (char-at text pos)))
    (cond
      ((= ch \() (read-list src text (skip text (+ pos 1)) empty-list pos))
      ((= ch \)) (fail (parse-error src text pos "unexpected )")))
      ((= ch \") (read-str src text (+ pos 1) "" pos))
      ((= ch \\) (read-char src text pos))
      (else (read-atom src text pos (word-end text pos))))))

;; The rest of the list whose `(` is at `start`, from `pos`; and the position after its `)`.
(sig read-list (Fn (Source String Int (List Form) Int) (Tup Form Int)))
(defn read-list (src text pos acc start)
  (cond
    ((>= pos (str-len text)) (fail (parse-error src text start "( is never closed")))
    ((= (char-at text pos) \)) (Tup (Lst acc (pos-at src start)) (+ pos 1)))
    (else
      (let (((form next) (read-form src text pos)))
        (read-list src text (skip text next) (++ acc (List form)) start)))))

;; A char literal: `\` and one character that isn't whitespace, then a delimiter.
(sig read-char (Fn (Source String Int) (Tup Form Int)))
(defn read-char (src text pos)
  (if (and (< (+ pos 1) (str-len text)) (not (isspace-at text (+ pos 1))) (ends-at text (+ pos 2)))
    (Tup (CharLit (char-at text (+ pos 1)) (pos-at src pos)) (+ pos 2))
    (fail (parse-error src text pos "a char is \\ and one character, then a delimiter"))))

;; A number, boolean or symbol; the word (up to the next delimiter) runs to `end`.
(sig read-atom (Fn (Source String Int Int) (Tup Form Int)))
(defn read-atom (src text pos end)
  (let ((word (substring text pos end))
        (kind (number-kind word)))
    (cond
      ((!= kind "") (Tup (number-form src text pos word kind) end))
      ((= word "true") (Tup (BoolLit true (pos-at src pos)) end))
      ((= word "false") (Tup (BoolLit false (pos-at src pos)) end))
      ((symbol-start (char-text text pos))
        (let ((stop (symbol-end text (+ pos 1)))
              (name (substring text pos stop)))
          (if (str-contains "__" name)
            (fail (parse-error src text pos "a name can't contain __ (only gensym makes such names)"))
            (Tup (Sym name (pos-at src pos)) stop))))
      (else (fail (parse-error src text pos (format "unexpected {(char-at text pos)}")))))))

;; --- symbols ---

;; A symbol can't start with a digit, `'`, `#`, `"` or `\` (or a delimiter).
(sig symbol-start (Fn (String) Bool))
(defn symbol-start (ch) (not (or (str-contains ch "'#\"\\") (is-decimal ch))))

;; A symbol runs up to a delimiter, `'`, `"` or `\`.
(sig symbol-end (Fn (String Int) Int))
(defn symbol-end (text pos)
  (if (or (>= pos (str-len text)) (isspace-at text pos) (str-contains (char-text text pos) "()'\";\\"))
    pos
    (symbol-end text (+ pos 1))))

;; --- numbers ---

(sig digits-end (Fn (String Int) Int))
(defn digits-end (word pos)
  (if (and (< pos (str-len word)) (is-decimal (char-text word pos))) (digits-end word (+ pos 1)) pos))

;; What literal `word` is: "int" (100), "long" (1500l), "byte" (1b), "double" (10.0,
;; 1.5e-3), "float" (3.14f), or "" if it isn't a number. The digits may follow a `-`.
(sig number-kind (Fn (String) String))
(defn number-kind (word)
  (let ((start (if (= (char-at word 0) \-) 1 0))
        (i (digits-end word start))
        (rest (substring word i (str-len word))))
    (cond
      ((= i start) "")
      ((= rest "") "int")
      ((= rest "l") "long")
      ((= rest "b") "byte")
      ((= (char-at rest 0) \.)
        (let ((j (digits-end word (+ i 1)))
              (tail (substring word (exponent-end word j) (str-len word))))
          (cond
            ((or (= j (+ i 1)) (= (exponent-end word j) 0)) "")
            ((= tail "") "double")
            ((= tail "f") "float")
            (else ""))))
      (else ""))))

;; Where the exponent from `pos` (`e`, maybe `-`, digits) ends: `pos` if there is none,
;; 0 if it has no digits.
(sig exponent-end (Fn (String Int) Int))
(defn exponent-end (word pos)
  (if (and (< pos (str-len word)) (= (char-at word pos) \e))
    (let ((start (if (and (< (+ pos 1) (str-len word)) (= (char-at word (+ pos 1)) \-)) (+ pos 2) (+ pos 1)))
          (end (digits-end word start)))
      (if (= end start) 0 end))
    pos))

;; The literal `word` of `kind` at `pos`, or an error if its value is out of its type's range.
(sig number-form (Fn (Source String Int String String) Form))
(defn number-form (src text pos word kind)
  (let ((body (substring word 0 (- (str-len word) 1)))
        (where (pos-at src pos))
        (form (cond
                ((= kind "int") (IntLit (to-int word) where))
                ((= kind "long") (LongLit (to-int body) where))
                ((= kind "byte") (ByteLit (to-int body) where))
                ((= kind "double") (DoubleLit (to-float word) where))
                (else (FloatLit (to-float body) where))))
        (range (number-range form)))
    (if (= range "") form (fail (parse-error src text pos (format "{word} is out of range: {range}"))))))

;; "" if the literal `form` is in its type's range (the sizes: syntax.numbers), else the range.
(sig number-range (Fn (Form) String))
(defn number-range (form)
  (match form
    ((IntLit v _) (if (and (>= v (- 0 (to-int "2147483648"))) (<= v (to-int "2147483647"))) "" "an Int is -2147483648 to 2147483647"))
    ((LongLit v _) (if (and (>= v (- 0 (to-int "9223372036854775808"))) (<= v (to-int "9223372036854775807"))) "" "a Long is -9223372036854775808 to 9223372036854775807"))
    ((ByteLit v _) (if (and (>= v 0) (<= v 255)) "" "a Byte is 0 to 255"))
    ((FloatLit v _) (if (<= (- 0.0 (to-float "3.4028234663852886e38")) v (to-float "3.4028234663852886e38")) "" "a Float is -3.4028234663852886e38 to 3.4028234663852886e38"))
    ((DoubleLit v _) (if (<= (- 0.0 (to-float "1.7976931348623157e308")) v (to-float "1.7976931348623157e308")) "" "a Double is -1.7976931348623157e308 to 1.7976931348623157e308"))
    (else "")))

;; --- strings ---

;; The rest of the string whose `"` is at `start`, from `pos`, decoded into `acc`; and the
;; position after its closing `"`.
(sig read-str (Fn (Source String Int String Int) (Tup Form Int)))
(defn read-str (src text pos acc start)
  (cond
    ((>= pos (str-len text)) (fail (parse-error src text start "string is never closed")))
    ((= (char-at text pos) \") (Tup (Txt acc (pos-at src start)) (+ pos 1)))
    ((= (char-at text pos) \\)
      (let (((ch next) (escape src text pos)))
        (read-str src text next (++ acc ch) start)))
    (else (read-str src text (+ pos 1) (++ acc (char-text text pos)) start))))

;; The escape sequence whose `\` is at `pos`: what it stands for, and the position after it.
(sig escape (Fn (Source String Int) (Tup String Int)))
(defn escape (src text pos)
  (let ((c (if (< (+ pos 1) (str-len text)) (char-text text (+ pos 1)) "")))
    (cond
      ((contains c (List "\\" "/" "\"")) (Tup c (+ pos 2)))
      ((= c "b") (Tup "\b" (+ pos 2)))
      ((= c "f") (Tup "\f" (+ pos 2)))
      ((= c "n") (Tup "\n" (+ pos 2)))
      ((= c "r") (Tup "\r" (+ pos 2)))
      ((= c "t") (Tup "\t" (+ pos 2)))
      ((and (= c "u") (<= (+ pos 6) (str-len text)) (all-hex text (+ pos 2) (+ pos 6)))
        (Tup (hex-char (substring text (+ pos 2) (+ pos 6))) (+ pos 6)))
      (else (fail (parse-error src text pos "bad escape sequence"))))))

(sig all-hex (Fn (String Int Int) Bool))
(defn all-hex (text pos end)
  (cond
    ((>= pos end) true)
    ((str-contains (char-text text pos) "0123456789abcdefABCDEF") (all-hex text (+ pos 1) end))
    (else false)))

;; --- errors ---

(sig parse-error (Fn (Source String Int String) String))
(defn parse-error (src text pos msg)
  (let (((row col) (row-col text 0 pos 1 1)))
    (format "{(pos-text (Pos (get src file) row col))}parse error: {msg}")))

;; The line and column of `pos`, counting from character `i` at line `row`, column `col`.
(sig row-col (Fn (String Int Int Int Int) (Tup Int Int)))
(defn row-col (text i pos row col)
  (cond
    ((>= i pos) (Tup row col))
    ((= (char-text text i) "\n") (row-col text (+ i 1) pos (+ row 1) 1))
    (else (row-col text (+ i 1) pos row (+ col 1)))))
