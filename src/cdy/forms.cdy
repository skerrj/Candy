;;; Forms: the special forms and the operators, declared (doc/hl_rqmt/symbol_table.md).
;;; What the language's own forms are is a fact about Candy, the same for every target, so
;;; it is stated here, in Candy; system.cdy declares the other built-ins, with their types.
;;; The translator reads both into its built-ins (read-builtins in core.cdy) and checks them
;;; against the target's spellings (src/cdy_rt/table.py).
;;;
;;; (special name): a special form, analysed by its own rule (src/cdy/candy-special.md).
;;; (op name variadic): an operator taking two or more arguments; (op name unary): one.
;;; This file is read as it is, so it can't use macros.

;; --- modules and macros ---
(special import)
(special import-macros)
(special defmacro)
(special quo)
(special quasi)
(special unq)
(special unq-sp)

;; --- definitions ---
(special def)
(special defn)
(special sig)
(special deft)

;; --- expressions ---
(special do)
(special if)
(special let)
(special fn)
(special format)
(special tup)
(special get)
(special assoc)
(special match)

;; --- arithmetic: folds left ---
(op + variadic)
(op - variadic)
(op * variadic)
(op / variadic)
(op quot variadic)

;; --- comparison: chains ---
(op = variadic)
(op != variadic)
(op < variadic)
(op > variadic)
(op <= variadic)
(op >= variadic)

;; --- logic: short-circuits ---
(op and variadic)
(op or variadic)
(op not unary)
