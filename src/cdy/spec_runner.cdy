;;; The spec's runner (doc/hl_rqmt/test_runner.md; spec/README.md): a spec file's
;;; examples, read from its fenced blocks, each checked on the interpreter or through the
;;; translator.
;;; A module of the translator, run by cdyc.cdy's --spec flag and by test_spec.py; it
;;; imports neither the interpreter nor cdyc.cdy, which hands it what it runs.
;;;
;;; A spec file's fenced blocks are its examples (spec/README.md):
;;; - `candy run`, then `expect`: the program's output must be the `expect` block;
;;; - `candy error`, then `expect-error`: translating it must fail, with a message that
;;;   holds the `expect-error` text;
;;; - `candy panic`, then `expect-panic`: it must translate, and running it must panic,
;;;   with the `expect-panic` text in its message;
;;; - `candy errors`: one error example per line, `source => message`, after any setup
;;;   lines ended by a `---` line (one per table), which go before each row's source and
;;;   must translate on their own;
;;; - any other fence (`candy` alone, `markdown`): an illustration, not run.

(import string ())

;; --- fences ---

;; A fenced block: its info string (`candy run`), its text, and its opening line (from 1).
(deft Block ((info String) (text String) (line Int)))

;; The fenced blocks of the Markdown `text`, in order, as script/doc_links.py reads them:
;; a fence is three or more backticks, after any spaces, then the info string; it is
;; closed by as many backticks or more, after any spaces, with nothing after them but
;; spaces; one never closed runs to the end. A block's lines lose up to its fence's
;; indent.
(sig blocks (Fn (String) (List Block)))
(defn blocks (text)
  (let ((lines (string.lines text)))
    (blocks-from lines 0 empty-list)))

(sig blocks-from (Fn ((List String) Int (List Block)) (List Block)))
(defn blocks-from (lines i acc)
  (if (>= i (len lines))
    acc
    (let ((line (at lines i))
          (indent (run-of line 0 " "))
          (ticks (run-of line indent "`")))
      (if (< ticks 3)
        (blocks-from lines (+ i 1) acc)
        (let ((end (closing lines (+ i 1) ticks))
              (info (string.trim (string.slice line (+ indent ticks) (string.len line))))
              (body (block-text (slice lines (+ i 1) end) indent)))
          (blocks-from lines (+ end 1) (++ acc (List (Block info body (+ i 1))))))))))

;; A block's `lines` as its text, each without up to `indent` spaces, and ending with a
;; newline. (Apart from blocks-from, so that has no closure and is a loop.)
(sig block-text (Fn ((List String) Int) String))
(defn block-text (lines indent)
  (string.join (map (fn (l) (++ (dedent l indent) "\n")) lines) ""))

;; The index of the line, from `i`, that closes a fence of `ticks` backticks; the number
;; of lines if none does.
(sig closing (Fn ((List String) Int Int) Int))
(defn closing (lines i ticks)
  (cond
    ((>= i (len lines)) (len lines))
    ((closes (at lines i) ticks) i)
    (else (closing lines (+ i 1) ticks))))

;; Whether `line` closes a fence of `ticks` backticks.
(sig closes (Fn (String Int) Bool))
(defn closes (line ticks)
  (let ((indent (run-of line 0 " "))
        (n (run-of line indent "`")))
    (and (>= n ticks) (= (string.trim (string.slice line (+ indent n) (string.len line))) ""))))

;; How many times `c`, one character, comes in a row in `s` from `i`.
(sig run-of (Fn (String Int String) Int))
(defn run-of (s i c)
  (run-from s i c 0))

(sig run-from (Fn (String Int String Int) Int))
(defn run-from (s i c n)
  (if (and (< i (string.len s)) (= (string.slice s i (+ i 1)) c))
    (run-from s (+ i 1) c (+ n 1))
    n))

;; `line` without up to `indent` spaces at its start (its fence's indent).
(sig dedent (Fn (String Int) String))
(defn dedent (line indent)
  (let ((spaces (run-of line 0 " ")))
    (string.slice line (if (< spaces indent) spaces indent) (string.len line))))

;; --- the status line ---

(sig STATUSES (List String))
(def STATUSES (List "draft" "stable" "deprecated"))

;; The status of a spec file, from its first status line (`status: stable`, or `status:
;; draft, since: sum-types`), or "" if it has none.
(sig status (Fn (String) String))
(defn status (text)
  (with-default "" (find (fn (s) (!= s "")) (map status-of (string.lines text)))))

;; The status `line` gives, or "" if it isn't a status line.
(sig status-of (Fn (String) String))
(defn status-of (line)
  (if (not (string.starts-with line "status: "))
    ""
    (let ((rest (string.slice line 8 (string.len line)))
          (word (with-default "" (find (fn (s) (string.starts-with rest s)) STATUSES)))
          (after (string.slice rest (string.len word) (string.len rest))))
      (if (and (!= word "") (status-tail after)) word ""))))

;; Whether `after`, what follows a status line's word, is nothing but spaces, or `, since:
;; NAME` and then nothing but spaces.
(sig status-tail (Fn (String) Bool))
(defn status-tail (after)
  (let ((since ", since: "))
    (cond
      ((= (string.trim after) "") true)
      ((not (string.starts-with after since)) false)
      (else (is-word (string.slice after (string.len since) (string.len after)))))))

;; Whether `s` is a word, characters other than spaces, and then nothing but spaces.
(sig is-word (Fn (String) Bool))
(defn is-word (s)
  (let ((word (string.trim s)))
    (and (!= word "") (string.starts-with s word) (not (string.contains " " word)))))

;; --- examples ---

;; An example: its kind ("run", "error", "panic" or "setup"), its program, and its output
;; ("run") or part of its message ("error", "panic"); a "setup" (an error table's) has no
;; expected text, and must translate. `line` is its block's opening line, or its row's.
(deft Example ((kind String) (source String) (expected String) (line Int)))

;; The blocks an expect block follows, and the kind of example they make.
(sig PAIRS (List (Tup String String)))
(def PAIRS (List (Tup "candy run" "run") (Tup "candy error" "error") (Tup "candy panic" "panic")))

;; The kind of example the block `info` starts, or "" if it starts none.
(sig pair-kind (Fn (String) String))
(defn pair-kind (info)
  (with-default "" (find (fn (k) (!= k "")) (map (fn (p) (let (((i k) p)) (if (= i info) k ""))) PAIRS))))

;; The examples of the spec file `name`, whose text is `text`. Blocks that don't pair up
;; are an error, at `name:line`.
(sig examples (Fn (String String) (List Example)))
(defn examples (text name)
  (let ((all (blocks text))
        ((found pending) (fold (fn (acc b) (example-step acc b name)) (Tup NO_EXAMPLES NO_BLOCK) all)))
    (match pending
      ((Some p) (fail (format "{name}:{(get p line)}: {(get p info)} at the end, with no expect")))
      ((None) found))))

;; No examples, and no block: typed starts for examples' fold, which mypy would type by
;; their shape ([[B184]]).
(sig NO_EXAMPLES (List Example))
(def NO_EXAMPLES empty-list)
(sig NO_BLOCK (Maybe Block))
(def NO_BLOCK None)

;; The examples so far and the block waiting for its expect, after the block `b`.
(sig example-step (Fn ((Tup (List Example) (Maybe Block)) Block String) (Tup (List Example) (Maybe Block))))
(defn example-step (acc b name)
  (let (((found pending) acc)
        (info (get b info)))
    (match pending
      ((Some p)
        (let ((kind (pair-kind (get p info)))
              (want (if (= kind "run") "expect" (++ "expect-" kind))))
          (if (!= info want)
            (fail (format "{name}:{(get p line)}: {(get p info)} needs {want} after it"))
            (let ((expected (if (= kind "run") (get b text) (string.trim (get b text)))))
              (Tup (++ found (List (Example kind (get p text) expected (get p line)))) None)))))
      ((None)
        (cond
          ((!= (pair-kind info) "") (Tup found (Some b)))
          ((contains info (List "expect" "expect-error" "expect-panic"))
            (fail (format "{name}:{(get b line)}: {info} with no example before it")))
          ((= info "candy errors") (Tup (++ found (error-table b name)) None))
          (else (Tup found None)))))))

;; The examples of a `candy errors` block, one per line that isn't blank, each after the
;; block's setup (the lines before a `---` line, if it has one). The setup is an example
;; of its own too, which must translate.
(sig error-table (Fn (Block String) (List Example)))
(defn error-table (b name)
  (let ((rows (string.lines (get b text)))
        (seps (filter (fn (i) (= (string.trim (at rows i)) "---")) (range 0 (len rows))))
        (line (get b line)))
    (if (> (len seps) 1)
      (fail (format "{name}:{(+ line (at seps 1) 1)}: a second --- (a table has one setup)"))
      (let ((first (if (= (len seps) 0) 0 (+ (at seps 0) 1)))
            (setup (string.join (map (fn (r) (++ r "\n")) (take (- first 1) rows)) ""))
            (head (if (= setup "") NO_EXAMPLES (List (Example "setup" setup "" (+ line 1))))))
        (++ head
            (concat
              (map
                (fn (offset) (table-row (at rows (- offset 1)) setup (+ line offset) name))
                (range (+ first 1) (+ (len rows) 1)))))))))

;; The example of the table row `row`, at `line`, after `setup`: none for a blank row.
(sig table-row (Fn (String String Int String) (List Example)))
(defn table-row (row setup line name)
  (cond
    ((= (string.trim row) "") NO_EXAMPLES)
    ((not (string.contains " => " row)) (fail (format "{name}:{line}: expected source => message")))
    (else
      (let ((parts (string.split row " => "))
            (source (at parts 0))
            (message (string.join (rest parts) " => ")))
        (List (Example "error" (++ setup (string.trim source)) (string.trim message) line))))))
