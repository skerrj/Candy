;;; System: the built-ins, declared (doc/hl_rqmt/system_prelude.md). Each bodiless sig
;;; gives a built-in its Candy type; the target's runtime provides it, and src/cdy_rt/spelling.py
;;; says how Python spells it. The translator checks the two against each other, and a
;;; built-in's arity is its type's. Only here may a sig have no definition. Each bodiless
;;; deft declares a built-in type, whose type variables say how many arguments it takes
;;; (doc/hl_rqmt/name_checks.md); `Fn` and `Tup` aren't here, since they take any number of
;;; type arguments.
;;;
;;; Not here: the special forms, which special.cdy declares. `Any` marks a type Candy can't write yet: built-ins
;;; that take any number of arguments, or work on lists, strings and maps alike (Collection,
;;; later), or return Python objects with no Candy type. Each is a leak (backlog [[B48]],
;;; [[B34]], [[B49]]).
;;; This file is read as it is, so it can't use macros.

;; --- types ---
(deft Int)
(deft Long)
(deft Byte)
(deft Float)
(deft Double)
(deft Bool)
(deft Char)
(deft String)
(deft Unit)
(deft Any)
(deft (List a))
(deft (Map k v))

;; --- the operators (spec/25-checking.md, checking.constraints) ---
;; Typed as any function, with constraint variables and rest parameters; spelling.py
;; spells them infix: arithmetic folds left, comparisons chain, and `and` and `or`
;; short-circuit (lower.cdy). `+` adds numbers, `++` appends strings or lists.
(sig + (Fn (number number (Rest number)) number))
(sig ++ (Fn (appendable appendable (Rest appendable)) appendable))
(sig - (Fn (number number (Rest number)) number))
(sig * (Fn (number number (Rest number)) number))
(sig / (Fn (float float (Rest float)) float))
(sig quot (Fn (integer integer (Rest integer)) integer))
(sig mod (Fn (integer integer (Rest integer)) integer))
(sig = (Fn (a a (Rest a)) Bool))
(sig != (Fn (a a (Rest a)) Bool))
(sig < (Fn (comparable comparable (Rest comparable)) Bool))
(sig > (Fn (comparable comparable (Rest comparable)) Bool))
(sig <= (Fn (comparable comparable (Rest comparable)) Bool))
(sig >= (Fn (comparable comparable (Rest comparable)) Bool))
(sig and (Fn (Bool Bool (Rest Bool)) Bool))
(sig or (Fn (Bool Bool (Rest Bool)) Bool))
(sig not (Fn (Bool) Bool))

;; --- math ---
(sig PI Double)
(sig sin (Fn (Double) Double))
(sig cos (Fn (Double) Double))
(sig tan (Fn (Double) Double))

;; --- values ---
(sig nil Unit)

;; --- output (`put`, any number of values, is the prelude's macro over these) ---
(sig put-line (Fn (String) Unit))
;; A value as `put` writes it: as `show`, but a `String` or a `Char` as its text.
(sig text (Fn (a) String))
;; A value as an expression that evaluates to it, by its type (spec/60-library.md,
;; library.show); emit writes the type for the runtime.
(sig show (Fn (a) String))

;; --- files ---
(sig put-err (Fn (String) Unit))
(sig file-put-lines (Fn (String (List String)) Unit))
(sig slurp (Fn (String) String))
(sig spit (Fn (String String) Unit))
(sig file-exists (Fn (String) Bool))
(sig make-dirs (Fn (String) Unit))
(sig path-stem (Fn (String) String))
(sig path-dir (Fn (String) String))
(sig path-join (Fn (String String) String))
(sig path-resolve (Fn (String) String))

;; --- regular expressions (Python's match and pattern objects) ---
(sig re-search (Fn (String String) Any))
(sig re-findall (Fn (String String) (List Any)))
(sig re-compile (Fn (String) Any))

;; --- lists (a string's own operations are below; a tuple is taken apart by a pattern) ---
(sig len (Fn ((List a)) Int))
(sig empty-list (List a))
(sig at (Fn ((List a) Int) a))
(sig slice (Fn ((List a) Int Int) (List a)))
(sig join (Fn ((List String) String) String))
(sig is-coll (Fn (Any) Bool))
(sig to-list (Fn (a) (List a)))
;; Writable in Candy, but built in for speed: Candy adds to a list by copying it.
(sig map (Fn ((Fn (a) b) (List a)) (List b)))
(sig filter (Fn ((Fn (a) Bool) (List a)) (List a)))
(sig fold (Fn ((Fn (b a) b) b (List a)) b))
;; A map threading a state: `f` takes the state and an item, and gives the next state and
;; the item's result; the last state and the results.
(sig map-acc (Fn ((Fn (s a) (Tup s b)) s (List a)) (Tup s (List b))))
;; The library's list operations (doc/hl_rqmt/library.md): built-ins, since a list is the
;; host's. Like map and filter, they take the list last.
(sig any (Fn ((Fn (a) Bool) (List a)) Bool))
(sig all (Fn ((Fn (a) Bool) (List a)) Bool))
;; The index of the first item `keep` is true of, or -1: the prelude's `find` is built on it.
(sig find-index (Fn ((Fn (a) Bool) (List a)) Int))
(sig reverse (Fn ((List a)) (List a)))
(sig range (Fn (Int Int) (List Int)))
(sig take (Fn (Int (List a)) (List a)))
(sig drop (Fn (Int (List a)) (List a)))
(sig concat (Fn ((List (List a))) (List a)))
(sig zip (Fn ((List a) (List b)) (List (Tup a b))))
;; The index of the first item equal to `x`, or -1: the prelude's `index-of` is built on it.
(sig elem-index (Fn (a (List a)) Int))
(sig contains (Fn (a (List a)) Bool))

;; --- maps ---
(sig empty-map (Map k v))
(sig map-get (Fn ((Map k v) k) v))
(sig map-has (Fn ((Map k v) k) Bool))
(sig map-set (Fn ((Map k v) k v) (Map k v)))
(sig map-keys (Fn ((Map k v)) (List k)))
(sig map-from (Fn ((List (Tup k v))) (Map k v)))
(sig map-size (Fn ((Map k v)) Int))

;; --- strings ---
(sig str-len (Fn (String) Int))
(sig char-at (Fn (String Int) Char))
(sig substring (Fn (String Int Int) String))
;; Whether `part` is in `s`: (str-contains part s), as `contains` takes the list last.
(sig str-contains (Fn (String String) Bool))
(sig is-empty-str (Fn (String) Bool))
(sig to-int (Fn (String) Int))
(sig to-float (Fn (String) Double))
(sig is-decimal (Fn (String) Bool))
(sig hex-char (Fn (String) String))
(sig char-code (Fn (String) Int))
(sig starts-with (Fn (String String) Bool))
(sig ends-with (Fn (String String) Bool))
(sig split (Fn (String String) (List String)))
(sig repeat (Fn (String Int) String))
(sig is-str (Fn (Any) Bool))
(sig is-digit (Fn (String) Bool))
(sig is-alpha (Fn (String) Bool))
(sig is-neg-int (Fn (String Int) Bool))
(sig strip (Fn (String String) String))
(sig replace (Fn (String String String) String))
(sig isspace-at (Fn (String Int) Bool))
(sig isspace (Fn (String) Bool))

;; --- the spellings, for the translator (each built-in's Python text and kind, and an
;; operator's function as a value) ---
(sig py-spellings (Map String (Tup String String String)))

;; --- macros, for the translator (the macros are Python functions on Forms) ---
(sig load-macros (Fn (String Any (Map String Bool)) (Map String Any)))
(sig call-macro (Fn (Any (List Any) String) Any))
(sig module-dir (Fn (Any) String))
(sig fresh-name (Fn (String) String))

;; --- the program ---
(sig SYS_ARGS (List String))
(sig fail (Fn (String) a))
