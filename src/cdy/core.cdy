;;; Core: analyse forms into the Core AST (the first step; target-independent).
;;; Mirrors py_cdy/core_cdy.py. Slices 1a-1c: literals, symbols, calls, if, cond, do,
;;; let (desugared into applied Lambdas, as in Scheme), fn, tup, format, get, assoc,
;;; match, sig, def, defn and deft (records and sums).

;; --- types (from sig) ---

(deft CType
  (TCon ((name String) (args (List CType))))
  (TVar ((name String)))
  (TFn ((params (List CType)) (ret CType))))

;; --- expressions ---

;; Temp is made by lower only. After lower, an If or a Lambda still inside an expression
;; is a conditional expression or a lambda.
(deft Expr
  (Lit ((form Form)))
  (Local ((name String) (id Int)))
  (Global ((name String)))
  (Prim ((name String)))
  (Call ((callee Expr) (args (List Expr))))
  (If ((test Expr) (then Expr) (other Expr)))
  (Do ((body (List Expr))))
  (Lambda ((params (List Expr)) (body Expr)))
  (Tuple ((items (List Expr))))
  (Fmt ((parts (List FPart))))
  (Field ((obj Expr) (field String)))
  (Assoc ((obj Expr) (fields (List (Tup String Expr)))))
  ;; `default` is the else clause: empty, or one expression.
  (MatchE ((subject Expr) (clauses (List Clause)) (default (List Expr))))
  (Temp ((id Int))))

;; ((Variant a b) body): the (field, Local) pairs it binds (`_` binds nothing).
(deft Clause ((variant String) (binds (List (Tup String Expr))) (body Expr)))

;; A piece of a format string: literal text, or a hole holding an expression.
(deft FPart
  (FText ((text String)))
  (FHole ((expr Expr))))

;; --- top-level forms ---

(deft Variant ((name String) (fields (List (Tup String CType)))))

(deft Top
  (TDeft ((name String) (tvars (List String)) (fields (List (Tup String CType)))))
  (TDeftSum ((name String) (tvars (List String)) (variants (List Variant))))
  (TDef ((name String) (init Expr) (t CType)))
  (TDefn ((name String) (params (List Expr)) (body Expr) (t CType)))
  (TExpr ((expr Expr))))

(sig NIL Expr)
(def NIL (Prim "nil"))

;; What a symbol can refer to: locals, top-level names of this file, and the table. `parse`
;; is the reader (read-forms), which format needs for the forms in its holes.
;; `variants` maps each variant to its sum and field names; `sums` each sum to its variants.
(deft Scope
  ((env (Map String Expr))
   (top (Map String Bool))
   (table Any)
   (parse (Fn (String) (List Form)))
   (variants (Map String VInfo))
   (sums (Map String (List String)))))

(deft VInfo ((sum String) (fields (List String))))

(sig is-variant (Fn (String Scope) Bool))
(defn is-variant (name scope)
  (and (map-has (get scope variants) name) (not (map-has (get scope env) name))))

(sig variant-fields (Fn (String Scope) (List String)))
(defn variant-fields (name scope) (get (map-get (get scope variants) name) fields))

;; --- expressions ---

(sig analyse-expr (Fn (Form Scope Int) (Tup Expr Int)))
(defn analyse-expr (form scope n)
  (match form
    ((Sym name) (tup (resolve name scope) n))
    ((Lst items) (analyse-list items scope n))
    (else (tup (Lit form) n))))

(sig analyse-all (Fn ((List Form) Scope Int (List Expr)) (Tup (List Expr) Int)))
(defn analyse-all (forms scope n acc)
  (if (= (len forms) 0)
    (tup acc n)
    (let (((e n1) (analyse-expr (at forms 0) scope n)))
      (analyse-all (rest-of forms) scope n1 (+ acc (to-list e))))))

(sig resolve (Fn (String Scope) Expr))
(defn resolve (name scope)
  (cond
    ((map-has (get scope env) name) (map-get (get scope env) name))
    ((and (is-variant name scope) (= (len (variant-fields name scope)) 0))
      (Call (Global name) empty-list))
    ((and (map-has (get scope top) name) (map-get (get scope top) name)) (Global name))
    ((table-is-special (get scope table) name)
      (fail (format "{name} is a special form, not a value")))
    ((table-is-op (get scope table) name) (Prim name))
    (else (fail (format "unknown name {name}")))))

(sig is-special-head (Fn (String Scope) Bool))
(defn is-special-head (name scope)
  (and (not (map-has (get scope env) name)) (table-is-special (get scope table) name)))

(sig analyse-list (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn analyse-list (items scope n)
  (if (= (len items) 0)
    (fail "empty form (): use empty-list for an empty list")
    (let ((head (sym-name (at items 0))))
      (if (is-special-head head scope)
        (analyse-special head (rest-of items) scope n)
        (let ((checked (check-variant-call head (- (len items) 1) scope))
              ((callee n1) (analyse-expr (at items 0) scope n))
              ((args n2) (analyse-all (rest-of items) scope n1 empty-list))
              (arity-ok (check-call callee (len args) scope)))
          (tup (Call callee args) n2))))))

;; Fail if a built-in is called with the wrong number of arguments.
(sig check-call (Fn (Expr Int Scope) Bool))
(defn check-call (callee count scope)
  (match callee
    ((Prim name)
      (let ((kind (table-get-kind (get scope table) name))
            (arity (table-get-arity (get scope table) name)))
        (cond
          ((and (in kind (tup "binop" "compare" "boolop")) (< count 2))
            (fail (format "({name} ...) needs at least 2 arguments, got {count}")))
          ((and (!= arity nil) (!= arity count))
            (fail (format "({name} ...) takes {arity} argument(s), got {count}")))
          (else true))))
    (else true)))

;; Fail if `name` is a variant called with the wrong number of fields.
(sig check-variant-call (Fn (String Int Scope) Bool))
(defn check-variant-call (name count scope)
  (cond
    ((not (is-variant name scope)) true)
    ((= (len (variant-fields name scope)) 0)
      (fail (format "{name} has no fields, so it is a value: write {name}, not ({name})")))
    ((!= count (len (variant-fields name scope)))
      (fail (format "({name} ...) takes {(len (variant-fields name scope))} field(s), got {count}")))
    (else true)))

(sig analyse-special (Fn (String (List Form) Scope Int) (Tup Expr Int)))
(defn analyse-special (head rest scope n)
  (cond
    ((= head "if") (an-if rest scope n))
    ((= head "cond") (an-cond rest scope n))
    ((= head "do") (an-do rest scope n))
    ((= head "let") (an-let rest scope n))
    ((= head "fn") (an-fn rest scope n))
    ((= head "tup") (an-tup rest scope n))
    ((= head "format") (an-format rest scope n))
    ((= head "get") (an-get rest scope n))
    ((= head "assoc") (an-assoc rest scope n))
    ((= head "match") (an-match rest scope n))
    ((in head (tup "def" "defn" "deft" "sig" "import"))
      (fail (format "{head} is only allowed at top level")))
    (else (fail (format "{head} is not supported by the Candy translator yet")))))

(sig an-if (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-if (rest scope n)
  (let (((parts n1) (analyse-all rest scope n empty-list)))
    (cond
      ((= (len parts) 2) (tup (If (at parts 0) (at parts 1) NIL) n1))
      ((= (len parts) 3) (tup (If (at parts 0) (at parts 1) (at parts 2)) n1))
      (else (fail "if: expected (if test then else?)")))))

(sig is-else (Fn (Form) Bool))
(defn is-else (form) (= (sym-name form) "else"))

(sig an-cond (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-cond (clauses scope n)
  (if (= (len clauses) 0)
    (fail "cond: needs at least one (test expr) clause")
    (cond-clauses clauses scope n)))

;; The clauses as nested Ifs, from the first; no clause left is nil.
(sig cond-clauses (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn cond-clauses (clauses scope n)
  (if (= (len clauses) 0)
    (tup NIL n)
    (let ((items (list-items (at clauses 0))))
      (cond
        ((!= (len items) 2) (fail "cond: clause must be (test expr)"))
        ((is-else (at items 0))
          (if (= (len clauses) 1)
            (analyse-expr (at items 1) scope n)
            (fail "cond: (else expr) must be the last clause")))
        (else
          (let (((test n1) (analyse-expr (at items 0) scope n))
                ((expr n2) (analyse-expr (at items 1) scope n1))
                ((other n3) (cond-clauses (rest-of clauses) scope n2)))
            (tup (If test expr other) n3)))))))

(sig an-do (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-do (rest scope n)
  (let (((body n1) (analyse-all rest scope n empty-list)))
    (cond
      ((= (len body) 0) (tup NIL n1))
      ((= (len body) 1) (tup (at body 0) n1))
      (else (tup (Do body) n1)))))

;; (let ((name init)*) body): sequential bindings, as nested applied Lambdas.
(sig an-let (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-let (rest scope n)
  (cond
    ((or (!= (len rest) 2) (not (is-list-form (at rest 0))))
      (fail "let: expected (let ((name init)*) body)"))
    ((= (len (list-items (at rest 0))) 0) (analyse-expr (at rest 1) scope n))
    (else
    (let (((pairs inner n1) (let-bindings (list-items (at rest 0)) scope n empty-list))
          ((body n2) (analyse-expr (at rest 1) inner n1)))
      (tup (nest pairs body) n2)))))

(sig is-list-form (Fn (Form) Bool))
(defn is-list-form (form)
  (match form
    ((Lst _) true)
    (else false)))

;; Each binding's Local and init, in order, and the scope after them all.
(sig let-bindings
  (Fn ((List Form) Scope Int (List (Tup Expr Expr))) (Tup (List (Tup Expr Expr)) Scope Int)))
(defn let-bindings (bindings scope n acc)
  (if (= (len bindings) 0)
    (tup acc scope n)
    (let ((items (list-items (at bindings 0))))
      (if (!= (len items) 2)
        (fail "let: binding must be (name init)")
        (let (((init n1) (analyse-expr (at items 1) scope n))
              (target (at items 0)))
          (match target
            ((Lst names)
              (let ((tmp (Local "_tup" n1))
                    ((more inner n2) (destructure names tmp 0 scope (+ n1 1) empty-list)))
                (let-bindings (rest-of bindings) inner n2 (+ acc (to-list (tup tmp init)) more))))
            (else
              (let ((name (sym-name target))
                    (loc (Local name n1)))
                (if (or (= name "") (table-is-special (get scope table) name))
                  (fail "let name must be a name, not a special form")
                  (let-bindings
                    (rest-of bindings)
                    (assoc scope env (map-set (get scope env) name loc))
                    (+ n1 1)
                    (+ acc (to-list (tup loc init)))))))))))))

;; ((x y) e): one binding per name, (at tmp i).
(sig destructure
  (Fn ((List Form) Expr Int Scope Int (List (Tup Expr Expr))) (Tup (List (Tup Expr Expr)) Scope Int)))
(defn destructure (names tmp i scope n acc)
  (if (= (len names) 0)
    (tup acc scope n)
    (let ((name (sym-name (at names 0)))
          (loc (Local name n))
          (item (Call (Prim "at") (tup tmp (Lit (IntLit i))))))
      (if (= name "")
        (fail "let name must be a name")
        (destructure
          (rest-of names)
          tmp
          (+ i 1)
          (assoc scope env (map-set (get scope env) name loc))
          (+ n 1)
          (+ acc (to-list (tup loc item))))))))

;; ((fn (a) ((fn (b) body) e2)) e1)
(sig nest (Fn ((List (Tup Expr Expr)) Expr) Expr))
(defn nest (pairs body)
  (if (= (len pairs) 0)
    body
    (let (((loc init) (at pairs 0)))
      (Call (Lambda (to-list loc) (nest (slice pairs 1 (len pairs)) body)) (to-list init)))))

(sig an-fn (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-fn (rest scope n)
  (if (!= (len rest) 2)
    (fail "fn: expected (fn (args+) body), with exactly one body form")
    (let (((params inner n1) (bind-params (list-items (at rest 0)) scope n empty-list))
          ((body n2) (analyse-expr (at rest 1) inner n1)))
      (if (= (len params) 0)
        (fail "fn arguments: at least one is needed")
        (tup (Lambda params body) n2)))))

(sig an-tup (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-tup (rest scope n)
  (if (= (len rest) 0)
    (fail "tup: needs at least one item")
    (let (((items n1) (analyse-all rest scope n empty-list)))
      (tup (Tuple items) n1))))

(sig an-get (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-get (rest scope n)
  (if (or (!= (len rest) 2) (= (sym-name (at rest 1)) ""))
    (fail "get: expected (get obj field)")
    (let (((obj n1) (analyse-expr (at rest 0) scope n)))
      (tup (Field obj (sym-name (at rest 1))) n1))))

(sig an-assoc (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-assoc (rest scope n)
  (if (< (len rest) 3)
    (fail "assoc: expected (assoc obj field value ...)")
    (let (((obj n1) (analyse-expr (at rest 0) scope n))
          ((fields n2) (assoc-fields (rest-of rest) scope n1 empty-list)))
      (tup (Assoc obj fields) n2))))

(sig assoc-fields
  (Fn ((List Form) Scope Int (List (Tup String Expr))) (Tup (List (Tup String Expr)) Int)))
(defn assoc-fields (forms scope n acc)
  (cond
    ((= (len forms) 0) (tup acc n))
    ((= (len forms) 1) (fail "assoc: expected (assoc obj field value ...)"))
    (else
    (let ((field (sym-name (at forms 0)))
          ((val n1) (analyse-expr (at forms 1) scope n)))
      (if (= field "")
        (fail "assoc field must be a name")
        (assoc-fields (slice forms 2 (len forms)) scope n1 (+ acc (to-list (tup field val)))))))))

;; (format "text {form} ..."): {{ and }} are literal braces.
(sig an-format (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-format (rest scope n)
  (if (!= (len rest) 1)
    (fail "format: expected one string literal")
    (match (at rest 0)
      ((Txt text)
        (let (((parts n1) (format-parts text 0 "" scope n empty-list)))
          (tup (Fmt parts) n1)))
      (else (fail "format: expected one string literal")))))

;; The parts of a format string from `pos`; `acc` is the literal text so far.
(sig format-parts (Fn (String Int String Scope Int (List FPart)) (Tup (List FPart) Int)))
(defn format-parts (text pos acc scope n parts)
  (let ((c (if (< pos (len text)) (slice text pos (+ pos 1)) ""))
        (next (if (< (+ pos 1) (len text)) (slice text (+ pos 1) (+ pos 2)) "")))
    (cond
      ((= c "") (tup (add-text parts acc) n))
      ((and (= c "{") (= next "{")) (format-parts text (+ pos 2) (+ acc "{") scope n parts))
      ((and (= c "}") (= next "}")) (format-parts text (+ pos 2) (+ acc "}") scope n parts))
      ((= c "}") (fail "format: unmatched } (write }} for a brace)"))
      ((= c "{")
        (let ((end (hole-end text (+ pos 1)))
              (forms ((get scope parse) (slice text (+ pos 1) end))))
          (if (!= (len forms) 1)
            (fail "format: a {hole} must hold exactly one form")
            (let (((e n1) (analyse-expr (at forms 0) scope n)))
              (format-parts text (+ end 1) "" scope n1 (+ (add-text parts acc) (to-list (FHole e))))))))
      (else (format-parts text (+ pos 1) (+ acc c) scope n parts)))))

;; Where the hole starting at `pos` ends (its closing brace).
(sig hole-end (Fn (String Int) Int))
(defn hole-end (text pos)
  (cond
    ((>= pos (len text)) (fail "format: unmatched { (write {{ for a brace)"))
    ((= (slice text pos (+ pos 1)) "}") pos)
    ((= (slice text pos (+ pos 1)) "{") (fail "format: a {hole} can't hold a brace"))
    (else (hole-end text (+ pos 1)))))

(sig add-text (Fn ((List FPart) String) (List FPart)))
(defn add-text (parts text)
  (if (= text "") parts (+ parts (to-list (FText text)))))

;; (match subject ((Variant name*) expr)+ (else expr)?)
(sig an-match (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-match (rest scope n)
  (if (< (len rest) 2)
    (fail "match: expected (match subject ((Variant name*) expr)+ (else expr)?)")
    (let (((subject n1) (analyse-expr (at rest 0) scope n))
          ((m n2) (match-clauses (rest-of rest) scope n1 (MatchE subject empty-list empty-list) ""))
          (sum (if (> (len (match-clause-list m)) 0) (match-sum (match-clause-list m) scope) "")))
      (tup (check-exhaustive m sum scope) n2))))

;; The sum that a clause list takes apart (all its clauses are of one sum, checked before).
(sig match-sum (Fn ((List Clause) Scope) String))
(defn match-sum (clauses scope) (get (map-get (get scope variants) (get (at clauses 0) variant)) sum))

(sig check-exhaustive (Fn (Expr String Scope) Expr))
(defn check-exhaustive (m sum scope)
  (match m
    ((MatchE _ clauses default)
      (let ((missing (missing-variants (map-get (get scope sums) sum) clauses empty-list)))
        (if (and (= (len default) 0) (> (len missing) 0))
          (fail (format "match on {sum}: no clause for {(join missing \", \")} (or add else)"))
          m)))
    (else m)))

(sig missing-variants (Fn ((List String) (List Clause) (List String)) (List String)))
(defn missing-variants (names clauses acc)
  (if (= (len names) 0)
    acc
    (missing-variants
      (slice names 1 (len names))
      clauses
      (if (has-clause (at names 0) clauses) acc (+ acc (to-list (at names 0)))))))

(sig has-clause (Fn (String (List Clause)) Bool))
(defn has-clause (name clauses)
  (cond
    ((= (len clauses) 0) false)
    ((= (get (at clauses 0) variant) name) true)
    (else (has-clause name (slice clauses 1 (len clauses))))))

;; The clauses, added to `m` (a MatchE) one by one; `sum` is the sum seen so far.
(sig match-clauses (Fn ((List Form) Scope Int Expr String) (Tup Expr Int)))
(defn match-clauses (forms scope n m sum)
  (if (= (len forms) 0)
    (tup m n)
    (let ((items (list-items (at forms 0))))
      (cond
        ((!= (len items) 2) (fail "match: clause must be (pattern expr)"))
        ((is-else (at items 0))
          (if (or (> (len forms) 1) (= (len (match-clause-list m)) 0))
            (fail "match: (else expr) must be the last clause, after a pattern")
            (let (((e n1) (analyse-expr (at items 1) scope n)))
              (tup (set-default m e) n1))))
        (else
          (let ((pattern (list-items (at items 0)))
                (variant (if (> (len pattern) 0) (sym-name (at pattern 0)) ""))
                (checked (check-pattern variant pattern sum m scope))
                ((binds inner n1) (pattern-binds (variant-fields variant scope) (rest-of pattern) scope n empty-list))
                ((body n2) (analyse-expr (at items 1) inner n1)))
            (match-clauses
              (rest-of forms)
              scope
              n2
              (add-clause m (Clause variant binds body))
              (get (map-get (get scope variants) variant) sum))))))))

(sig check-pattern (Fn (String (List Form) String Expr Scope) Bool))
(defn check-pattern (variant pattern sum m scope)
  (cond
    ((= variant "") (fail "match: pattern must be (Variant name*) or else"))
    ((not (is-variant variant scope)) (fail (format "match: {variant} is not a variant of a sum type")))
    ((has-clause variant (match-clause-list m)) (fail (format "match: more than one clause for {variant}")))
    ((and (!= sum "") (!= sum (get (map-get (get scope variants) variant) sum)))
      (fail (format "match: clauses mix variants of {sum} and {(get (map-get (get scope variants) variant) sum)}")))
    ((!= (- (len pattern) 1) (len (variant-fields variant scope)))
      (fail (format "match: {variant} has {(len (variant-fields variant scope))} field(s), so the pattern needs that many names")))
    (else true)))

(sig match-clause-list (Fn (Expr) (List Clause)))
(defn match-clause-list (m)
  (match m
    ((MatchE _ clauses _) clauses)
    (else empty-list)))

(sig add-clause (Fn (Expr Clause) Expr))
(defn add-clause (m clause)
  (match m
    ((MatchE subject clauses default) (MatchE subject (+ clauses (to-list clause)) default))
    (else m)))

(sig set-default (Fn (Expr Expr) Expr))
(defn set-default (m e)
  (match m
    ((MatchE subject clauses _) (MatchE subject clauses (to-list e)))
    (else m)))

;; The (field, Local) pairs a pattern's names bind, and the scope with them.
(sig pattern-binds
  (Fn ((List String) (List Form) Scope Int (List (Tup String Expr))) (Tup (List (Tup String Expr)) Scope Int)))
(defn pattern-binds (fields names scope n acc)
  (if (= (len names) 0)
    (tup acc scope n)
    (let ((name (sym-name (at names 0)))
          (loc (Local name n)))
      (cond
        ((= name "") (fail "match name must be a name"))
        ((= name "_") (pattern-binds (slice fields 1 (len fields)) (rest-of names) scope n acc))
        ((bound-in name acc) (fail "match: names in a pattern must be different"))
        (else
          (pattern-binds
            (slice fields 1 (len fields))
            (rest-of names)
            (assoc scope env (map-set (get scope env) name loc))
            (+ n 1)
            (+ acc (to-list (tup (at fields 0) loc)))))))))

(sig bound-in (Fn (String (List (Tup String Expr))) Bool))
(defn bound-in (name binds)
  (if (= (len binds) 0)
    false
    (let (((_ loc) (at binds 0)))
      (match loc
        ((Local other _) (or (= other name) (bound-in name (slice binds 1 (len binds)))))
        (else (bound-in name (slice binds 1 (len binds))))))))

;; --- types ---

(sig is-lower (Fn (String) Bool))
(defn is-lower (name)
  (and (> (len name) 0) (>= (slice name 0 1) "a") (<= (slice name 0 1) "z")))

(sig analyse-type (Fn (Form) CType))
(defn analyse-type (form)
  (match form
    ((Sym name) (if (is-lower name) (TVar name) (TCon name empty-list)))
    ((Lst items)
      (cond
        ((= (len items) 0) (fail "bad type ()"))
        ((= (sym-name (at items 0)) "Fn")
          (if (= (len items) 3)
            (TFn (analyse-types (list-items (at items 1)) empty-list) (analyse-type (at items 2)))
            (fail "bad function type: expected (Fn (Arg+) Ret)")))
        (else (TCon (sym-name (at items 0)) (analyse-types (rest-of items) empty-list)))))
    (else (fail "bad type"))))

(sig analyse-types (Fn ((List Form) (List CType)) (List CType)))
(defn analyse-types (forms acc)
  (if (= (len forms) 0)
    acc
    (analyse-types (rest-of forms) (+ acc (to-list (analyse-type (at forms 0)))))))

;; --- top level ---

;; `defs` are the names that need a sig (def and defn); `defined` those defined so far.
(deft Prog
  ((out (List Top))
   (sigs (Map String CType))
   (n Int)
   (defs (Map String Bool))
   (defined (Map String Bool))))

;; The names that def and defn define, so that any form can refer to them.
(sig top-names (Fn ((List Form) (Map String Bool)) (Map String Bool)))
(defn top-names (forms acc)
  (if (= (len forms) 0)
    acc
    (let ((items (list-items (at forms 0)))
          (head (if (> (len items) 1) (sym-name (at items 0)) "")))
      (top-names
        (rest-of forms)
        (cond
          ((or (= head "def") (= head "defn")) (add-name (sym-name (at items 1)) acc))
          ((and (= head "deft") (is-sum-body (slice items 2 (len items))))
            ;; A sum's own name is a type, but in Python it is a name like the others.
            (add-names
              (variant-names (slice items 2 (len items)) empty-list)
              (map-set (add-name (deft-name (at items 1)) acc) (deft-name (at items 1)) false)))
          ((= head "deft") (add-name (deft-name (at items 1)) acc))
          (else acc))))))

;; Top-level names map to true for values, false for a sum's type name.
(sig add-name (Fn (String (Map String Bool)) (Map String Bool)))
(defn add-name (name acc)
  (if (map-has acc name)
    (fail (format "defined more than once: {name}"))
    (map-set acc name true)))

(sig add-names (Fn ((List String) (Map String Bool)) (Map String Bool)))
(defn add-names (names acc)
  (if (= (len names) 0)
    acc
    (add-names (slice names 1 (len names)) (add-name (at names 0) acc))))

;; Whether a deft body (what follows the name) lists variants, not one field list: each
;; variant starts with a symbol, (Circle ...) or (Leaf); a field list starts with a list.
(sig is-sum-body (Fn ((List Form)) Bool))
(defn is-sum-body (body)
  (and (> (len body) 0) (all-variant-forms body)))

(sig all-variant-forms (Fn ((List Form)) Bool))
(defn all-variant-forms (body)
  (cond
    ((= (len body) 0) true)
    ((= (sym-name (first-item (at body 0))) "") false)
    (else (all-variant-forms (rest-of body)))))

(sig first-item (Fn (Form) Form))
(defn first-item (form)
  (let ((items (list-items form)))
    (if (= (len items) 0) (Lst empty-list) (at items 0))))

(sig variant-names (Fn ((List Form) (List String)) (List String)))
(defn variant-names (body acc)
  (if (= (len body) 0)
    acc
    (variant-names (rest-of body) (+ acc (to-list (sym-name (first-item (at body 0))))))))

;; Each variant's sum and field names, and each sum's variants, before analysing them.
(sig find-variants (Fn ((List Form) Scope) Scope))
(defn find-variants (forms scope)
  (if (= (len forms) 0)
    scope
    (let ((items (list-items (at forms 0)))
          (head (if (> (len items) 2) (sym-name (at items 0)) ""))
          (body (slice items 2 (len items))))
      (find-variants
        (rest-of forms)
        (if (and (= head "deft") (is-sum-body body))
          (let ((sum (deft-name (at items 1))))
            (add-variants
              sum
              body
              (assoc scope sums (map-set (get scope sums) sum (variant-names body empty-list)))))
          scope)))))

(sig add-variants (Fn (String (List Form) Scope) Scope))
(defn add-variants (sum body scope)
  (if (= (len body) 0)
    scope
    (let ((v-items (list-items (at body 0)))
          (name (sym-name (at v-items 0)))
          (fields (if (= (len v-items) 2) (field-names (list-items (at v-items 1)) empty-list) empty-list)))
      (add-variants
        sum
        (rest-of body)
        (assoc scope variants (map-set (get scope variants) name (VInfo sum fields)))))))

(sig field-names (Fn ((List Form) (List String)) (List String)))
(defn field-names (fields acc)
  (if (= (len fields) 0)
    acc
    (field-names (rest-of fields) (+ acc (to-list (sym-name (first-item (at fields 0))))))))

;; The name in (deft Name ...) or (deft (Name a b) ...).
(sig deft-name (Fn (Form) String))
(defn deft-name (form)
  (match form
    ((Lst items) (if (= (len items) 0) "" (sym-name (at items 0))))
    (else (sym-name form))))

(sig analyse-program (Fn ((List Form) Any (Fn (String) (List Form))) (List Top)))
(defn analyse-program (forms table parse)
  (let ((scope (find-variants forms (Scope empty-map (top-names forms empty-map) table parse empty-map empty-map))))
    (get (analyse-tops forms scope (Prog empty-list empty-map 0 (def-names forms empty-map) empty-map)) out)))

(sig def-names (Fn ((List Form) (Map String Bool)) (Map String Bool)))
(defn def-names (forms acc)
  (if (= (len forms) 0)
    acc
    (let ((items (list-items (at forms 0)))
          (head (if (> (len items) 1) (sym-name (at items 0)) "")))
      (def-names
        (rest-of forms)
        (if (or (= head "def") (= head "defn")) (map-set acc (sym-name (at items 1)) true) acc)))))

(sig analyse-tops (Fn ((List Form) Scope Prog) Prog))
(defn analyse-tops (forms scope prog)
  (if (= (len forms) 0)
    prog
    (analyse-tops (rest-of forms) scope (analyse-top (at forms 0) scope prog))))

(sig add-top (Fn (Prog Top Int) Prog))
(defn add-top (prog top n) (assoc prog out (+ (get prog out) (to-list top)) n n))

(sig mark-defined (Fn (Prog String) Prog))
(defn mark-defined (prog name) (assoc prog defined (map-set (get prog defined) name true)))

(sig analyse-top (Fn (Form Scope Prog) Prog))
(defn analyse-top (form scope prog)
  (let ((items (list-items form))
        (head (if (> (len items) 0) (sym-name (at items 0)) "")))
    (cond
      ((= head "sig") (top-sig items prog))
      ((= head "def") (top-def items scope prog))
      ((= head "defn") (top-defn items scope prog))
      ((= head "deft") (top-deft items prog))
      (else
        (let (((e n) (analyse-expr form scope (get prog n))))
          (add-top prog (TExpr e) n))))))

(sig top-sig (Fn ((List Form) Prog) Prog))
(defn top-sig (items prog)
  (let ((name (if (= (len items) 3) (sym-name (at items 1)) "")))
    (cond
      ((= name "") (fail "sig: expected (sig name Type)"))
      ((not (map-has (get prog defs) name))
        (fail (format "sig for {name}, but no def or defn of {name} in this file")))
      ((map-has (get prog defined) name) (fail (format "sig for {name} comes after its definition")))
      ((map-has (get prog sigs) name) (fail (format "more than one sig for {name}")))
      (else (assoc prog sigs (map-set (get prog sigs) name (analyse-type (at items 2))))))))

;; (deft Name ((field Type)+)) or (deft (Name a b) ((field Type)+)): a record type.
;; A sum, (deft Name variant+), lists its variants instead: (Circle ((r Double))) or (Leaf).
(sig top-deft (Fn ((List Form) Prog) Prog))
(defn top-deft (items prog)
  (let ((name (if (> (len items) 1) (deft-name (at items 1)) ""))
        (tvars (if (> (len items) 1) (syms (rest-of (list-items (at items 1))) empty-list) empty-list))
        (body (slice items 2 (len items)))
        (field-forms (if (= (len items) 3) (list-items (at items 2)) empty-list)))
    (cond
      ((= name "") (fail "deft: expected (deft Name ((field Type)+)) or (deft Name variant+)"))
      ((is-sum-body body)
        (add-top prog (TDeftSum name tvars (deft-variants body empty-list)) (get prog n)))
      ((= (len field-forms) 0) (fail "deft: expected (deft Name ((field Type)+))"))
      (else (add-top prog (TDeft name tvars (deft-fields field-forms empty-list)) (get prog n))))))

(sig deft-variants (Fn ((List Form) (List Variant)) (List Variant)))
(defn deft-variants (body acc)
  (if (= (len body) 0)
    acc
    (let ((v-items (list-items (at body 0)))
          (name (sym-name (at v-items 0))))
      (cond
        ((not (is-upper name)) (fail (format "deft: variant names are Capitalised, not {name}")))
        ((= (len v-items) 1) (deft-variants (rest-of body) (+ acc (to-list (Variant name empty-list)))))
        ((and (= (len v-items) 2) (> (len (list-items (at v-items 1))) 0))
          (deft-variants
            (rest-of body)
            (+ acc (to-list (Variant name (deft-fields (list-items (at v-items 1)) empty-list))))))
        (else (fail "deft: variant must be (Name) or (Name ((field Type)+))"))))))

(sig is-upper (Fn (String) Bool))
(defn is-upper (name)
  (and (> (len name) 0) (>= (slice name 0 1) "A") (<= (slice name 0 1) "Z")))

(sig syms (Fn ((List Form) (List String)) (List String)))
(defn syms (forms acc)
  (if (= (len forms) 0) acc (syms (rest-of forms) (+ acc (to-list (sym-name (at forms 0)))))))

(sig deft-fields (Fn ((List Form) (List (Tup String CType))) (List (Tup String CType))))
(defn deft-fields (forms acc)
  (if (= (len forms) 0)
    acc
    (let ((items (list-items (at forms 0))))
      (if (or (!= (len items) 2) (= (sym-name (at items 0)) ""))
        (fail "deft: field must be (name Type)")
        (deft-fields
          (rest-of forms)
          (+ acc (to-list (tup (sym-name (at items 0)) (analyse-type (at items 1))))))))))

(sig needs-sig (Fn (String Prog) CType))
(defn needs-sig (name prog)
  (if (map-has (get prog sigs) name)
    (map-get (get prog sigs) name)
    (fail (format "{name} needs a (sig {name} Type) before its definition"))))

(sig top-def (Fn ((List Form) Scope Prog) Prog))
(defn top-def (items scope prog)
  (if (!= (len items) 3)
    (fail "def: expected (def name init); the initial value is required")
    (let ((name (sym-name (at items 1)))
          (t (needs-sig name prog))
          ((init n) (analyse-expr (at items 2) scope (get prog n))))
      (mark-defined (add-top prog (TDef name init t) n) name))))

(sig top-defn (Fn ((List Form) Scope Prog) Prog))
(defn top-defn (items scope prog)
  (if (!= (len items) 4)
    (fail "defn: expected (defn name (args+) body), with exactly one body form")
    (let ((name (sym-name (at items 1)))
          (t (needs-sig name prog))
          (arg-forms (list-items (at items 2)))
          ((params inner n1) (bind-params arg-forms scope (get prog n) empty-list))
          ((body n2) (analyse-expr (at items 3) inner n1)))
      (cond
        ((= (len params) 0) (fail (format "defn {name}: at least one argument is needed")))
        ((!= (len params) (fn-arity t))
          (fail (format "defn {name}: its sig must be a function type with one type per argument")))
        (else (mark-defined (add-top prog (TDefn name params body t) n2) name))))))

;; How many arguments a function type takes; -1 if it isn't a function type.
(sig fn-arity (Fn (CType) Int))
(defn fn-arity (t)
  (match t
    ((TFn params _) (len params))
    (else -1)))

;; Fresh Locals for the parameter names, and the scope that includes them.
(sig bind-params (Fn ((List Form) Scope Int (List Expr)) (Tup (List Expr) Scope Int)))
(defn bind-params (forms scope n acc)
  (if (= (len forms) 0)
    (tup acc scope n)
    (let ((name (sym-name (at forms 0)))
          (loc (Local name n)))
      (if (= name "")
        (fail "a parameter must be a name")
        (bind-params
          (rest-of forms)
          (assoc scope env (map-set (get scope env) name loc))
          (+ n 1)
          (+ acc (to-list loc)))))))

;; --- main ---

;; A program may define `main`: it takes the command-line arguments and returns the exit
;; status, and it runs when the program is run (not when its module is imported).
(sig MAIN_TYPE CType)
(def MAIN_TYPE (TFn (to-list (TCon "List" (to-list (TCon "String" empty-list)))) (TCon "Int" empty-list)))

;; Whether the program defines `main`; it must be a defn typed (Fn ((List String)) Int).
(sig has-main (Fn ((List Top)) Bool))
(defn has-main (tops)
  (cond
    ((= (len tops) 0) false)
    ((is-main (at tops 0)) true)
    (else (has-main (slice tops 1 (len tops))))))

(sig is-main (Fn (Top) Bool))
(defn is-main (top)
  (match top
    ((TDefn name _ _ t)
      (cond
        ((!= name "main") false)
        ((= t MAIN_TYPE) true)
        (else (fail "main must be typed (Fn ((List String)) Int)"))))
    ((TDef name _ _) (if (= name "main") (fail "main must be a defn") false))
    (else false)))
