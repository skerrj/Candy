;;; Core: analyse forms into the Core AST (the first step; target-independent).
;;; Mirrored the Python translator's core_cdy.py (at tag self-host-py). Slices 1a-1c: literals, symbols, calls, if, cond, do,
;;; let (desugared into applied Lambdas, as in Scheme), fn, tup, format, get, assoc,
;;; match, sig, def, defn and deft (records and sums).

(import form)

;; --- types (from sig) ---

(deft CType
  (TCon ((name String) (args (List CType))))
  (TVar ((name String)))
  (TFn ((params (List CType)) (ret CType))))

;; --- expressions ---

;; Temp is made by lower only. After lower, an If or a Lambda still inside an expression
;; is a conditional expression or a lambda.
(deft Expr
  (Lit ((form Form)))
  (Local ((name String) (id Int)))
  (Global ((name String)))
  (Prim ((name String)))
  (Call ((callee Expr) (args (List Expr))))
  (If ((test Expr) (then Expr) (other Expr)))
  (Do ((body (List Expr))))
  (Lambda ((params (List Expr)) (body Expr)))
  (Tuple ((items (List Expr))))
  (Fmt ((parts (List FPart))))
  (Field ((obj Expr) (field String)))
  (Assoc ((obj Expr) (fields (List (Tup String Expr)))))
  ;; `default` is the else clause: empty, or one expression.
  (MatchE ((subject Expr) (clauses (List Clause)) (default (List Expr))))
  (Temp ((id Int))))

;; ((Variant a b) body): the (field, Local) pairs it binds (`_` binds nothing).
(deft Clause ((variant String) (binds (List (Tup String Expr))) (body Expr)))

;; A piece of a format string: literal text, or a hole holding an expression.
(deft FPart
  (FText ((text String)))
  (FHole ((expr Expr))))

;; --- top-level forms ---

(deft Variant ((name String) (fields (List (Tup String CType)))))

(deft Top
  (TDeft ((name String) (tvars (List String)) (fields (List (Tup String CType)))))
  (TDeftSum ((name String) (tvars (List String)) (variants (List Variant))))
  (TDef ((name String) (init Expr) (t CType)))
  (TDefn ((name String) (params (List Expr)) (body Expr) (t CType)))
  (TExpr ((expr Expr))))

(sig NIL Expr)
(def NIL (Prim "nil"))

;; What a symbol can refer to: locals, the top-level names this module defines or imports,
;; and the table. `parse` is the reader (read-forms), which format needs for the forms in
;; its holes. `variants` maps each variant to its sum and field names; `sums` each sum to
;; its variants.
(deft Scope
  ((env (Map String Expr))
   (top (Map String Bool))
   (table Any)
   (parse (Fn (String) (List Form)))
   (variants (Map String VInfo))
   (sums (Map String (List String)))
   ;; The innermost form being analysed, for errors (see located).
   (here Pos)
   ;; The program's macros (expand.cdy), whose names can't be bound, and whether this is
   ;; macro code, where quo and quasi are allowed.
   (macros (Map String Macro))
   (quoting Bool)
   ;; Each top-level name's global name (prefixed outside the top module; see Exports),
   ;; and the names other modules define, by module stem, for the error when one isn't
   ;; imported.
   (names (Map String String))
   (elsewhere (Map String String))
   ;; The built-ins' types, from system.cdy (see system-sigs).
   (builtins (Map String CType))))

;; `scope` analysing a form at `pos` (unless that's NOWHERE).
(sig at-pos (Fn (Scope Pos) Scope))
(defn at-pos (scope pos) (if (= (get pos line) 0) scope (assoc scope here pos)))

;; An error message `msg`, starting with where the form being analysed is.
(sig located (Fn (Scope String) String))
(defn located (scope msg) (+ (pos-text (get scope here)) msg))

;; `scope` with `name` bound to `loc`. A macro's name can't be bound: expansion doesn't see
;; local names, so it would still expand a call of it.
(sig bind-local (Fn (Scope String Expr) Scope))
(defn bind-local (scope name loc)
  (if (map-has (get scope macros) name)
    (fail (located scope (format "{name} is a macro, so it can't be bound")))
    (assoc scope env (map-set (get scope env) name loc))))

(deft VInfo ((sum String) (fields (List String))))

(sig is-variant (Fn (String Scope) Bool))
(defn is-variant (name scope)
  (and (map-has (get scope variants) name) (not (map-has (get scope env) name))))

(sig variant-fields (Fn (String Scope) (List String)))
(defn variant-fields (name scope) (get (map-get (get scope variants) name) fields))

;; --- expressions ---

(sig analyse-expr (Fn (Form Scope Int) (Tup Expr Int)))
(defn analyse-expr (form scope n)
  (match form
    ((Sym name pos) (tup (resolve name (at-pos scope pos)) n))
    ((Lst items pos) (analyse-list items (at-pos scope pos) n))
    (else (tup (Lit form) n))))

(sig analyse-all (Fn ((List Form) Scope Int (List Expr)) (Tup (List Expr) Int)))
(defn analyse-all (forms scope n acc)
  (if (= (len forms) 0)
    (tup acc n)
    (let (((e n1) (analyse-expr (at forms 0) scope n)))
      (analyse-all (rest-of forms) scope n1 (+ acc (to-list e))))))

(sig resolve (Fn (String Scope) Expr))
(defn resolve (name scope)
  (cond
    ((map-has (get scope env) name) (map-get (get scope env) name))
    ((and (is-variant name scope) (= (len (variant-fields name scope)) 0))
      (Call (Global (global-name name (get scope names))) empty-list))
    ((and (map-has (get scope top) name) (map-get (get scope top) name))
      (Global (global-name name (get scope names))))
    ((table-is-special (get scope table) name)
      (fail (located scope (format "{name} is a special form, not a value"))))
    ((table-is-op (get scope table) name) (Prim name))
    ((map-has (get scope elsewhere) name)
      (let ((stem (map-get (get scope elsewhere) name)))
        (fail (located scope (format "{name} is not defined here; {stem} defines it, but this file doesn't import {stem}")))))
    (else (fail (located scope (format "unknown name {name}"))))))

;; The global name of the top-level name `name` (itself if `names` doesn't have it).
(sig global-name (Fn (String (Map String String)) String))
(defn global-name (name names) (if (map-has names name) (map-get names name) name))

(sig is-special-head (Fn (String Scope) Bool))
(defn is-special-head (name scope)
  (and (not (map-has (get scope env) name)) (table-is-special (get scope table) name)))

(sig analyse-list (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn analyse-list (items scope n)
  (if (= (len items) 0)
    (fail (located scope "empty form (): use empty-list for an empty list"))
    (let ((head (sym-name (at items 0))))
      (if (is-special-head head scope)
        (analyse-special head (rest-of items) scope n)
        (let ((checked (check-variant-call head (- (len items) 1) scope))
              ((callee n1) (analyse-expr (at items 0) scope n))
              ((args n2) (analyse-all (rest-of items) scope n1 empty-list))
              (arity-ok (check-call callee (len args) scope)))
          (tup (Call callee args) n2))))))

;; Fail if a built-in is called with the wrong number of arguments: an operator's kind
;; says how many it takes, and any other built-in's type (in system.cdy), unless that is
;; Any or not a function.
(sig check-call (Fn (Expr Int Scope) Bool))
(defn check-call (callee count scope)
  (match callee
    ((Prim name)
      (let ((kind (table-get-kind (get scope table) name))
            (arity
              (cond
                ((= kind "unary") 1)
                ((map-has (get scope builtins) name) (fn-arity (map-get (get scope builtins) name)))
                (else -1))))
        (cond
          ((and (in kind (tup "binop" "compare" "boolop")) (< count 2))
            (fail (located scope (format "({name} ...) needs at least 2 arguments, got {count}"))))
          ((and (>= arity 0) (!= arity count))
            (fail (located scope (format "({name} ...) takes {arity} argument(s), got {count}"))))
          (else true))))
    (else true)))

;; Fail if `name` is a variant called with the wrong number of fields.
(sig check-variant-call (Fn (String Int Scope) Bool))
(defn check-variant-call (name count scope)
  (cond
    ((not (is-variant name scope)) true)
    ((= (len (variant-fields name scope)) 0)
      (fail (located scope (format "{name} has no fields, so it is a value: write {name}, not ({name})"))))
    ((!= count (len (variant-fields name scope)))
      (fail (located scope (format "({name} ...) takes {(len (variant-fields name scope))} field(s), got {count}"))))
    (else true)))

(sig analyse-special (Fn (String (List Form) Scope Int) (Tup Expr Int)))
(defn analyse-special (head rest scope n)
  (cond
    ((= head "if") (an-if rest scope n))
    ((= head "do") (an-do rest scope n))
    ((= head "let") (an-let rest scope n))
    ((= head "fn") (an-fn rest scope n))
    ((= head "tup") (an-tup rest scope n))
    ((= head "format") (an-format rest scope n))
    ((= head "get") (an-get rest scope n))
    ((= head "assoc") (an-assoc rest scope n))
    ((= head "match") (an-match rest scope n))
    ((= head "quo") (an-quo rest scope n))
    ((= head "quasi") (an-quasi rest scope n))
    ((in head (tup "unq" "unq-sp")) (fail (located scope (format "{head}: only inside quasi"))))
    ((in head (tup "def" "defn" "deft" "sig" "import" "import-macros" "defmacro"))
      (fail (located scope (format "{head} is only allowed at top level"))))
    (else (fail (located scope (format "{head} is not supported by the Candy translator yet"))))))

(sig an-if (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-if (rest scope n)
  (let (((parts n1) (analyse-all rest scope n empty-list)))
    (cond
      ((= (len parts) 2) (tup (If (at parts 0) (at parts 1) NIL) n1))
      ((= (len parts) 3) (tup (If (at parts 0) (at parts 1) (at parts 2)) n1))
      (else (fail (located scope "if: expected (if test then else?)"))))))

(sig is-else (Fn (Form) Bool))
(defn is-else (form) (= (sym-name form) "else"))

(sig an-do (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-do (rest scope n)
  (let (((body n1) (analyse-all rest scope n empty-list)))
    (cond
      ((= (len body) 0) (tup NIL n1))
      ((= (len body) 1) (tup (at body 0) n1))
      (else (tup (Do body) n1)))))

;; (let ((name init)*) body): sequential bindings, as nested applied Lambdas.
(sig an-let (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-let (rest scope n)
  (cond
    ((or (!= (len rest) 2) (not (is-list-form (at rest 0))))
      (fail (located scope "let: expected (let ((name init)*) body)")))
    ((= (len (list-items (at rest 0))) 0) (analyse-expr (at rest 1) scope n))
    (else
    (let (((pairs inner n1) (let-bindings (list-items (at rest 0)) scope n empty-list))
          ((body n2) (analyse-expr (at rest 1) inner n1)))
      (tup (nest pairs body) n2)))))

(sig is-list-form (Fn (Form) Bool))
(defn is-list-form (form)
  (match form
    ((Lst _ _) true)
    (else false)))

;; Each binding's Local and init, in order, and the scope after them all.
(sig let-bindings
  (Fn ((List Form) Scope Int (List (Tup Expr Expr))) (Tup (List (Tup Expr Expr)) Scope Int)))
(defn let-bindings (bindings scope n acc)
  (if (= (len bindings) 0)
    (tup acc scope n)
    (let ((items (list-items (at bindings 0))))
      (if (!= (len items) 2)
        (fail (located scope "let: binding must be (name init)"))
        (let (((init n1) (analyse-expr (at items 1) scope n))
              (target (at items 0)))
          (match target
            ((Lst names _)
              (let ((tmp (Local "_tup" n1))
                    ((more inner n2) (destructure names tmp 0 scope (+ n1 1) empty-list)))
                (let-bindings (rest-of bindings) inner n2 (+ acc (to-list (tup tmp init)) more))))
            (else
              (let ((name (sym-name target))
                    (loc (Local name n1)))
                (if (or (= name "") (table-is-special (get scope table) name))
                  (fail (located scope "let name must be a name, not a special form"))
                  (let-bindings
                    (rest-of bindings)
                    (bind-local scope name loc)
                    (+ n1 1)
                    (+ acc (to-list (tup loc init)))))))))))))

;; ((x y) e): one binding per name, (at tmp i).
(sig destructure
  (Fn ((List Form) Expr Int Scope Int (List (Tup Expr Expr))) (Tup (List (Tup Expr Expr)) Scope Int)))
(defn destructure (names tmp i scope n acc)
  (if (= (len names) 0)
    (tup acc scope n)
    (let ((name (sym-name (at names 0)))
          (loc (Local name n))
          (item (Call (Prim "at") (tup tmp (Lit (IntLit i))))))
      (if (= name "")
        (fail (located scope "let name must be a name"))
        (destructure
          (rest-of names)
          tmp
          (+ i 1)
          (bind-local scope name loc)
          (+ n 1)
          (+ acc (to-list (tup loc item))))))))

;; ((fn (a) ((fn (b) body) e2)) e1)
(sig nest (Fn ((List (Tup Expr Expr)) Expr) Expr))
(defn nest (pairs body)
  (if (= (len pairs) 0)
    body
    (let (((loc init) (at pairs 0)))
      (Call (Lambda (to-list loc) (nest (slice pairs 1 (len pairs)) body)) (to-list init)))))

(sig an-fn (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-fn (rest scope n)
  (if (!= (len rest) 2)
    (fail (located scope "fn: expected (fn (args+) body), with exactly one body form"))
    (let (((params inner n1) (bind-params (list-items (at rest 0)) scope n empty-list))
          ((body n2) (analyse-expr (at rest 1) inner n1)))
      (if (= (len params) 0)
        (fail (located scope "fn arguments: at least one is needed"))
        (tup (Lambda params body) n2)))))

(sig an-tup (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-tup (rest scope n)
  (if (= (len rest) 0)
    (fail (located scope "tup: needs at least one item"))
    (let (((items n1) (analyse-all rest scope n empty-list)))
      (tup (Tuple items) n1))))

(sig an-get (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-get (rest scope n)
  (if (or (!= (len rest) 2) (= (sym-name (at rest 1)) ""))
    (fail (located scope "get: expected (get obj field)"))
    (let (((obj n1) (analyse-expr (at rest 0) scope n)))
      (tup (Field obj (sym-name (at rest 1))) n1))))

(sig an-assoc (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-assoc (rest scope n)
  (if (< (len rest) 3)
    (fail (located scope "assoc: expected (assoc obj field value ...)"))
    (let (((obj n1) (analyse-expr (at rest 0) scope n))
          ((fields n2) (assoc-fields (rest-of rest) scope n1 empty-list)))
      (tup (Assoc obj fields) n2))))

(sig assoc-fields
  (Fn ((List Form) Scope Int (List (Tup String Expr))) (Tup (List (Tup String Expr)) Int)))
(defn assoc-fields (forms scope n acc)
  (cond
    ((= (len forms) 0) (tup acc n))
    ((= (len forms) 1) (fail (located scope "assoc: expected (assoc obj field value ...)")))
    (else
    (let ((field (sym-name (at forms 0)))
          ((val n1) (analyse-expr (at forms 1) scope n)))
      (if (= field "")
        (fail (located scope "assoc field must be a name"))
        (assoc-fields (slice forms 2 (len forms)) scope n1 (+ acc (to-list (tup field val)))))))))

;; (format "text {form} ..."): {{ and }} are literal braces.
(sig an-format (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-format (rest scope n)
  (if (!= (len rest) 1)
    (fail (located scope "format: expected one string literal"))
    (match (at rest 0)
      ((Txt text)
        (let (((parts n1) (format-parts text 0 "" scope n empty-list)))
          (tup (Fmt parts) n1)))
      (else (fail (located scope "format: expected one string literal"))))))

;; The parts of a format string from `pos`; `acc` is the literal text so far.
(sig format-parts (Fn (String Int String Scope Int (List FPart)) (Tup (List FPart) Int)))
(defn format-parts (text pos acc scope n parts)
  (let ((c (if (< pos (len text)) (slice text pos (+ pos 1)) ""))
        (next (if (< (+ pos 1) (len text)) (slice text (+ pos 1) (+ pos 2)) "")))
    (cond
      ((= c "") (tup (add-text parts acc) n))
      ((and (= c "{") (= next "{")) (format-parts text (+ pos 2) (+ acc "{") scope n parts))
      ((and (= c "}") (= next "}")) (format-parts text (+ pos 2) (+ acc "}") scope n parts))
      ((= c "}") (fail (located scope "format: unmatched } (write }} for a brace)")))
      ((= c "{")
        (let ((end (hole-end text (+ pos 1)))
              (forms ((get scope parse) (slice text (+ pos 1) end))))
          (if (!= (len forms) 1)
            (fail (located scope "format: a {hole} must hold exactly one form"))
            (let (((e n1) (analyse-expr (at forms 0) scope n)))
              (format-parts text (+ end 1) "" scope n1 (+ (add-text parts acc) (to-list (FHole e))))))))
      (else (format-parts text (+ pos 1) (+ acc c) scope n parts)))))

;; Where the hole starting at `pos` ends (its closing brace).
(sig hole-end (Fn (String Int) Int))
(defn hole-end (text pos)
  (cond
    ((>= pos (len text)) (fail "format: unmatched { (write {{ for a brace)"))
    ((= (slice text pos (+ pos 1)) "}") pos)
    ((= (slice text pos (+ pos 1)) "{") (fail "format: a {hole} can't hold a brace"))
    (else (hole-end text (+ pos 1)))))

(sig add-text (Fn ((List FPart) String) (List FPart)))
(defn add-text (parts text)
  (if (= text "") parts (+ parts (to-list (FText text)))))

;; (match subject ((Variant name*) expr)+ (else expr)?)
(sig an-match (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-match (rest scope n)
  (cond
    ((< (len rest) 2)
      (fail (located scope "match: expected (match subject ((Variant name*) expr)+ (else expr)?)")))
    ((is-tup-clause (at rest 1)) (an-match-tup rest scope n))
    (else (an-match-sum rest scope n))))

(sig an-match-sum (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-match-sum (rest scope n)
  (let (((subject n1) (analyse-expr (at rest 0) scope n))
          ((m n2) (match-clauses (rest-of rest) scope n1 (MatchE subject empty-list empty-list) ""))
          (sum (if (> (len (match-clause-list m)) 0) (match-sum (match-clause-list m) scope) "")))
      (tup (global-clauses (check-exhaustive m sum scope) (get scope names)) n2)))

;; `m` (a MatchE) with its clauses' variants by their global names.
(sig global-clauses (Fn (Expr (Map String String)) Expr))
(defn global-clauses (m names)
  (match m
    ((MatchE subject clauses default) (MatchE subject (rename-clauses clauses names empty-list) default))
    (else m)))

(sig rename-clauses (Fn ((List Clause) (Map String String) (List Clause)) (List Clause)))
(defn rename-clauses (clauses names acc)
  (if (= (len clauses) 0)
    acc
    (let ((c (at clauses 0)))
      (rename-clauses
        (slice clauses 1 (len clauses))
        names
        (+ acc (to-list (assoc c variant (global-name (get c variant) names))))))))

;; Whether a clause's pattern is (tup ...).
(sig is-tup-clause (Fn (Form) Bool))
(defn is-tup-clause (clause) (= (sym-name (first-item (first-item clause))) "tup"))

;; (match e ((tup a b) body)): a tuple has one shape, so its pattern is the only clause.
;; Like a let binding ((a b) e), it binds a Temp-like Local to e and each name to an item
;; (`_` binds nothing): ((fn (t) ((fn (a) ((fn (b) body) (at t 1))) (at t 0))) e).
(sig an-match-tup (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-match-tup (rest scope n)
  (let ((items (list-items (at rest 1)))
        (names (rest-of (list-items (at items 0)))))
    (cond
      ((or (!= (len rest) 2) (!= (len items) 2))
        (fail (located scope "match: a (tup name+) pattern must be the only clause, with no else")))
      ((= (len names) 0) (fail (located scope "match: a (tup name+) pattern needs at least one name")))
      (else
        (let (((subject n1) (analyse-expr (at rest 0) scope n))
              (tmp (Local "_tup" n1))
              ((pairs inner n2) (tup-binds names tmp 0 scope (+ n1 1) empty-list))
              ((body n3) (analyse-expr (at items 1) inner n2)))
          (tup (nest (+ (to-list (tup tmp subject)) pairs) body) n3))))))

;; The (Local, (at tmp i)) pairs of a tup pattern's names, and the scope with them.
(sig tup-binds
  (Fn ((List Form) Expr Int Scope Int (List (Tup Expr Expr))) (Tup (List (Tup Expr Expr)) Scope Int)))
(defn tup-binds (names tmp i scope n acc)
  (if (= (len names) 0)
    (tup acc scope n)
    (let ((name (sym-name (at names 0)))
          (loc (Local name n))
          (item (Call (Prim "at") (tup tmp (Lit (IntLit i))))))
      (cond
        ((= name "") (fail (located scope "match name must be a name")))
        ((= name "_") (tup-binds (rest-of names) tmp (+ i 1) scope n acc))
        ((bound-in-pairs name acc) (fail (located scope "match: names in a pattern must be different")))
        (else
          (tup-binds
            (rest-of names)
            tmp
            (+ i 1)
            (bind-local scope name loc)
            (+ n 1)
            (+ acc (to-list (tup loc item)))))))))

(sig bound-in-pairs (Fn (String (List (Tup Expr Expr))) Bool))
(defn bound-in-pairs (name pairs)
  (if (= (len pairs) 0)
    false
    (let (((loc _) (at pairs 0)))
      (match loc
        ((Local other _) (or (= other name) (bound-in-pairs name (rest-of-pairs pairs))))
        (else (bound-in-pairs name (rest-of-pairs pairs)))))))

(sig rest-of-pairs (Fn ((List (Tup Expr Expr))) (List (Tup Expr Expr))))
(defn rest-of-pairs (pairs) (slice pairs 1 (len pairs)))

;; The sum that a clause list takes apart (all its clauses are of one sum, checked before).
(sig match-sum (Fn ((List Clause) Scope) String))
(defn match-sum (clauses scope) (get (map-get (get scope variants) (get (at clauses 0) variant)) sum))

(sig check-exhaustive (Fn (Expr String Scope) Expr))
(defn check-exhaustive (m sum scope)
  (match m
    ((MatchE _ clauses default)
      (let ((missing (missing-variants (map-get (get scope sums) sum) clauses empty-list)))
        (if (and (= (len default) 0) (> (len missing) 0))
          (fail (located scope (format "match on {sum}: no clause for {(join missing \", \")} (or add else)")))
          m)))
    (else m)))

(sig missing-variants (Fn ((List String) (List Clause) (List String)) (List String)))
(defn missing-variants (names clauses acc)
  (if (= (len names) 0)
    acc
    (missing-variants
      (slice names 1 (len names))
      clauses
      (if (has-clause (at names 0) clauses) acc (+ acc (to-list (at names 0)))))))

(sig has-clause (Fn (String (List Clause)) Bool))
(defn has-clause (name clauses)
  (cond
    ((= (len clauses) 0) false)
    ((= (get (at clauses 0) variant) name) true)
    (else (has-clause name (slice clauses 1 (len clauses))))))

;; The clauses, added to `m` (a MatchE) one by one; `sum` is the sum seen so far.
(sig match-clauses (Fn ((List Form) Scope Int Expr String) (Tup Expr Int)))
(defn match-clauses (forms scope n m sum)
  (if (= (len forms) 0)
    (tup m n)
    (let ((items (list-items (at forms 0))))
      (cond
        ((!= (len items) 2) (fail (located scope "match: clause must be (pattern expr)")))
        ((is-else (at items 0))
          (if (or (> (len forms) 1) (= (len (match-clause-list m)) 0))
            (fail (located scope "match: (else expr) must be the last clause, after a pattern"))
            (let (((e n1) (analyse-expr (at items 1) scope n)))
              (tup (set-default m e) n1))))
        (else
          (let ((pattern (list-items (at items 0)))
                (variant (if (> (len pattern) 0) (sym-name (at pattern 0)) ""))
                (checked (check-pattern variant pattern sum m scope))
                ((binds inner n1) (pattern-binds (variant-fields variant scope) (rest-of pattern) scope n empty-list))
                ((body n2) (analyse-expr (at items 1) inner n1)))
            (match-clauses
              (rest-of forms)
              scope
              n2
              (add-clause m (Clause variant binds body))
              (get (map-get (get scope variants) variant) sum))))))))

(sig check-pattern (Fn (String (List Form) String Expr Scope) Bool))
(defn check-pattern (variant pattern sum m scope)
  (cond
    ((= variant "") (fail (located scope "match: pattern must be (Variant name*) or else")))
    ((= variant "tup") (fail (located scope "match: a (tup name+) pattern must be the only clause, with no else")))
    ((not (is-variant variant scope)) (fail (located scope (format "match: {variant} is not a variant of a sum type"))))
    ((has-clause variant (match-clause-list m)) (fail (located scope (format "match: more than one clause for {variant}"))))
    ((and (!= sum "") (!= sum (get (map-get (get scope variants) variant) sum)))
      (fail (located scope (format "match: clauses mix variants of {sum} and {(get (map-get (get scope variants) variant) sum)}"))))
    ((!= (- (len pattern) 1) (len (variant-fields variant scope)))
      (fail (located scope (format "match: {variant} has {(len (variant-fields variant scope))} field(s), so the pattern needs that many names"))))
    (else true)))

(sig match-clause-list (Fn (Expr) (List Clause)))
(defn match-clause-list (m)
  (match m
    ((MatchE _ clauses _) clauses)
    (else empty-list)))

(sig add-clause (Fn (Expr Clause) Expr))
(defn add-clause (m clause)
  (match m
    ((MatchE subject clauses default) (MatchE subject (+ clauses (to-list clause)) default))
    (else m)))

(sig set-default (Fn (Expr Expr) Expr))
(defn set-default (m e)
  (match m
    ((MatchE subject clauses _) (MatchE subject clauses (to-list e)))
    (else m)))

;; The (field, Local) pairs a pattern's names bind, and the scope with them.
(sig pattern-binds
  (Fn ((List String) (List Form) Scope Int (List (Tup String Expr))) (Tup (List (Tup String Expr)) Scope Int)))
(defn pattern-binds (fields names scope n acc)
  (if (= (len names) 0)
    (tup acc scope n)
    (let ((name (sym-name (at names 0)))
          (loc (Local name n)))
      (cond
        ((= name "") (fail (located scope "match name must be a name")))
        ((= name "_") (pattern-binds (slice fields 1 (len fields)) (rest-of names) scope n acc))
        ((bound-in name acc) (fail (located scope "match: names in a pattern must be different")))
        (else
          (pattern-binds
            (slice fields 1 (len fields))
            (rest-of names)
            (bind-local scope name loc)
            (+ n 1)
            (+ acc (to-list (tup (at fields 0) loc)))))))))

(sig bound-in (Fn (String (List (Tup String Expr))) Bool))
(defn bound-in (name binds)
  (if (= (len binds) 0)
    false
    (let (((_ loc) (at binds 0)))
      (match loc
        ((Local other _) (or (= other name) (bound-in name (slice binds 1 (len binds)))))
        (else (bound-in name (slice binds 1 (len binds))))))))

;; --- quoting (doc/hl_rqmt/macros.md) ---

;; (quo form): `form` as a Form value, built with Form's constructors (form.cdy). Only
;; macro code (expand.cdy) has Form, so only it can quote. Quoted forms are NOWHERE, so
;; that an expansion takes the position of its call.
(sig an-quo (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-quo (rest scope n)
  (let ((checked (needs-form "quo" scope)))
    (if (!= (len rest) 1)
      (fail (located scope "quo: expected (quo form)"))
      (tup (quoted (at rest 0)) n))))

;; (quasi form): like quo, but (unq e) puts in e's value (a Form), and (unq-sp e) in a
;; list splices in e's items (a (List Form)).
(sig an-quasi (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn an-quasi (rest scope n)
  (let ((checked (needs-form "quasi" scope)))
    (if (!= (len rest) 1)
      (fail (located scope "quasi: expected (quasi form)"))
      (quasi-form (at rest 0) scope n))))

(sig needs-form (Fn (String Scope) Bool))
(defn needs-form (what scope)
  (if (get scope quoting) true (fail (located scope (format "{what}: only in macro code")))))

;; The Expr that builds `form` as a Form value.
(sig quoted (Fn (Form) Expr))
(defn quoted (form)
  (match form
    ((Sym name _) (Call (Global "Sym") (tup (Lit (Txt name)) (Global "NOWHERE"))))
    ((Lst items _) (Call (Global "Lst") (tup (form-list (quoted-all items empty-list)) (Global "NOWHERE"))))
    (else (Call (Global (literal-variant form)) (to-list (Lit form))))))

(sig quoted-all (Fn ((List Form) (List Expr)) (List Expr)))
(defn quoted-all (forms acc)
  (if (= (len forms) 0) acc (quoted-all (rest-of forms) (+ acc (to-list (quoted (at forms 0)))))))

;; A (List Form) of `items` (Exprs that make Forms).
(sig form-list (Fn ((List Expr)) Expr))
(defn form-list (items) (if (= (len items) 0) (Prim "empty-list") (Tuple items)))

(sig literal-variant (Fn (Form) String))
(defn literal-variant (form)
  (match form
    ((Txt _) "Txt")
    ((IntLit _) "IntLit")
    ((LongLit _) "LongLit")
    ((ByteLit _) "ByteLit")
    ((FloatLit _) "FloatLit")
    ((DoubleLit _) "DoubleLit")
    ((CharLit _) "CharLit")
    ((BoolLit _) "BoolLit")
    (else (fail "quo: not a literal"))))

;; The head of `form` if it is a list starting with a symbol, else "".
(sig head-name (Fn (Form) String))
(defn head-name (form) (sym-name (first-item form)))

;; A form inside quasi.
(sig quasi-form (Fn (Form Scope Int) (Tup Expr Int)))
(defn quasi-form (form scope n)
  (let ((head (head-name form))
        (here (at-pos scope (form-pos form))))
    (cond
      ((= head "unq") (unq-arg form here n))
      ((= head "unq-sp") (fail (located here "unq-sp: only inside a list in quasi")))
      ((= head "quasi") (fail (located here "quasi: a quasi inside a quasi isn't supported yet")))
      ((is-list-form form) (quasi-list (list-items form) here n))
      (else (tup (quoted form) n)))))

;; The e of (unq e) or (unq-sp e), analysed.
(sig unq-arg (Fn (Form Scope Int) (Tup Expr Int)))
(defn unq-arg (form scope n)
  (let ((items (list-items form)))
    (if (!= (len items) 2)
      (fail (located scope (format "{(head-name form)}: expected ({(head-name form)} expr)")))
      (analyse-expr (at items 1) scope n))))

;; A list in quasi: its items, with the (unq-sp e) ones spliced in. The parts are runs
;; of plain items (each a Tuple) and spliced lists, joined with +.
(sig quasi-list (Fn ((List Form) Scope Int) (Tup Expr Int)))
(defn quasi-list (items scope n)
  (let (((parts n1) (quasi-parts items scope n empty-list empty-list)))
    (tup (Call (Global "Lst") (tup (join-parts parts) (Global "NOWHERE"))) n1)))

(sig quasi-parts
  (Fn ((List Form) Scope Int (List Expr) (List Expr)) (Tup (List Expr) Int)))
(defn quasi-parts (items scope n run parts)
  (if (= (len items) 0)
    (tup (close-run run parts) n)
    (let ((item (at items 0)))
      (if (= (head-name item) "unq-sp")
        (let (((e n1) (unq-arg item (at-pos scope (form-pos item)) n)))
          (quasi-parts (rest-of items) scope n1 empty-list (+ (close-run run parts) (to-list e))))
        (let (((e n1) (quasi-form item scope n)))
          (quasi-parts (rest-of items) scope n1 (+ run (to-list e)) parts))))))

(sig close-run (Fn ((List Expr) (List Expr)) (List Expr)))
(defn close-run (run parts) (if (= (len run) 0) parts (+ parts (to-list (Tuple run)))))

(sig join-parts (Fn ((List Expr)) Expr))
(defn join-parts (parts)
  (cond
    ((= (len parts) 0) (Prim "empty-list"))
    ((= (len parts) 1) (at parts 0))
    (else (Call (Prim "+") parts))))

;; --- types ---

(sig is-lower (Fn (String) Bool))
(defn is-lower (name)
  (and (> (len name) 0) (>= (slice name 0 1) "a") (<= (slice name 0 1) "z")))

(sig analyse-type (Fn (Form) CType))
(defn analyse-type (form)
  (match form
    ((Sym name _) (if (is-lower name) (TVar name) (TCon name empty-list)))
    ((Lst items _)
      (cond
        ((= (len items) 0) (fail (+ (pos-text (form-pos form)) "bad type ()")))
        ((= (sym-name (at items 0)) "Fn")
          (if (= (len items) 3)
            (TFn (analyse-types (list-items (at items 1)) empty-list) (analyse-type (at items 2)))
            (fail (+ (pos-text (form-pos form)) "bad function type: expected (Fn (Arg+) Ret)"))))
        (else (TCon (sym-name (at items 0)) (analyse-types (rest-of items) empty-list)))))
    (else (fail (+ (pos-text (form-pos form)) "bad type")))))

(sig analyse-types (Fn ((List Form) (List CType)) (List CType)))
(defn analyse-types (forms acc)
  (if (= (len forms) 0)
    acc
    (analyse-types (rest-of forms) (+ acc (to-list (analyse-type (at forms 0)))))))

;; --- top level ---

;; `defs` are the names that need a sig (def and defn); `defined` those defined so far.
(deft Prog
  ((out (List Top))
   (sigs (Map String CType))
   (n Int)
   (defs (Map String Bool))
   (defined (Map String Bool))))

;; The names that def and defn define, so that any form can refer to them.
(sig top-names (Fn ((List Form) (Map String Bool)) (Map String Bool)))
(defn top-names (forms acc)
  (if (= (len forms) 0)
    acc
    (let ((items (list-items (at forms 0)))
          (head (if (> (len items) 1) (sym-name (at items 0)) "")))
      (top-names
        (rest-of forms)
        (cond
          ((or (= head "def") (= head "defn")) (add-name (sym-name (at items 1)) (form-pos (at items 1)) acc))
          ((and (= head "deft") (is-sum-body (slice items 2 (len items))))
            ;; A sum's own name is a type, but in Python it is a name like the others.
            (add-names
              (variant-names (slice items 2 (len items)) empty-list)
              (form-pos (at items 1))
              (map-set (add-name (deft-name (at items 1)) (form-pos (at items 1)) acc) (deft-name (at items 1)) false)))
          ((= head "deft") (add-name (deft-name (at items 1)) (form-pos (at items 1)) acc))
          (else acc))))))

;; Top-level names map to true for values, false for a sum's type name.
;; `pos` is where the name is defined, for the error.
(sig add-name (Fn (String Pos (Map String Bool)) (Map String Bool)))
(defn add-name (name pos acc)
  (if (map-has acc name)
    (fail (+ (pos-text pos) (format "defined more than once: {name}")))
    (map-set acc name true)))

(sig add-names (Fn ((List String) Pos (Map String Bool)) (Map String Bool)))
(defn add-names (names pos acc)
  (if (= (len names) 0)
    acc
    (add-names (slice names 1 (len names)) pos (add-name (at names 0) pos acc))))

;; Whether a deft body (what follows the name) lists variants, not one field list: each
;; variant starts with a symbol, (Circle ...) or (Leaf); a field list starts with a list.
(sig is-sum-body (Fn ((List Form)) Bool))
(defn is-sum-body (body)
  (and (> (len body) 0) (all-variant-forms body)))

(sig all-variant-forms (Fn ((List Form)) Bool))
(defn all-variant-forms (body)
  (cond
    ((= (len body) 0) true)
    ((= (sym-name (first-item (at body 0))) "") false)
    (else (all-variant-forms (rest-of body)))))

(sig first-item (Fn (Form) Form))
(defn first-item (form)
  (let ((items (list-items form)))
    (if (= (len items) 0) (Lst empty-list NOWHERE) (at items 0))))

(sig variant-names (Fn ((List Form) (List String)) (List String)))
(defn variant-names (body acc)
  (if (= (len body) 0)
    acc
    (variant-names (rest-of body) (+ acc (to-list (sym-name (first-item (at body 0))))))))

;; Each variant's sum and field names, and each sum's variants, before analysing them.
(sig find-variants (Fn ((List Form) Scope) Scope))
(defn find-variants (forms scope)
  (if (= (len forms) 0)
    scope
    (let ((items (list-items (at forms 0)))
          (head (if (> (len items) 2) (sym-name (at items 0)) ""))
          (body (slice items 2 (len items))))
      (find-variants
        (rest-of forms)
        (if (and (= head "deft") (is-sum-body body))
          (let ((sum (deft-name (at items 1))))
            (add-variants
              sum
              body
              (assoc scope sums (map-set (get scope sums) sum (variant-names body empty-list)))))
          scope)))))

(sig add-variants (Fn (String (List Form) Scope) Scope))
(defn add-variants (sum body scope)
  (if (= (len body) 0)
    scope
    (let ((v-items (list-items (at body 0)))
          (name (sym-name (at v-items 0)))
          (fields (if (= (len v-items) 2) (field-names (list-items (at v-items 1)) empty-list) empty-list)))
      (add-variants
        sum
        (rest-of body)
        (assoc scope variants (map-set (get scope variants) name (VInfo sum fields)))))))

(sig field-names (Fn ((List Form) (List String)) (List String)))
(defn field-names (fields acc)
  (if (= (len fields) 0)
    acc
    (field-names (rest-of fields) (+ acc (to-list (sym-name (first-item (at fields 0))))))))

;; The name in (deft Name ...) or (deft (Name a b) ...).
(sig deft-name (Fn (Form) String))
(defn deft-name (form)
  (match form
    ((Lst items _) (if (= (len items) 0) "" (sym-name (at items 0))))
    (else (sym-name form))))

;; --- the built-ins (system.cdy, doc/hl_rqmt/system_prelude.md) ---

;; The built-ins' types, from the forms of system.cdy: each a bodiless (sig name Type).
;; They are checked against `table` both ways: every sig needs a Python mapping, and every
;; table entry but the special forms and operators needs a sig.
(sig system-sigs (Fn ((List Form) Any) (Map String CType)))
(defn system-sigs (forms table)
  (let ((sigs (read-sigs forms table empty-map))
        (checked (all-declared (map-keys table) table sigs)))
    sigs))

(sig read-sigs (Fn ((List Form) Any (Map String CType)) (Map String CType)))
(defn read-sigs (forms table acc)
  (if (= (len forms) 0)
    acc
    (let ((form (at forms 0))
          (items (list-items form))
          (name (if (and (= (len items) 3) (= (sym-name (at items 0)) "sig")) (sym-name (at items 1)) ""))
          (where (pos-text (form-pos form))))
      (cond
        ((= name "") (fail (+ where "system.cdy: expected (sig name Type)")))
        ((map-has acc name) (fail (format "{where}system.cdy: more than one sig for {name}")))
        ((not (in (table-get-kind table name) BUILTIN_KINDS))
          (fail (format "{where}system.cdy: {name} has no Python mapping in table.py")))
        (else (read-sigs (rest-of forms) table (map-set acc name (analyse-type (at items 2)))))))))

;; The kinds of table entry that system.cdy declares: not special forms or operators.
(sig BUILTIN_KINDS (List String))
(def BUILTIN_KINDS (tup "call" "value" "index" "slice"))

(sig all-declared (Fn ((List String) Any (Map String CType)) Bool))
(defn all-declared (names table sigs)
  (cond
    ((= (len names) 0) true)
    ((and (in (table-get-kind table (at names 0)) BUILTIN_KINDS) (not (map-has sigs (at names 0))))
      (fail (format "built-in {(at names 0)} has no sig in system.cdy")))
    (else (all-declared (slice names 1 (len names)) table sigs))))

;; --- modules (doc/hl_rqmt/modules.md) ---

;; What a module defines at top level, which the modules importing it see: its names (true
;; for values, false for a sum's type name), variants and sums, and each name's global
;; name. Outside the top module, a global name has the module's stem as a prefix
;; (util__greet), so two modules can define the same name; no Candy name contains __.
(deft Exports
  ((stem String)
   (top (Map String Bool))
   (variants (Map String VInfo))
   (sums (Map String (List String)))
   (names (Map String String))))

;; What `forms` define, as the module `stem`, whose global names start with `prefix`.
(sig module-exports (Fn ((List Form) String String) Exports))
(defn module-exports (forms stem prefix)
  (let ((top (top-names forms empty-map))
        (found (find-variants forms (blank-scope top))))
    (Exports stem top (get found variants) (get found sums) (prefixed (map-keys top) prefix empty-map))))

(sig prefixed (Fn ((List String) String (Map String String)) (Map String String)))
(defn prefixed (names prefix acc)
  (if (= (len names) 0)
    acc
    (prefixed (slice names 1 (len names)) prefix (map-set acc (at names 0) (+ prefix (at names 0))))))

;; A scope with only `top`, for finding variants.
(sig blank-scope (Fn ((Map String Bool)) Scope))
(defn blank-scope (top)
  (Scope empty-map top nil (fn (text) empty-list) empty-map empty-map NOWHERE empty-map false empty-map empty-map empty-map))

;; `forms`, one program on its own (a macro program), with no imports and no prefix;
;; `builtins` are the built-ins' types (system-sigs).
(sig analyse-program
  (Fn ((List Form) Any (Map String CType) (Fn (String) (List Form)) (Map String Macro) Bool) (List Top)))
(defn analyse-program (forms table builtins parse macros quoting)
  (analyse-module forms (module-exports forms "" "") empty-list empty-map table builtins parse macros quoting))

;; The module `forms`, which exports `own`. It imports `imports` (each module's exports,
;; and where the import is); `elsewhere` has the names the program's other modules define.
(sig analyse-module
  (Fn ((List Form) Exports (List (Tup Exports Pos)) (Map String String) Any (Map String CType) (Fn (String) (List Form)) (Map String Macro) Bool)
      (List Top)))
(defn analyse-module (forms own imports elsewhere table builtins parse macros quoting)
  (let ((seen (with-own (with-imports imports (Seen (Exports "" empty-map empty-map empty-map empty-map) empty-map)) own))
        (vis (get seen vis))
        (scope (Scope empty-map (get vis top) table parse (get vis variants) (get vis sums) NOWHERE macros quoting (get vis names) elsewhere builtins))
        (prog (analyse-tops forms scope (Prog empty-list empty-map 0 (def-names forms empty-map) empty-map))))
    (rename-tops (get prog out) (get vis names) empty-list)))

;; What a module sees: its imports' exports and its own, merged; and which module each
;; imported name comes from (by stem).
(deft Seen ((vis Exports) (from (Map String String))))

;; `seen` with `imports` added. Two imports that define the same name are an error.
(sig with-imports (Fn ((List (Tup Exports Pos)) Seen) Seen))
(defn with-imports (imports seen)
  (if (= (len imports) 0)
    seen
    (let (((ex pos) (at imports 0)))
      (with-imports (slice imports 1 (len imports)) (import-names (map-keys (get ex top)) ex pos seen)))))

(sig import-names (Fn ((List String) Exports Pos Seen) Seen))
(defn import-names (names ex pos seen)
  (if (= (len names) 0)
    (assoc seen vis
      (assoc (get seen vis)
        variants (put-all (get ex variants) (map-keys (get ex variants)) (get (get seen vis) variants))
        sums (put-all (get ex sums) (map-keys (get ex sums)) (get (get seen vis) sums))))
    (let ((name (at names 0))
          (stem (get ex stem))
          (from (get seen from))
          (vis (get seen vis)))
      (if (and (map-has from name) (!= (map-get from name) stem))
        (fail (format "{(pos-text pos)}import: {(map-get from name)} and {stem} both define {name}"))
        (import-names
          (slice names 1 (len names))
          ex
          pos
          (Seen
            (assoc vis
              top (map-set (get vis top) name (map-get (get ex top) name))
              names (map-set (get vis names) name (map-get (get ex names) name)))
            (map-set from name stem)))))))

;; `seen` with the module's own names, which win over imported ones.
(sig with-own (Fn (Seen Exports) Seen))
(defn with-own (seen own)
  (let ((vis (get seen vis)))
    (assoc seen vis
      (assoc vis
        top (put-all (get own top) (map-keys (get own top)) (get vis top))
        variants (put-all (get own variants) (map-keys (get own variants)) (get vis variants))
        sums (put-all (get own sums) (map-keys (get own sums)) (get vis sums))
        names (put-all (get own names) (map-keys (get own names)) (get vis names))))))

;; `acc` with the entries of `m` for `keys`.
(sig put-all (Fn ((Map String a) (List String) (Map String a)) (Map String a)))
(defn put-all (m keys acc)
  (if (= (len keys) 0)
    acc
    (put-all m (slice keys 1 (len keys)) (map-set acc (at keys 0) (map-get m (at keys 0))))))

;; The names other modules define, each with its module's stem.
(sig elsewhere-names (Fn ((List Exports) (Map String String)) (Map String String)))
(defn elsewhere-names (exports acc)
  (if (= (len exports) 0)
    acc
    (let ((ex (at exports 0)))
      (elsewhere-names
        (slice exports 1 (len exports))
        (put-all (stems-for (map-keys (get ex top)) (get ex stem) empty-map) (map-keys (get ex top)) acc)))))

(sig stems-for (Fn ((List String) String (Map String String)) (Map String String)))
(defn stems-for (names stem acc)
  (if (= (len names) 0) acc (stems-for (slice names 1 (len names)) stem (map-set acc (at names 0) stem))))

;; `tops` with the names they define, and the types they use, by global name.
(sig rename-tops (Fn ((List Top) (Map String String) (List Top)) (List Top)))
(defn rename-tops (tops names acc)
  (if (= (len tops) 0)
    acc
    (rename-tops (slice tops 1 (len tops)) names (+ acc (to-list (rename-top (at tops 0) names))))))

(sig rename-top (Fn (Top (Map String String)) Top))
(defn rename-top (top names)
  (match top
    ((TDeft name tvars fields) (TDeft (global-name name names) tvars (rename-fields fields names empty-list)))
    ((TDeftSum name tvars variants)
      (TDeftSum (global-name name names) tvars (rename-variants variants names empty-list)))
    ((TDef name init t) (TDef (global-name name names) init (rename-type t names)))
    ((TDefn name params body t) (TDefn (global-name name names) params body (rename-type t names)))
    ((TExpr _) top)))

(sig rename-variants (Fn ((List Variant) (Map String String) (List Variant)) (List Variant)))
(defn rename-variants (variants names acc)
  (if (= (len variants) 0)
    acc
    (let ((v (at variants 0)))
      (rename-variants
        (slice variants 1 (len variants))
        names
        (+ acc (to-list (Variant (global-name (get v name) names) (rename-fields (get v fields) names empty-list))))))))

(sig rename-fields
  (Fn ((List (Tup String CType)) (Map String String) (List (Tup String CType))) (List (Tup String CType))))
(defn rename-fields (fields names acc)
  (if (= (len fields) 0)
    acc
    (let (((field t) (at fields 0)))
      (rename-fields (slice fields 1 (len fields)) names (+ acc (to-list (tup field (rename-type t names))))))))

(sig rename-type (Fn (CType (Map String String)) CType))
(defn rename-type (t names)
  (match t
    ((TCon name args) (TCon (global-name name names) (rename-types args names empty-list)))
    ((TVar _) t)
    ((TFn params ret) (TFn (rename-types params names empty-list) (rename-type ret names)))))

(sig rename-types (Fn ((List CType) (Map String String) (List CType)) (List CType)))
(defn rename-types (types names acc)
  (if (= (len types) 0)
    acc
    (rename-types (slice types 1 (len types)) names (+ acc (to-list (rename-type (at types 0) names))))))

(sig def-names (Fn ((List Form) (Map String Bool)) (Map String Bool)))
(defn def-names (forms acc)
  (if (= (len forms) 0)
    acc
    (let ((items (list-items (at forms 0)))
          (head (if (> (len items) 1) (sym-name (at items 0)) "")))
      (def-names
        (rest-of forms)
        (if (or (= head "def") (= head "defn")) (map-set acc (sym-name (at items 1)) true) acc)))))

(sig analyse-tops (Fn ((List Form) Scope Prog) Prog))
(defn analyse-tops (forms scope prog)
  (if (= (len forms) 0)
    prog
    (analyse-tops (rest-of forms) scope (analyse-top (at forms 0) scope prog))))

(sig add-top (Fn (Prog Top Int) Prog))
(defn add-top (prog top n) (assoc prog out (+ (get prog out) (to-list top)) n n))

(sig mark-defined (Fn (Prog String) Prog))
(defn mark-defined (prog name) (assoc prog defined (map-set (get prog defined) name true)))

(sig analyse-top (Fn (Form Scope Prog) Prog))
(defn analyse-top (form scope prog)
  (let ((items (list-items form))
        (head (if (> (len items) 0) (sym-name (at items 0)) ""))
        (here (at-pos scope (form-pos form))))
    (cond
      ((and (in head (tup "def" "defn")) (> (len items) 1) (map-has (get scope macros) (sym-name (at items 1))))
        (fail (located here (format "{(sym-name (at items 1))} is a macro, so it can't be defined"))))
      ((= head "sig") (top-sig items here prog))
      ((= head "def") (top-def items here prog))
      ((= head "defn") (top-defn items here prog))
      ((= head "deft") (top-deft items here prog))
      (else
        (let (((e n) (analyse-expr form here (get prog n))))
          (add-top prog (TExpr e) n))))))

(sig top-sig (Fn ((List Form) Scope Prog) Prog))
(defn top-sig (items scope prog)
  (let ((name (if (= (len items) 3) (sym-name (at items 1)) "")))
    (cond
      ((= name "") (fail (located scope "sig: expected (sig name Type)")))
      ((not (map-has (get prog defs) name))
        (fail (located scope (format "sig for {name}, but no def or defn of {name} in this file"))))
      ((map-has (get prog defined) name) (fail (located scope (format "sig for {name} comes after its definition"))))
      ((map-has (get prog sigs) name) (fail (located scope (format "more than one sig for {name}"))))
      (else (assoc prog sigs (map-set (get prog sigs) name (analyse-type (at items 2))))))))

;; (deft Name ((field Type)+)) or (deft (Name a b) ((field Type)+)): a record type.
;; A sum, (deft Name variant+), lists its variants instead: (Circle ((r Double))) or (Leaf).
(sig top-deft (Fn ((List Form) Scope Prog) Prog))
(defn top-deft (items scope prog)
  (let ((name (if (> (len items) 1) (deft-name (at items 1)) ""))
        (tvars (if (> (len items) 1) (syms (rest-of (list-items (at items 1))) empty-list) empty-list))
        (body (slice items 2 (len items)))
        (field-forms (if (= (len items) 3) (list-items (at items 2)) empty-list)))
    (cond
      ((= name "") (fail (located scope "deft: expected (deft Name ((field Type)+)) or (deft Name variant+)")))
      ((is-sum-body body)
        (add-top prog (TDeftSum name tvars (deft-variants body empty-list)) (get prog n)))
      ((= (len field-forms) 0) (fail (located scope "deft: expected (deft Name ((field Type)+))")))
      (else (add-top prog (TDeft name tvars (deft-fields field-forms empty-list)) (get prog n))))))

(sig deft-variants (Fn ((List Form) (List Variant)) (List Variant)))
(defn deft-variants (body acc)
  (if (= (len body) 0)
    acc
    (let ((v-items (list-items (at body 0)))
          (name (sym-name (at v-items 0))))
      (cond
        ((not (is-upper name)) (fail (+ (pos-text (form-pos (at body 0))) (format "deft: variant names are Capitalised, not {name}"))))
        ((= (len v-items) 1) (deft-variants (rest-of body) (+ acc (to-list (Variant name empty-list)))))
        ((and (= (len v-items) 2) (> (len (list-items (at v-items 1))) 0))
          (deft-variants
            (rest-of body)
            (+ acc (to-list (Variant name (deft-fields (list-items (at v-items 1)) empty-list))))))
        (else (fail (+ (pos-text (form-pos (at body 0))) "deft: variant must be (Name) or (Name ((field Type)+))")))))))

(sig is-upper (Fn (String) Bool))
(defn is-upper (name)
  (and (> (len name) 0) (>= (slice name 0 1) "A") (<= (slice name 0 1) "Z")))

(sig syms (Fn ((List Form) (List String)) (List String)))
(defn syms (forms acc)
  (if (= (len forms) 0) acc (syms (rest-of forms) (+ acc (to-list (sym-name (at forms 0)))))))

(sig deft-fields (Fn ((List Form) (List (Tup String CType))) (List (Tup String CType))))
(defn deft-fields (forms acc)
  (if (= (len forms) 0)
    acc
    (let ((items (list-items (at forms 0))))
      (if (or (!= (len items) 2) (= (sym-name (at items 0)) ""))
        (fail (+ (pos-text (form-pos (at forms 0))) "deft: field must be (name Type)"))
        (deft-fields
          (rest-of forms)
          (+ acc (to-list (tup (sym-name (at items 0)) (analyse-type (at items 1))))))))))

(sig needs-sig (Fn (String Prog Scope) CType))
(defn needs-sig (name prog scope)
  (if (map-has (get prog sigs) name)
    (map-get (get prog sigs) name)
    (fail (located scope (format "{name} needs a (sig {name} Type) before its definition")))))

(sig top-def (Fn ((List Form) Scope Prog) Prog))
(defn top-def (items scope prog)
  (if (!= (len items) 3)
    (fail (located scope "def: expected (def name init); the initial value is required"))
    (let ((name (sym-name (at items 1)))
          (t (needs-sig name prog scope))
          ((init n) (analyse-expr (at items 2) scope (get prog n))))
      (mark-defined (add-top prog (TDef name init t) n) name))))

(sig top-defn (Fn ((List Form) Scope Prog) Prog))
(defn top-defn (items scope prog)
  (if (!= (len items) 4)
    (fail (located scope "defn: expected (defn name (args+) body), with exactly one body form"))
    (let ((name (sym-name (at items 1)))
          (t (needs-sig name prog scope))
          (arg-forms (list-items (at items 2)))
          ((params inner n1) (bind-params arg-forms scope (get prog n) empty-list))
          ((body n2) (analyse-expr (at items 3) inner n1)))
      (cond
        ((= (len params) 0) (fail (located scope (format "defn {name}: at least one argument is needed"))))
        ((!= (len params) (fn-arity t))
          (fail (located scope (format "defn {name}: its sig must be a function type with one type per argument"))))
        (else (mark-defined (add-top prog (TDefn name params body t) n2) name))))))

;; How many arguments a function type takes; -1 if it isn't a function type.
(sig fn-arity (Fn (CType) Int))
(defn fn-arity (t)
  (match t
    ((TFn params _) (len params))
    (else -1)))

;; Fresh Locals for the parameter names, and the scope that includes them.
(sig bind-params (Fn ((List Form) Scope Int (List Expr)) (Tup (List Expr) Scope Int)))
(defn bind-params (forms scope n acc)
  (if (= (len forms) 0)
    (tup acc scope n)
    (let ((name (sym-name (at forms 0)))
          (loc (Local name n)))
      (if (= name "")
        (fail (located scope "a parameter must be a name"))
        (bind-params
          (rest-of forms)
          (bind-local scope name loc)
          (+ n 1)
          (+ acc (to-list loc)))))))

;; --- main ---

;; A program may define `main`: it takes the command-line arguments and returns the exit
;; status, and it runs when the program is run (not when its module is imported).
(sig MAIN_TYPE CType)
(def MAIN_TYPE (TFn (to-list (TCon "List" (to-list (TCon "String" empty-list)))) (TCon "Int" empty-list)))

;; Whether the program defines `main`; it must be a defn typed (Fn ((List String)) Int).
(sig has-main (Fn ((List Top)) Bool))
(defn has-main (tops)
  (cond
    ((= (len tops) 0) false)
    ((is-main (at tops 0)) true)
    (else (has-main (slice tops 1 (len tops))))))

(sig is-main (Fn (Top) Bool))
(defn is-main (top)
  (match top
    ((TDefn name _ _ t)
      (cond
        ((!= name "main") false)
        ((= t MAIN_TYPE) true)
        (else (fail "main must be typed (Fn ((List String)) Int)"))))
    ((TDef name _ _) (if (= name "main") (fail "main must be a defn") false))
    (else false)))
