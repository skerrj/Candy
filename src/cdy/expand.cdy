;;; Expand: macros (doc/hl_rqmt/macros.md), between include and analyse. A file's macros
;;; are its top-level `defmacro`s and those of the macro files it imports with
;;; `(import-macros name)`. The defmacros become a macro program, which the translator
;;; analyses and loads on its interpreter (cdyc.cdy, macro-loader; interp_macros.cdy;
;;; doc/hl_rqmt/host_macros.md); then every call of a macro is replaced by what the macro
;;; returns, until no macro calls are left.
;;;
;;; A macro file's other forms are helpers: they run while translating, as part of the
;;; macro programs of its own defmacros and of the files that import it, and never in the
;;; program.
;;;
;;; Every file but the prelude itself also imports the prelude's macros (`cond`, from
;;; prelude_macros.cdy, which is kept next to the translator, like form.cdy). They are
;;; compiled and loaded once per translation, as the built-ins are read once (an Expander;
;;; [[B62]], [[B66]]).

(import form)
(import read)
(import include)
(import core)
(import emit)
(import translator)
(import map ())

;; What a file's macro imports bring it: their macros, their helpers by file (each file's
;; once, and before the files that use them), and the files loaded so far.
(deft Imports ((macros (List Macro)) (helpers (List (Tup String (List Form)))) (seen (Map String Bool))))

;; A file with its macros expanded: its other forms, the macros it can use (its imports'
;; and its own), its own macros, and its imports' helpers.
(deft Expanded
  ((forms (List Form))
   (macros (Map String Macro))
   (own (List Macro))
   (helpers (List (Tup String (List Form))))))

;; What expanding needs, made once per translation (new-expander): the built-ins
;; (read-builtins), how a macro program is loaded (`load`: given its forms, the function a
;; macro's defn is, by its name), and the prelude's macros, loaded (`prelude`), which every
;; file but the prelude's own starts from.
(deft Expander
  ((builtins (Map String Builtin))
   (load (Fn ((List Form)) (Fn (String) (Fn ((List Form)) Form))))
   (prelude Imports)))

;; The Expander for `builtins` and `load`, the prelude's macros loaded with them.
(sig new-expander
  (Fn ((Map String Builtin) (Fn ((List Form)) (Fn (String) (Fn ((List Form)) Form)))) Expander))
(defn new-expander (builtins load)
  (let ((bare (Expander builtins load (Imports empty-list empty-list map.empty)))
        (path (library-path "prelude_macros.cdy"))
        (form (Lst (List (Sym "import-macros" NOWHERE) (Txt path NOWHERE)) NOWHERE)))
    (assoc bare prelude (import-file form bare empty-list (get bare prelude)))))

;; The program's forms with its defmacros and macro imports taken out and its macro calls
;; expanded, and its macros.
(sig expand-program
  (Fn ((List Form) Expander) (Tup (List Form) (Map String Macro))))
(defn expand-program (forms ex)
  (let ((done (expand-file forms false ex empty-list)))
    (Tup (get done forms) (get done macros))))

(sig MACRO_HEADS (List String))
(def MACRO_HEADS (List "defmacro" "import-macros"))

;; `forms` expanded. In a macro file (`macro-file`), the other forms are helpers, which can
;; use only the imported macros (the file's own are compiled with them). `loading` holds the
;; macro files being loaded, to catch a cycle.
(sig expand-file (Fn ((List Form) Bool Expander (List String)) Expanded))
(defn expand-file (forms macro-file ex loading)
  (let ((imports (import-all (pick-forms forms (List "import-macros") true) ex loading (get ex prelude)))
        (imported (macro-map (get imports macros) map.empty))
        (defs (expand-defs (pick-forms forms (List "defmacro") true) imported))
        (rest (pick-forms forms MACRO_HEADS false))
        (helpers (if macro-file (splice-dos (expand-all rest imported)) empty-list))
        (own
          (if (= (len defs) 0)
            empty-list
            (load-defs defs (++ (helper-forms (get imports helpers)) helpers) ex)))
        (macros (macro-map own imported)))
    (Expanded
      (if macro-file helpers (splice-dos (expand-all rest macros)))
      macros
      own
      (get imports helpers))))

;; `forms`, a file's top level after expansion, with each `(do form*)` replaced by its
;; forms, spliced in, a `do` among them too (programs.top-do): so a macro can define
;; several things, `(do (sig f T) (defn f ...))`. A defmacro, import or import-macros
;; can't be one of them, since those are read before macros are expanded.
(sig splice-dos (Fn ((List Form)) (List Form)))
(defn splice-dos (forms)
  (concat
    (map
      (fn (form)
        (let ((items (list-items form)))
          (if (and (> (len items) 0) (= (sym-name (at items 0)) "do"))
            (splice-dos (map spliceable (rest items)))
            (List form))))
      forms)))

;; `form`, a top-level do's, unless it is read before expansion: an error.
(sig spliceable (Fn (Form) Form))
(defn spliceable (form)
  (let ((items (list-items form))
        (head (if (> (len items) 0) (sym-name (at items 0)) "")))
    (if (contains head (List "defmacro" "import" "import-macros"))
      (fail (format "{(pos-text (form-pos form))}{head} can't be in a top-level do: it is read before macros are expanded"))
      form)))

;; The forms whose heads are in `heads` (or, if `keep` is false, the others).
(sig pick-forms (Fn ((List Form) (List String) Bool) (List Form)))
(defn pick-forms (forms heads keep)
  (filter
    (fn (form)
      (let ((items (list-items form)))
        (= (and (> (len items) 0) (contains (sym-name (at items 0)) heads)) keep)))
    forms))

;; Each defmacro in `defs` with the macro calls in its body expanded.
(sig expand-defs (Fn ((List Form) (Map String Macro)) (List Form)))
(defn expand-defs (defs macros)
  (map (fn (d) (Lst (expand-after (list-items d) 3 macros) (form-pos d))) defs))

;; `macros` added to the map `start`; two macros with one name are an error.
(sig macro-map (Fn ((List Macro) (Map String Macro)) (Map String Macro)))
(defn macro-map (macros start)
  (fold
    (fn (acc macro)
      (let ((name (get macro name)))
        (if (map.has acc name)
          (fail (format "{(pos-text (get macro pos))}defmacro: {name} is already a macro"))
          (map.set acc name macro))))
    start
    macros))

;; --- macro files ---

;; `start` with the macro files of the (import-macros "path") forms `forms` loaded.
(sig import-all (Fn ((List Form) Expander (List String) Imports) Imports))
(defn import-all (forms ex loading start)
  (fold (fn (acc form) (import-file form ex loading acc)) start forms))

;; `acc` with the macro file of `form` loaded, unless it was already.
(sig import-file (Fn (Form Expander (List String) Imports) Imports))
(defn import-file (form ex loading acc)
  (let ((path (macro-path form))
        (key (path-resolve path)))
    (cond
      ((map.has (get acc seen) key) acc)
      ((contains key loading)
        (fail (format "{(pos-text (form-pos form))}import-macros: {path} imports itself")))
      (else
        (let ((done (expand-file (read-program path) true ex (++ loading (List key)))))
          (Imports
            (++ (get acc macros) (get done own))
            (add-helpers (++ (get done helpers) (List (Tup key (get done forms)))) (get acc helpers))
            (map.set (get acc seen) key true)))))))

;; The path in (import-macros "path"), which include.cdy put there.
(sig macro-path (Fn (Form) String))
(defn macro-path (form)
  (match (at (list-items form) 1)
    ((Txt path _) path)
    (else (fail (++ (pos-text (form-pos form)) "import-macros: expected (import-macros name)")))))

;; `start` with the helper groups `groups` added, except files it has already.
(sig add-helpers
  (Fn ((List (Tup String (List Form))) (List (Tup String (List Form)))) (List (Tup String (List Form)))))
(defn add-helpers (groups start)
  (fold
    (fn (acc g) (let (((key _forms) g)) (if (has-helpers key acc) acc (++ acc (List g)))))
    start
    groups))

(sig has-helpers (Fn (String (List (Tup String (List Form)))) Bool))
(defn has-helpers (key groups)
  (any (fn (g) (let (((k _forms) g)) (= k key))) groups))

;; The forms of all the helper groups.
(sig helper-forms (Fn ((List (Tup String (List Form)))) (List Form)))
(defn helper-forms (groups)
  (concat (map (fn (g) (let (((_key forms) g)) forms)) groups)))

;; --- compiling and loading macros ---

;; The macros `defs` define, loaded with the helper forms `helpers`.
(sig load-defs (Fn ((List Form) (List Form) Expander) (List Macro)))
(defn load-defs (defs helpers ex)
  (let ((builtins (get ex builtins))
        (checked (unique-names defs builtins map.empty))
        (run ((get ex load) (++ (form-defs nil) helpers (macro-program defs builtins)))))
    (macro-list defs run)))

;; The built-ins, from special.cdy, system.cdy and the declaration modules (include.cdy),
;; which are kept next to the translator (read-builtins).
(sig library-builtins (Fn (Unit) (Map String Builtin)))
(defn library-builtins (_)
  (let ((decls (library-path "special.cdy")))
    (read-builtins
      (read-source decls (slurp decls))
      (map
        (fn (file) (let ((path (library-path file))) (Tup file (read-source path (slurp path)))))
        (++ (List "system.cdy") (map (fn (name) (++ name ".cdy")) (declaration-modules nil))))
      py-spellings)))

;; Form and its helpers, which macro code may use: form.cdy, read as it is (so it can't
;; use macros), without its import of translator, which macro code imports implicitly
;; (macro-imports, cdyc.cdy).
(sig form-defs (Fn (Unit) (List Form)))
(defn form-defs (_)
  (let ((path (library-path "form.cdy")))
    (filter (fn (form) (not (is-import form))) (read-source path (slurp path)))))

;; Each (defmacro name params body) as a function from the arguments to a form:
;; (sig macro__name (Fn ((List Form)) Form))
;; (defn macro__name (args__) (let ((p1 (at args__ 0)) ...) body))
(sig macro-program (Fn ((List Form) (Map String Builtin)) (List Form)))
(defn macro-program (defs builtins)
  (concat
    (map
      (fn (d)
        (let ((items (defmacro-items d builtins))
              (pos (form-pos d))
              (fname (Sym (macro-fn (sym-name (at items 1))) pos))
              (args (Sym "args__" pos))
              (type (Lst (List (Sym "Fn" pos) (Lst (List (Lst (List (Sym "List" pos) (Sym "Form" pos)) pos)) pos) (Sym "Form" pos)) pos))
              (body (Lst (List (Sym "let" pos) (Lst (param-binds (at items 2) args pos) pos) (at items 3)) pos)))
          (List
            (Lst (List (Sym "sig" pos) fname type) pos)
            (Lst (List (Sym "defn" pos) fname (Lst (List args) pos) body) pos))))
      defs)))

;; The items of (defmacro name params body), checked; a special form (in `builtins`)
;; can't be a macro's name.
(sig defmacro-items (Fn (Form (Map String Builtin)) (List Form)))
(defn defmacro-items (form builtins)
  (let ((items (list-items form))
        (where (pos-text (form-pos form))))
    (cond
      ((or (!= (len items) 4) (= (sym-name (at items 1)) ""))
        (fail (++ where "defmacro: expected (defmacro name (params) body) or (defmacro name args body)")))
      ((is-special (sym-name (at items 1)) builtins)
        (fail (format "{where}defmacro: {(sym-name (at items 1))} is a special form")))
      ((not (params-ok (at items 2))) (fail (++ where "defmacro: a parameter must be a name")))
      (else items))))

;; Whether `params` is a bare name or a list of names.
(sig params-ok (Fn (Form) Bool))
(defn params-ok (params)
  (match params
    ((Sym _ _) true)
    ((Lst items _) (all-names items))
    (else false)))

;; Whether every form in `forms` is a symbol.
(sig all-names (Fn ((List Form)) Bool))
(defn all-names (forms) (all (fn (f) (!= (sym-name f) "")) forms))

;; The let bindings for a macro's parameters: (p args) for a bare name, (p1 (at args 0))
;; ... for a parameter list.
(sig param-binds (Fn (Form Form Pos) (List Form)))
(defn param-binds (params args pos)
  (if (= (sym-name params) "")
    (arg-binds (list-items params) args pos)
    (List (Lst (List params args) pos))))

(sig arg-binds (Fn ((List Form) Form Pos) (List Form)))
(defn arg-binds (params args pos)
  (map
    (fn (ip) (let (((i p) ip)) (Lst (List p (Lst (List (Sym "at" pos) args (IntLit i pos)) pos)) pos)))
    (zip (range 0 (len params)) params)))

;; The name of the function a macro is compiled into.
(sig macro-fn (Fn (String) String))
(defn macro-fn (name) (++ "macro__" name))

;; True, unless two of `defs` define the same macro.
(sig unique-names (Fn ((List Form) (Map String Builtin) (Map String Bool)) Bool))
(defn unique-names (defs builtins start)
  (let ((_seen
          (fold
            (fn (seen d)
              (let ((name (sym-name (at (defmacro-items d builtins) 1))))
                (if (map.has seen name)
                  (fail (format "{(pos-text (form-pos d))}defmacro: {name} is defined twice"))
                  (map.set seen name true))))
            start
            defs)))
    true))

;; The macro each of `defs` defines, with its function from `run-of` (by its defn's name).
(sig macro-list (Fn ((List Form) (Fn (String) (Fn ((List Form)) Form))) (List Macro)))
(defn macro-list (defs run-of)
  (map
    (fn (d)
      (let ((items (list-items d))
            (name (sym-name (at items 1)))
            (params (at items 2))
            (arity (if (= (sym-name params) "") (len (list-items params)) -1))
            (run (run-of (macro-fn name))))
        (Macro name arity run (form-pos d))))
    defs))

;; --- expanding ---

(sig expand-all (Fn ((List Form) (Map String Macro)) (List Form)))
(defn expand-all (forms macros) (map (fn (f) (expand-form f macros)) forms))

;; `form` with its macro calls expanded: a call is replaced by its expansion, again until
;; the head isn't a macro; then the parts are expanded. Names being bound (parameters, let
;; names, patterns) aren't calls, nor are types and quoted forms, so they are left alone:
;; analyse rejects binding a macro's name.
(sig expand-form (Fn (Form (Map String Macro)) Form))
(defn expand-form (form macros)
  (match form
    ((Lst items pos)
      (let ((head (if (= (len items) 0) "" (sym-name (at items 0)))))
        (cond
          ((map.has macros head)
            (expand-form (expand-call (map.at macros head) (rest items) pos) macros))
          ((contains head (List "sig" "deft" "private" "import" "import-macros" "quo" "quasi")) form)
          ((= head "defn") (Lst (expand-after items 3 macros) pos))
          ((= head "fn") (Lst (expand-after items 2 macros) pos))
          ((contains head (List "let" "match")) (Lst (expand-clauses head items macros) pos))
          (else (Lst (expand-all items macros) pos)))))
    (else form)))

;; `items` with the first `n` left as they are and the rest expanded.
(sig expand-after (Fn ((List Form) Int (Map String Macro)) (List Form)))
(defn expand-after (items n macros)
  (if (< (len items) n)
    items
    (++ (take n items) (expand-all (drop n items) macros))))

;; The items of (let ((name init)*) body) or (match e (pattern body)*): in a let binding
;; or a match clause the first item is a name or pattern.
(sig expand-clauses (Fn (String (List Form) (Map String Macro)) (List Form)))
(defn expand-clauses (head items macros)
  (cond
    ((and (= head "let") (= (len items) 3))
      (match (at items 1)
        ((Lst binds p)
          (List (at items 0) (Lst (each-clause binds 1 macros) p) (expand-form (at items 2) macros)))
        (else (expand-all items macros))))
    ((and (= head "match") (> (len items) 1))
      (++ (List (at items 0) (expand-form (at items 1) macros))
         (each-clause (drop 2 items) 1 macros)))
    (else (expand-all items macros))))

;; Each clause in `clauses` with its items after the first `n` expanded.
(sig each-clause (Fn ((List Form) Int (Map String Macro)) (List Form)))
(defn each-clause (clauses n macros) (map (fn (c) (expand-clause c n macros)) clauses))

(sig expand-clause (Fn (Form Int (Map String Macro)) Form))
(defn expand-clause (clause n macros)
  (match clause
    ((Lst items p) (Lst (expand-after items n macros) p))
    (else (expand-form clause macros))))

;; What `macro` returns for the arguments `args` of a call at `pos`.
(sig expand-call (Fn (Macro (List Form) Pos) Form))
(defn expand-call (macro args pos)
  (let ((arity (get macro arity))
        (where (format "{(pos-text pos)}{(get macro name)}: ")))
    (if (and (>= arity 0) (!= arity (len args)))
      (fail (format "{where}expected {arity} argument(s), got {(len args)}"))
      (stamp (call-macro (get macro run) args where) pos))))

;; `form` with `pos` on every form that is NOWHERE: an expansion's forms point at the
;; call, and those from its arguments keep their own positions.
(sig stamp (Fn (Form Pos) Form))
(defn stamp (form pos)
  (match form
    ((Lst items p) (Lst (stamp-all items pos) (if (= (get p line) 0) pos p)))
    (else (if (= (get (form-pos form) line) 0) (form-at form pos) form))))

;; The atom `form` (not a list) at `pos`.
(sig form-at (Fn (Form Pos) Form))
(defn form-at (form pos)
  (match form
    ((Sym v _) (Sym v pos))
    ((Txt v _) (Txt v pos))
    ((IntLit v _) (IntLit v pos))
    ((LongLit v _) (LongLit v pos))
    ((ByteLit v _) (ByteLit v pos))
    ((FloatLit v _) (FloatLit v pos))
    ((DoubleLit v _) (DoubleLit v pos))
    ((CharLit v _) (CharLit v pos))
    ((BoolLit v _) (BoolLit v pos))
    (else form)))

(sig stamp-all (Fn ((List Form) Pos) (List Form)))
(defn stamp-all (forms pos) (map (fn (f) (stamp f pos)) forms))
