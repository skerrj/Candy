;;; Emit: lowered statements as Python source text (the third step; the Python backend).
;;; Unlike the Python translator's emit_py.py (at tag self-host-py), which built Python's
;;; ast, this writes text, as smz's
;;; render.py did. Every operator gets parentheses, so precedence never matters.

(import form)
(import core)
(import lower)

;; Python names: top-level names (Candy name -> Python name), locals (Local id -> Python
;; name), and the Python names already taken where new locals are bound. `generic`: the
;; variants of generic sums. `spellings`: each built-in's Python text and kind (spelling.py).
;; `narrowed`: inside a match clause on a local, the local's id -> the match's temporary,
;; which Python has narrowed to the clause's variant (checking.narrowing), and the
;; variant's fields whose type has a type variable (`generic`'s).
(deft Env
  ((globals (Map String String))
   (locals (Map Int String))
   (taken (Map String Bool))
   (generic (Map String (List String)))
   (spellings (Map String (Tup String String String)))
   (narrowed (Map Int (Tup String (List String))))
   (fields (Map String (List CType)))))

(sig HEADER String)
(def HEADER "from __future__ import annotations

from collections.abc import Callable as _cdy_Callable, Mapping as _cdy_Mapping
from typing import Any as _cdy_Any, NamedTuple as _cdy_NamedTuple, cast as _cdy_cast
")

(sig comma-join (Fn ((List String)) String))
(defn comma-join (strs) (join strs ", "))

(sig line (Fn (Int String) String))
(defn line (level text) (++ (indent level) text "\n"))

;; --- Python spellings (doc/hl_rqmt/library.md, "The translator's built-ins become Candy") ---

;; One level of Python indentation: four spaces, as PEP 8 has it.
(sig INDENT_STEP String)
(def INDENT_STEP "    ")

;; Indentation for nesting level `level`: `level` steps.
(sig indent (Fn (Int) String))
(defn indent (level) (if (<= level 0) "" (++ INDENT_STEP (indent (- level 1)))))

;; The modules every generated file imports: those spelling.py's spellings refer to.
(sig PY_IMPORTS (List String))
(def PY_IMPORTS (List "math" "re" "cdy_rt.spelling" "cdy_rt.primitives"))

;; The names `names` as a set (each mapped to true).
(sig name-set (Fn ((List String)) (Map String Bool)))
(defn name-set (names) (fold (fn (acc n) (map-set acc n true)) empty-map names))

;; Python names a Candy name must not take: Python's keywords and built-ins (Python 3.14's
;; `keyword.kwlist` and `dir(builtins)`), and the modules generated code imports.
(sig PY_RESERVED (Map String Bool))
(def PY_RESERVED
  (name-set
    (++
      (List
    "ArithmeticError" "AssertionError" "AttributeError" "BaseException"
    "BaseExceptionGroup" "BlockingIOError" "BrokenPipeError" "BufferError"
    "BytesWarning" "ChildProcessError" "ConnectionAbortedError" "ConnectionError"
    "ConnectionRefusedError" "ConnectionResetError" "DeprecationWarning" "EOFError"
    "Ellipsis" "EncodingWarning" "EnvironmentError" "Exception" "ExceptionGroup" "False"
    "FileExistsError" "FileNotFoundError" "FloatingPointError" "FutureWarning"
    "GeneratorExit" "IOError" "ImportError" "ImportWarning" "IndentationError"
    "IndexError" "InterruptedError" "IsADirectoryError" "KeyError" "KeyboardInterrupt"
    "LookupError" "MemoryError" "ModuleNotFoundError" "NameError" "None"
    "NotADirectoryError" "NotImplemented" "NotImplementedError" "OSError"
    "OverflowError" "PendingDeprecationWarning" "PermissionError" "ProcessLookupError"
    "PythonFinalizationError" "RecursionError" "ReferenceError" "ResourceWarning"
    "RuntimeError" "RuntimeWarning" "StopAsyncIteration" "StopIteration" "SyntaxError"
    "SyntaxWarning" "SystemError" "SystemExit" "TabError" "TimeoutError" "True"
    "TypeError" "UnboundLocalError" "UnicodeDecodeError" "UnicodeEncodeError"
    "UnicodeError" "UnicodeTranslateError" "UnicodeWarning" "UserWarning" "ValueError"
    "Warning" "ZeroDivisionError" "_IncompleteInputError" "__build_class__" "__debug__"
    "__doc__" "__import__" "__loader__" "__name__" "__package__" "__spec__" "abs"
    "aiter" "all" "and" "anext" "any" "as" "ascii" "assert" "async" "await" "bin" "bool"
    "break" "breakpoint" "bytearray" "bytes" "callable" "chr" "class" "classmethod"
    "compile" "complex" "continue" "copyright" "credits" "def" "del" "delattr" "dict"
    "dir" "divmod" "elif" "else" "enumerate" "eval" "except" "exec" "exit" "filter"
    "finally" "float" "for" "format" "from" "frozenset" "getattr" "global" "globals"
    "hasattr" "hash" "help" "hex" "id" "if" "import" "in" "input" "int" "is"
    "isinstance" "issubclass" "iter" "lambda" "len" "license" "list" "locals" "map"
    "max" "memoryview" "min" "next" "nonlocal" "not" "object" "oct" "open" "or" "ord"
    "pass" "pow" "print" "property" "quit" "raise" "range" "repr" "return" "reversed"
    "round" "set" "setattr" "slice" "sorted" "staticmethod" "str" "sum" "super" "try"
    "tuple" "type" "vars" "while" "with" "yield" "zip")
      (List "math" "re" "cdy_rt"))))

;; The characters py-mangle spells as letters.
(sig MANGLED (Map String String))
(def MANGLED (map-set (map-set (map-set empty-map "-" "_") "?" "_p") "!" "_x"))

;; A Candy name as a Python identifier: `-` to `_`, `?` to `_p`, `!` to `_x`, any other
;; character but an ASCII letter, digit or `_` to `_uXXXX`; a reserved name, or one
;; starting `_cdy_`, gets a trailing `_`.
(sig py-mangle (Fn (String) String))
(defn py-mangle (name)
  (let ((out (mangle-chars name 0 "")))
    (if (or (map-has PY_RESERVED out) (starts-with out "_cdy_")) (++ out "_") out)))

(sig mangle-chars (Fn (String Int String) String))
(defn mangle-chars (name i acc)
  (if (= i (str-len name))
    acc
    (mangle-chars name (+ i 1) (++ acc (mangle-char (substring name i (+ i 1)))))))

(sig mangle-char (Fn (String) String))
(defn mangle-char (ch)
  (cond
    ((or (<= "a" ch "z") (<= "A" ch "Z") (<= "0" ch "9") (= ch "_")) ch)
    ((map-has MANGLED ch) (map-get MANGLED ch))
    (else (++ "_u" (hex (char-code ch) 4)))))

(sig HEX_DIGITS String)
(def HEX_DIGITS "0123456789abcdef")

;; `n` (not negative) in lower-case hexadecimal, with at least `width` digits.
(sig hex (Fn (Int Int) String))
(defn hex (n width)
  (let ((digit (substring HEX_DIGITS (- n (* 16 (quot n 16))) (+ (- n (* 16 (quot n 16))) 1))))
    (if (and (< n 16) (<= width 1)) digit (++ (hex (quot n 16) (- width 1)) digit))))

;; The string `s` as a Python literal, as Python's repr writes it: in single quotes, or in
;; double quotes if it has a single quote and no double quote; the quote, backslash,
;; newline, return and tab escaped, and other control characters as `\xhh`. Unlike repr, it
;; leaves other characters as they are (backlog [[B74]]).
(sig py-str (Fn (String) String))
(defn py-str (s)
  (let ((q (if (and (str-contains "'" s) (not (str-contains "\"" s))) "\"" "'")))
    (++ q (escape-chars s q 0 "") q)))

(sig escape-chars (Fn (String String Int String) String))
(defn escape-chars (s q i acc)
  (if (= i (str-len s))
    acc
    (escape-chars s q (+ i 1) (++ acc (escape-char (substring s i (+ i 1)) q)))))

(sig escape-char (Fn (String String) String))
(defn escape-char (ch q)
  (let ((code (char-code ch)))
    (cond
      ((or (= ch q) (= ch "\\")) (++ "\\" ch))
      ((= ch "\n") "\\n")
      ((= ch "\r") "\\r")
      ((= ch "\t") "\\t")
      ((or (< code 32) (<= 127 code 160)) (++ "\\x" (hex code 2)))
      (else ch))))

;; --- names ---

(sig global-names (Fn ((List Top) Env) Env))
(defn global-names (tops start)
  (fold (fn (env top) (add-globals (top-names-of top) env)) start tops))

(sig add-globals (Fn ((List String) Env) Env))
(defn add-globals (names start)
  (fold
    (fn (env name)
      (let ((py (py-mangle name)))
        (if (and (map-has (get env taken) py) (not (map-has (get env globals) name)))
          (fail
            (format
              "{(candy-name (holder py (map-keys (get env globals)) (get env globals)))} and {(candy-name name)} are one name in Python ({py})"))
          (assoc env
            globals (map-set (get env globals) name py)
            taken (map-set (get env taken) py true)))))
    start
    names))

;; The Candy name in `names` whose Python name in `globals` is `py`.
(sig holder (Fn (String (List String) (Map String String)) String))
(defn holder (py names globals)
  (with-default py (find (fn (n) (= (map-get globals n) py)) names)))

;; A top-level name as its program wrote it: `util__greet`, module `util`'s `greet`, is
;; `greet (from module util)` (a name can't hold `__`, so the first `__` ends the module's
;; prefix).
(sig candy-name (Fn (String) String))
(defn candy-name (name)
  (let ((parts (split name "__"))
        (own (join (rest parts) "__")))
    (if (= (len parts) 1) name (format "{own} (from module {(at parts 0)})"))))

;; A top-level name without its module's prefix: `util__greet` is `greet`.
(sig own-name (Fn (String) String))
(defn own-name (name)
  (let ((parts (split name "__")))
    (if (= (len parts) 1) name (join (rest parts) "__"))))

;; The top-level names a definition makes: a sum makes its type and its variants.
(sig top-names-of (Fn (Top) (List String)))
(defn top-names-of (top)
  (match top
    ((TDeftSum name _ variants) (++ (List name) (variant-list-names variants)))
    (else (if (= (top-name top) "") empty-list (List (top-name top))))))

(sig variant-list-names (Fn ((List Variant)) (List String)))
(defn variant-list-names (variants) (map (fn (v) (get v name)) variants))

(sig top-name (Fn (Top) String))
(defn top-name (top)
  (match top
    ((TDeft name _ _) name)
    ((TDef name _ _ _) name)
    ((TDefn name _ _ _ _) name)
    (else "")))

;; The variants of the generic sums in `tops`, each with its fields whose
;; type has a type variable.
(sig generic-variants (Fn ((List Top)) (Map String (List String))))
(defn generic-variants (tops)
  (fold (fn (m top) (generic-sum top m)) empty-map tops))

(sig generic-sum (Fn (Top (Map String (List String))) (Map String (List String))))
(defn generic-sum (top acc)
  (match top
    ((TDeftSum _ tvars variants)
      (if (= (len tvars) 0)
        acc
        (fold (fn (m v) (map-set m (get v name) (generic-fields (get v fields)))) acc variants)))
    (else acc)))

;; The field types of each record and variant in `tops`, and each sum's variants (as
;; types): what `show-type` looks into for a function.
(sig deft-field-types (Fn ((List Top)) (Map String (List CType))))
(defn deft-field-types (tops)
  (fold (fn (m top) (top-field-types top m)) empty-map tops))

(sig top-field-types (Fn (Top (Map String (List CType))) (Map String (List CType))))
(defn top-field-types (top acc)
  (match top
    ((TDeft name _ fields) (map-set acc name (field-types fields)))
    ((TDeftSum name _ variants)
      (fold (fn (m v) (map-set m (get v name) (field-types (get v fields))))
        (map-set acc name (map (fn (v) (TCon (get v name) empty-list)) variants))
        variants))
    (else acc)))

(sig generic-fields (Fn ((List (Tup String CType))) (List String)))
(defn generic-fields (fields)
  (map (fn (f) (let (((name _t) f)) name)) (filter (fn (f) (let (((_name t) f)) (> (len (type-vars (List t) empty-list)) 0))) fields)))

;; A local's Python name, chosen when its scope was entered (bind-locals).
(sig local-py (Fn (String Int Env) String))
(defn local-py (name id env)
  (if (map-has (get env locals) id)
    (map-get (get env locals) id)
    (fail (format "internal error: emit: local {name} has no Python name"))))

;; Python names for locals bound in a new scope: each its own name, unless that is taken
;; here (by a top-level name, an enclosing local or an earlier local of this scope).
(sig bind-locals (Fn ((List Expr) Env) Env))
(defn bind-locals (locs start)
  (fold
    (fn (env loc)
      (match loc
        ((Local name id _ _)
          (if (map-has (get env locals) id)
            env
            (let ((base (py-mangle name))
                  (py (if (map-has (get env taken) base) (format "_cdy_{base}_{id}") base)))
              (assoc env
                locals (map-set (get env locals) id py)
                taken (map-set (get env taken) py true)))))
        (else env)))
    start
    locs))

;; The locals assigned in stmts, in order, after `start` (not looking inside nested
;; functions).
(sig bound-locals (Fn ((List Stmt) (List Expr)) (List Expr)))
(defn bound-locals (stmts start)
  (fold
    (fn (acc stmt)
      (match stmt
        ((SAssign target _)
          (match target
            ((Local _ _ _ _) (++ acc (List target)))
            (else acc)))
        ((SIf _ then other) (bound-locals other (bound-locals then acc)))
        ((SMatch _ _ cases default) (bound-in-cases cases (bound-in-lists default acc)))
        ((SLoop body) (bound-locals body acc))
        (else acc)))
    start
    stmts))

(sig bound-in-cases (Fn ((List Case) (List Expr)) (List Expr)))
(defn bound-in-cases (cases start)
  (fold (fn (acc c) (bound-locals (get c body) (++ acc (bind-locs (get c binds))))) start cases))

(sig bind-locs (Fn ((List (Tup String Expr))) (List Expr)))
(defn bind-locs (binds) (map (fn (b) (let (((_ loc) b)) loc)) binds))

(sig bound-in-lists (Fn ((List (List Stmt)) (List Expr)) (List Expr)))
(defn bound-in-lists (lists start)
  (fold (fn (acc stmts) (bound-locals stmts acc)) start lists))

;; --- expressions ---

(sig emit-expr (Fn (Expr Env) String))
(defn emit-expr (e env)
  (match e
    ((Lit form _) (emit-lit form))
    ((Local name id _ _) (local-py name id env))
    ((Global name _ _) (map-get (get env globals) name))
    ((Prim name pos t) (emit-prim name pos t env))
    ((Call callee args _ _) (emit-call callee args env))
    ((If test then other _ _)
      (format "({(emit-expr then env)} if {(emit-expr test env)} else {(emit-expr other env)})"))
    ((Do _ _ _) (fail "internal error: emit: a do inside an expression (lower should have removed it)"))
    ((MatchE _ _ _ _ _) (fail "internal error: emit: a match inside an expression (lower should have removed it)"))
    ((Lambda params body _ _)
      (let ((inner (bind-locals params env)))
        (format "(lambda {(comma-join (emit-exprs params inner))}: {(emit-expr body inner)})")))
    ((Tuple items _ _)
      (let ((strs (emit-exprs items env)))
        (if (= (len strs) 1) (format "({(at strs 0)},)") (format "({(comma-join strs)})"))))
    ((ListOf items pos t) (emit-expr (Tuple items pos t) env))
    ((Fmt parts pos _) (emit-format parts pos env))
    ((Field obj field _ t) (emit-get obj field t env))
    ((Assoc obj fields _ _)
      (format "{(emit-obj obj env)}._replace({(comma-join (emit-fields fields env))})"))
    ((Temp id _) (format "_cdy_t{id}"))))

;; The record a get or assoc reads: a local narrowed in a match clause as the match's
;; temporary, which Python knows is the clause's variant; else the expression.
(sig emit-obj (Fn (Expr Env) String))
(defn emit-obj (obj env)
  (match obj
    ((Local _ id _ _) (if (map-has (get env narrowed) id) (let (((tmp _fields) (map-get (get env narrowed) id))) tmp) (emit-expr obj env)))
    (else (emit-expr obj env))))

;; A get: of a field with a type variable, on a local narrowed from a generic sum, cast to
;; the type the checker found, since mypy narrows `isinstance(t, N)` on a `T[int]` to
;; `N[Any]` (a cast of another field would be redundant, which mypy refuses).
(sig emit-get (Fn (Expr String CType Env) String))
(defn emit-get (obj field t env)
  (let ((text (format "{(emit-obj obj env)}.{(py-mangle field)}")))
    (match obj
      ((Local _ id _ _)
        (if (and (map-has (get env narrowed) id) (let (((_tmp fields) (map-get (get env narrowed) id))) (contains field fields)))
          (format "_cdy_cast('{(emit-type t env)}', {text})")
          text))
      (else text))))

;; A format string as a concatenation: literal text, and each hole as its text
;; (`emit-text`).
(sig emit-format (Fn ((List FPart) Pos Env) String))
(defn emit-format (parts pos env)
  (if (= (len parts) 0)
    "''"
    (format "({(join (emit-parts parts pos env) \" + \")})")))

(sig emit-parts (Fn ((List FPart) Pos Env) (List String)))
(defn emit-parts (parts pos env)
  (map
    (fn (p)
      (match p
        ((FText text) (py-str text))
        ((FHole e) (emit-text e pos env))))
    parts))

;; --- showing values (spec/60-library.md, library.show) ---

;; `e` as `text` (and so `put`) and a format hole write it (`text-of`).
(sig emit-text (Fn (Expr Pos Env) String))
(defn emit-text (e pos env) (text-of (emit-expr e env) (get e t) pos env))

;; The Python text `x`, of type `t`, as `text` writes it: a String or a Char as its text,
;; an Int as Python's str, anything else shown by its type (`show-type`), and a value
;; typed Any shown from its Python value (cdy_rt's text_any).
(sig text-of (Fn (String CType Pos Env) String))
(defn text-of (x t pos env)
  (let ((name (match t ((TCon name _) name) (else ""))))
    (cond
      ((contains name (List "String" "Char")) x)
      ((= name "Int") (format "str({x})"))
      ((= name "Any") (format "cdy_rt.primitives.text_any({x})"))
      (else (show-call x t pos env)))))

(sig show-call (Fn (String CType Pos Env) String))
(defn show-call (x t pos env) (format "cdy_rt.primitives.show({x}, {(show-type t pos env)})"))

;; The type `t` as cdy_rt's show reads it (its ShowType): a type's name, or a tuple of its
;; name and its arguments' types. A function can't be shown, nor a record holding one
;; among its fields, nor a value whose type is a type variable, *for now*: a generic
;; function can show its type variables' values once interfaces let it say so.
(sig show-type (Fn (CType Pos Env) String))
(defn show-type (t pos env)
  (match t
    ((TCon name args)
      (cond
        ((holds-fn name env (List name))
          (fail (++ (pos-text pos) (format "show: a function can't be shown, and {name} holds one"))))
        ((= (len args) 0) (py-str name))
        (else (format "({(comma-join (++ (List (py-str name)) (map (fn (a) (show-type a pos env)) args)))})"))))
    ((TFn _ _) (fail (++ (pos-text pos) "show: a function can't be shown")))
    ((TVar name)
      (let ((shown (if (starts-with name "?") (++ "t" (substring name 1 (str-len name))) name)))
        (fail (++ (pos-text pos) (format "show: can't show a value of type {shown}, a type variable")))))))

;; Whether the record or variant `name` has a field whose type is, or holds, a function, or
;; the sum `name` a variant that does; its type variables, which its arguments give, are
;; looked at by `show-type`. `seen` holds the types already looked into.
(sig holds-fn (Fn (String Env (List String)) Bool))
(defn holds-fn (name env seen)
  (and (map-has (get env fields) name)
       (any (fn (t) (field-holds-fn t env seen)) (map-get (get env fields) name))))

(sig field-holds-fn (Fn (CType Env (List String)) Bool))
(defn field-holds-fn (t env seen)
  (match t
    ((TFn _ _) true)
    ((TCon name args)
      (or (any (fn (a) (field-holds-fn a env seen)) args)
          (and (not (contains name seen)) (holds-fn name env (++ seen (List name))))))
    (else false)))

;; A record's or variant's field type as cdy_rt's show reads it: its type variable `a` as
;; "'a", to be bound to the type's arguments; a function as "Fn", which show refuses.
(sig field-show-type (Fn (CType) String))
(defn field-show-type (t)
  (match t
    ((TCon name args)
      (if (= (len args) 0)
        (py-str name)
        (format "({(comma-join (++ (List (py-str name)) (map field-show-type args)))})")))
    ((TFn _ _) (py-str "Fn"))
    ((TVar name) (py-str (++ "'" name)))))

;; The line registering a record's or variant's class for show: its Candy name, its type's
;; type variables, its fields' types.
(sig register-line (Fn (String String (List String) (List (Tup String CType)) Int Env) String))
(defn register-line (name shown tvars fields level env)
  (line level
    (format "cdy_rt.primitives.register_type({(map-get (get env globals) name)}, {(py-str shown)}, {(py-tuple (map py-str tvars))}, {(py-tuple (map (fn (f) (let (((_name t) f)) (field-show-type t))) fields))})")))

;; Python's text for a tuple of the texts `items`: `()`, `(a,)`, `(a, b)`.
(sig py-tuple (Fn ((List String)) String))
(defn py-tuple (items) (if (= (len items) 1) (format "({(at items 0)},)") (format "({(comma-join items)})")))

(sig emit-fields (Fn ((List (Tup String Expr)) Env) (List String)))
(defn emit-fields (fields env)
  (map (fn (fv) (let (((f v) fv)) (format "{(py-mangle f)}={(emit-expr v env)}"))) fields))

(sig emit-exprs (Fn ((List Expr) Env) (List String)))
(defn emit-exprs (exprs env) (map (fn (e) (emit-expr e env)) exprs))

(sig emit-lit (Fn (Form) String))
(defn emit-lit (form)
  (match form
    ((Txt v _) (py-str v))
    ((CharLit v _) (py-str (format "{v}")))
    ((IntLit v _) (format "{v}"))
    ((LongLit v _) (format "{v}"))
    ((ByteLit v _) (format "{v}"))
    ((FloatLit v _) (format "{v}"))
    ((DoubleLit v _) (format "{v}"))
    ((BoolLit v _) (if v "True" "False"))
    (else (fail "internal error: emit: not a literal"))))

(sig emit-prim (Fn (String Pos CType Env) String))
(defn emit-prim (name pos t env)
  (cond
    ((= name "show")
      (match t
        ((TFn params _) (format "(lambda _cdy_x: {(show-call \"_cdy_x\" (at params 0) pos env)})"))
        (else (fail (++ (pos-text pos) "show: its type isn't known here")))))
    ((= name "text")
      (match t
        ((TFn params _) (format "(lambda _cdy_x: {(text-of \"_cdy_x\" (at params 0) pos env)})"))
        (else (fail (++ (pos-text pos) "text: its type isn't known here")))))
    ((contains (spelling-kind (get env spellings) name) TYPED_KINDS) (spelling-py (get env spellings) name))
    ;; An operator as a value is its function (spelling.py; expr.operator-values).
    ((!= (spelling-value (get env spellings) name) "") (spelling-value (get env spellings) name))
    (else (fail (++ (pos-text pos) (format "the operator {name} can't be used as a value, for now; wrap it in a fn"))))))

(sig emit-call (Fn (Expr (List Expr) Env) String))
(defn emit-call (callee args env)
  (let ((strs (emit-exprs args env)))
    (match callee
      ((Prim name pos _)
        (cond
          ((= name "text") (emit-text (at args 0) pos env))
          ((= name "show") (show-call (at strs 0) (get (at args 0) t) pos env))
          (else (emit-prim-call name args strs env))))
      (else (format "{(emit-expr callee env)}({(comma-join strs)})")))))

;; Whether `e` is an index literal that can't be negative, so `at` needs no check of it:
;; Python's subscript fails on the high side by itself (library.bounds).
(sig is-index-literal (Fn (Expr) Bool))
(defn is-index-literal (e)
  (match e
    ((Lit form _) (match form ((IntLit v _) (>= v 0)) (else false)))
    (else false)))

(sig emit-prim-call (Fn (String (List Expr) (List String) Env) String))
(defn emit-prim-call (name args strs env)
  (let ((kind (spelling-kind (get env spellings) name))
        (py (spelling-py (get env spellings) name))
        (op (++ " " py " ")))
    (cond
      ((contains kind (List "binop" "compare" "boolop")) (format "({(join strs op)})"))
      ((= kind "unary") (format "({py} {(at strs 0)})"))
      ((and (= kind "index") (is-index-literal (at args 1))) (format "{(at strs 0)}[{(at strs 1)}]"))
      (else (format "{py}({(comma-join strs)})")))))

;; --- types ---

;; A type's Python text; a variable the checker never solved (`?N`) is Any.
(sig emit-type (Fn (CType Env) String))
(defn emit-type (t env)
  (match t
    ((TVar name)
      (cond
        ((starts-with name "?") "_cdy_Any")
        ((= (constraint-of name) "integer") "int")
        ((= (constraint-of name) "float") "float")
        (else (py-mangle name))))
    ((TFn params ret)
      (format "_cdy_Callable[[{(comma-join (emit-types params env))}], {(emit-type ret env)}]"))
    ((TCon name args) (emit-tcon name (emit-types args env) (get env spellings)))))

(sig emit-types (Fn ((List CType) Env) (List String)))
(defn emit-types (types env) (map (fn (t) (emit-type t env)) types))

;; A built-in type's spelling.py entry (kind "type") is its Python text, with `{}` for its
;; arguments; `Tup` isn't declared (system.cdy), and a program's own type is its name.
(sig emit-tcon (Fn (String (List String) (Map String (Tup String String String))) String))
(defn emit-tcon (name args spellings)
  (cond
    ((= (spelling-kind spellings name) "type") (replace (spelling-py spellings name) "{}" (comma-join args)))
    ((= name "Tup") (format "tuple[{(comma-join args)}]"))
    ((= (len args) 0) (py-mangle name))
    (else (format "{(py-mangle name)}[{(comma-join args)}]"))))

;; The type variables in the types, in order of first use, without repeats, after `start`.
(sig type-vars (Fn ((List CType) (List String)) (List String)))
(defn type-vars (types start)
  (fold
    (fn (acc t)
      (match t
        ((TVar name) (if (contains name acc) acc (++ acc (List name))))
        ((TCon _ args) (type-vars args acc))
        ((TFn params ret) (type-vars (++ params (List ret)) acc))))
    start
    types))

;; --- statements ---

(sig emit-stmt (Fn (Stmt Int Env) String))
(defn emit-stmt (s level env)
  (match s
    ((SRecord name tvars fields)
      (let ((checked (check-py-fields (format "deft {(candy-name name)}") fields empty-map)))
        (++ "\n"
           (line level
             (format "class {(map-get (get env globals) name)}{(type-params tvars)}(_cdy_NamedTuple):"))
           (emit-record-fields fields (+ level 1) env)
           (eq-methods (+ level 1))
           (register-line name (own-name name) tvars fields level env))))
    ((SSum name tvars variants)
      (++ (emit-variants name variants tvars level env)
         (line level
           (format "type {(map-get (get env globals) name)}{(type-params tvars)} = {(join (variant-refs variants tvars env) \" | \")}"))))
    ((SMatch temp subject cases default)
      (let ((t (emit-expr temp env))
            (val (emit-expr subject env))
            (generic (map-has (get env generic) (get (at cases 0) variant))))
        (++ (line level (if generic (format "{t} = {val}") (format "{t}: object = {val}")))
           (emit-match t cases default (and (not generic) (= (len default) 0)) "if" level env subject))))
    ((SLoop body) (++ (line level "while True:") (emit-block body (+ level 1) env)))
    ((SRebind targets vals)
      (line level
        (if (= (len targets) 1)
          (format "{(emit-expr (at targets 0) env)} = {(emit-expr (at vals 0) env)}")
          (format "{(comma-join (emit-exprs targets env))} = ({(comma-join (emit-exprs vals env))})"))))
    ((SContinue) (line level "continue"))
    ((SAssign target val)
      (line level (format "{(emit-expr target env)}{(lambda-annotation target val env)} = {(emit-expr val env)}")))
    ((SDefAssign name val t)
      (line level
        (format "{(map-get (get env globals) name)}: {(emit-type t env)} = {(emit-expr val env)}")))
    ((SExpr e) (line level (emit-expr e env)))
    ((SReturn e) (line level (format "return {(emit-expr e env)}")))
    ((SIf test then other) (emit-if "if" test then other level env))
    ((SFunc name params body t) (emit-func name params body t level env))
    ((SLocalFunc target params body t)
      (let ((inner (bind-locals (++ params (bound-locals body empty-list)) env)))
        (match t
          ((TFn types ret)
            (++ (line level
                 (format "def {(emit-expr target env)}({(comma-join (emit-params params types inner empty-list))}) -> {(emit-type ret env)}:"))
               (emit-block body (+ level 1) inner)))
          ;; Unchecked (macro code, [[B42]]): Any.
          (else
            (++ (line level
                 (format "def {(emit-expr target env)}({(comma-join (emit-any-params params inner))}) -> _cdy_Any:"))
               (emit-block body (+ level 1) inner))))))))

;; A local bound to a fn (a Python lambda) is annotated with the fn's type, which mypy
;; can't infer from a lambda alone; anything else, "".
(sig lambda-annotation (Fn (Expr Expr Env) String))
(defn lambda-annotation (target val env)
  (match target
    ((Local _ _ _ _)
      (match val
        ((Lambda _ _ _ t)
          (match t
            ((TFn _ _) (format ": {(emit-type t env)}"))
            (else "")))
        (else "")))
    (else "")))

;; An if statement, or (`keyword` "elif") the rest of one. An else holding just an if
;; becomes an elif, so that a long cond doesn't nest one level deeper per clause (Python
;; allows 100).
(sig emit-if (Fn (String Expr (List Stmt) (List Stmt) Int Env) String))
(defn emit-if (keyword test then other level env)
  (++ (line level (format "{keyword} {(emit-expr test env)}:"))
     (emit-block then (+ level 1) env)
     (cond
       ((= (len other) 0) "")
       ((= (len other) 1)
         (match (at other 0)
           ((SIf test2 then2 other2) (emit-if "elif" test2 then2 other2 level env))
           (else (++ (line level "else:") (emit-block other (+ level 1) env)))))
       (else (++ (line level "else:") (emit-block other (+ level 1) env))))))

(sig emit-any-params (Fn ((List Expr) Env) (List String)))
(defn emit-any-params (params env) (map (fn (p) (format "{(emit-expr p env)}: _cdy_Any")) params))

;; PEP 695 type parameters: "" or "[a, b]".
(sig type-params (Fn ((List String)) String))
(defn type-params (tvars)
  (let ((params (filter (fn (v) (not (contains (constraint-of v) (List "integer" "float")))) tvars)))
    (if (= (len params) 0) "" (format "[{(comma-join (map type-param params))}]"))))

;; A type parameter: a constraint variable's (checking.constraints) with the Python types
;; it takes, a constrained type variable; `integer` and `float` are each one Python type,
;; so they aren't parameters (emit-type writes `int`, `float`).
(sig type-param (Fn (String) String))
(defn type-param (v)
  (let ((c (constraint-of v))
        (takes
          (cond
            ((= c "number") "(int, float)")
            ((= c "comparable") "(int, float, str)")
            ((= c "appendable") "(str, tuple[_cdy_Any, ...])")
            (else ""))))
    (if (= takes "") (py-mangle v) (format "{(py-mangle v)}: {takes}"))))

;; A record's or variant's equality (spec/40-expressions.md, expr.equality): a NamedTuple
;; compares as a plain tuple, so two variants with equal fields would be equal (B137);
;; these compare the class too, and hash it, so Python's own == (in `in`, `index-of`, a
;; map's keys) is Candy's `=`.
(sig eq-methods (Fn (Int) String))
(defn eq-methods (level)
  (++ (line level "def __eq__(self, other: object) -> bool:")
     (line (+ level 1) "return type(self) is type(other) and tuple.__eq__(self, other)")
     (line level "def __ne__(self, other: object) -> bool:")
     (line (+ level 1) "return not self == other")
     (line level "def __hash__(self) -> int:")
     (line (+ level 1) "return hash((type(self), tuple(self)))")))

(sig emit-record-fields (Fn ((List (Tup String CType)) Int Env) String))
(defn emit-record-fields (fields level env)
  (join (map (fn (ft) (let (((f t) ft)) (line level (format "{(py-mangle f)}: {(emit-type t env)}")))) fields) ""))

;; Fail unless a record's or variant's fields are Python fields: no two are one Python name,
;; and none starts with `_`, which NamedTuple forbids (for now, a leak: B113). `owner` names
;; them for the errors ("deft V", or "deft S, variant A"); `seen` maps each Python name so
;; far to its field.
(sig check-py-fields (Fn (String (List (Tup String CType)) (Map String String)) Bool))
(defn check-py-fields (owner fields start)
  (let ((_seen
          (fold
            (fn (seen ft)
              (let (((f _t) ft)
                    (py (py-mangle f)))
                (cond
                  ((map-has seen py)
                    (fail (format "{owner}: fields {(map-get seen py)} and {f} are one name in Python ({py})")))
                  ((= (substring py 0 1) "_")
                    (fail (format "{owner}: field {f} can't start with _ in Python ({py})")))
                  (else (map-set seen py f)))))
            start
            fields)))
    true))

;; --- sums and match ---

;; The type variables of the sum that a variant's fields use, in the sum's order.
(sig used-tvars (Fn ((List String) (List String)) (List String)))
(defn used-tvars (tvars used) (filter (fn (v) (contains v used)) tvars))

(sig field-types (Fn ((List (Tup String CType))) (List CType)))
(defn field-types (fields) (map (fn (f) (let (((_ t) f)) t)) fields))

(sig variant-tvars (Fn (Variant (List String)) (List String)))
(defn variant-tvars (v tvars)
  (used-tvars tvars (type-vars (field-types (get v fields)) empty-list)))

;; One NamedTuple class per variant, its fields and `eq-methods`.
(sig emit-variants (Fn (String (List Variant) (List String) Int Env) String))
(defn emit-variants (sum variants tvars level env)
  (join
    (map
      (fn (v)
        (let ((checked (check-py-fields (format "deft {(candy-name sum)}, variant {(own-name (get v name))}") (get v fields) empty-map))
              (head (format "class {(map-get (get env globals) (get v name))}{(type-params (variant-tvars v tvars))}(_cdy_NamedTuple):"))
              (body (++ (emit-record-fields (get v fields) (+ level 1) env) (eq-methods (+ level 1))))
              (register (register-line (get v name) (own-name (get v name)) tvars (get v fields) level env)))
          (++ "\n" (line level head) body register)))
      variants)
    ""))

;; Each variant as a member of the sum's union: `Leaf`, `Node[a]`.
(sig variant-refs (Fn ((List Variant) (List String) Env) (List String)))
(defn variant-refs (variants tvars env)
  (map (fn (v) (++ (map-get (get env globals) (get v name)) (type-params (variant-tvars v tvars)))) variants))

;; match as an isinstance chain on the temporary `subj` (mypy keeps generic type arguments
;; that way), each named field bound by attribute. The temporary is typed object unless the
;; sum is generic, which keeps mypy fast (doc/hl_rqmt/sum_types.md); then, with no else clause,
;; the last case is an else that asserts its variant (`assert-last`). In each case a local
;; `subject` is narrowed (`case-env`); not in the else clause.
(sig emit-match (Fn (String (List Case) (List (List Stmt)) Bool String Int Env Expr) String))
(defn emit-match (subj cases default assert-last keyword level env subject)
  (cond
    ((= (len cases) 0)
      (if (= (len default) 0)
        ""
        (++ (line level "else:") (emit-block (at default 0) (+ level 1) env))))
    ((and assert-last (= (len cases) 1))
      (let ((c (at cases 0))
            (cenv (case-env subject subj (get c variant) env))
            (inner (if (= keyword "if") level (+ level 1))))
        (++ (if (= keyword "if") "" (line level "else:"))
           (line inner (format "assert isinstance({subj}, {(map-get (get env globals) (get c variant))})"))
           (emit-binds (get c binds) (get c variant) subj inner cenv)
           (emit-stmts (get c body) inner cenv))))
    (else
      (let ((c (at cases 0))
            (cenv (case-env subject subj (get c variant) env))
            (test (format "{keyword} isinstance({subj}, {(map-get (get env globals) (get c variant))}):"))
            (binds (emit-binds (get c binds) (get c variant) subj (+ level 1) cenv))
            (body (if (= (len (get c body)) 0)
                    (if (= binds "") (line (+ level 1) "pass") "")
                    (emit-stmts (get c body) (+ level 1) cenv))))
        (++ (line level test) binds body
           (emit-match subj (rest cases) default assert-last "elif" level env subject))))))

;; `env` in a case of `variant`: a local `subject` narrowed to the temporary `subj`.
(sig case-env (Fn (Expr String String Env) Env))
(defn case-env (subject subj variant env)
  (match subject
    ((Local _ id _ _)
      (let ((fields (if (map-has (get env generic) variant) (map-get (get env generic) variant) empty-list)))
        (assoc env narrowed (map-set (get env narrowed) id (Tup subj fields)))))
    (else env)))

;; A clause's fields, each read into its name. A generic variant's names are annotated
;; with the types the checker found: mypy narrows `isinstance(x, Some)` on a `Maybe[a]` to
;; `Some[Any]`, so the field it reads is Any.
(sig emit-binds (Fn ((List (Tup String Expr)) String String Int Env) String))
(defn emit-binds (binds variant subj level env)
  (join
    (map
      (fn (b)
        (let (((f loc) b)
              (note (if (map-has (get env generic) variant) (format ": {(emit-type (get loc t) env)}") "")))
          (line level (format "{(emit-expr loc env)}{note} = {subj}.{(py-mangle f)}"))))
      binds)
    ""))

(sig emit-stmts (Fn ((List Stmt) Int Env) String))
(defn emit-stmts (stmts level env) (join (map (fn (st) (emit-stmt st level env)) stmts) ""))

(sig emit-block (Fn ((List Stmt) Int Env) String))
(defn emit-block (stmts level env)
  (if (= (len stmts) 0) (line level "pass") (emit-stmts stmts level env)))

(sig emit-params (Fn ((List Expr) (List CType) Env (List String)) (List String)))
(defn emit-params (params types env acc)
  (if (= (len params) 0)
    acc
    (emit-params
      (rest params)
      (rest types)
      env
      (++ acc (List (emit-param (at params 0) (at types 0) env))))))

;; `name: T`, or a rest parameter's `*name: T`, T its items' type (types.rest).
(sig emit-param (Fn (Expr CType Env) String))
(defn emit-param (param t env)
  (if (is-rest t)
    (format "*{(emit-expr param env)}: {(emit-type (at (rest-item t) 0) env)}")
    (format "{(emit-expr param env)}: {(emit-type t env)}")))

;; A top-level function: its locals start afresh, since a local's id is unique only in its
;; module, and the program's top-level locals (every module's, bound in `python-of`) aren't
;; in its scope (B154).
(sig emit-func (Fn (String (List Expr) (List Stmt) CType Int Env) String))
(defn emit-func (name params body t level env)
  (match t
    ((TFn types ret)
      (let ((inner (bind-locals (++ params (bound-locals body empty-list)) (assoc env locals empty-map)))
            (tvars (type-vars (++ types (List ret)) empty-list))
            (tparams (type-params tvars))
            (args (comma-join (emit-params params types inner empty-list))))
        (++ "\n"
           (line level
             (format "def {(map-get (get env globals) name)}{tparams}({args}) -> {(emit-type ret env)}:"))
           (emit-block body (+ level 1) inner))))
    (else (fail (format "defn {name}: its sig must be a function type")))))

;; --- module ---

(sig emit-imports (Fn ((List String)) String))
(defn emit-imports (modules) (join (map (fn (m) (format "import {m}\n")) modules) ""))

;; Run `main` when the module is run, not imported (see has-main in core.cdy).
(sig emit-main (Fn (Env) String))
(defn emit-main (env)
  (let ((name (map-get (get env globals) "main")))
    (format "\n\nif __name__ == \"__main__\":\n{(indent 1)}cdy_rt.primitives.run_main({name})\n")))
