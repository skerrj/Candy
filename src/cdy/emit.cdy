;;; Emit: lowered statements as Python source text (the third step; the Python backend).
;;; Unlike the Python translator's emit_py.py (at tag self-host-py), which built Python's
;;; ast, this writes text, as smz's
;;; render.py did. Every operator gets parentheses, so precedence never matters.

(import form)
(import core)
(import lower)

;; Python names: top-level names (Candy name -> Python name), locals (Local id -> Python
;; name), and the Python names already taken where new locals are bound. `generic`: the
;; variants of generic sums. `spellings`: each built-in's Python text and kind (spelling.py).
(deft Env
  ((globals (Map String String))
   (locals (Map Int String))
   (taken (Map String Bool))
   (generic (Map String Bool))
   (spellings (Map String (Tup String String)))))

(sig HEADER String)
(def HEADER "from __future__ import annotations

from collections.abc import Callable as _cdy_Callable, Mapping as _cdy_Mapping
from typing import Any as _cdy_Any, NamedTuple as _cdy_NamedTuple
")

(sig comma-join (Fn ((List String)) String))
(defn comma-join (strs) (join strs ", "))

(sig line (Fn (Int String) String))
(defn line (level text) (+ (indent level) text "\n"))

;; --- Python spellings (doc/hl_rqmt/library.md, "The translator's built-ins become Candy") ---

;; One level of Python indentation: four spaces, as PEP 8 has it.
(sig INDENT_STEP String)
(def INDENT_STEP "    ")

;; Indentation for nesting level `level`: `level` steps.
(sig indent (Fn (Int) String))
(defn indent (level) (if (<= level 0) "" (+ INDENT_STEP (indent (- level 1)))))

;; The modules every generated file imports: those spelling.py's spellings refer to.
(sig PY_IMPORTS (List String))
(def PY_IMPORTS (tup "math" "re" "cdy_rt.spelling" "cdy_rt.primitives"))

;; The names `names` as a set (each mapped to true), added to `acc`.
(sig name-set (Fn ((List String) (Map String Bool)) (Map String Bool)))
(defn name-set (names acc)
  (if (= (len names) 0) acc (name-set (rest names) (map-set acc (at names 0) true))))

;; Python names a Candy name must not take: Python's keywords and built-ins (Python 3.14's
;; `keyword.kwlist` and `dir(builtins)`), and the modules generated code imports.
(sig PY_RESERVED (Map String Bool))
(def PY_RESERVED
  (name-set
    (+
      (tup
    "ArithmeticError" "AssertionError" "AttributeError" "BaseException"
    "BaseExceptionGroup" "BlockingIOError" "BrokenPipeError" "BufferError"
    "BytesWarning" "ChildProcessError" "ConnectionAbortedError" "ConnectionError"
    "ConnectionRefusedError" "ConnectionResetError" "DeprecationWarning" "EOFError"
    "Ellipsis" "EncodingWarning" "EnvironmentError" "Exception" "ExceptionGroup" "False"
    "FileExistsError" "FileNotFoundError" "FloatingPointError" "FutureWarning"
    "GeneratorExit" "IOError" "ImportError" "ImportWarning" "IndentationError"
    "IndexError" "InterruptedError" "IsADirectoryError" "KeyError" "KeyboardInterrupt"
    "LookupError" "MemoryError" "ModuleNotFoundError" "NameError" "None"
    "NotADirectoryError" "NotImplemented" "NotImplementedError" "OSError"
    "OverflowError" "PendingDeprecationWarning" "PermissionError" "ProcessLookupError"
    "PythonFinalizationError" "RecursionError" "ReferenceError" "ResourceWarning"
    "RuntimeError" "RuntimeWarning" "StopAsyncIteration" "StopIteration" "SyntaxError"
    "SyntaxWarning" "SystemError" "SystemExit" "TabError" "TimeoutError" "True"
    "TypeError" "UnboundLocalError" "UnicodeDecodeError" "UnicodeEncodeError"
    "UnicodeError" "UnicodeTranslateError" "UnicodeWarning" "UserWarning" "ValueError"
    "Warning" "ZeroDivisionError" "_IncompleteInputError" "__build_class__" "__debug__"
    "__doc__" "__import__" "__loader__" "__name__" "__package__" "__spec__" "abs"
    "aiter" "all" "and" "anext" "any" "as" "ascii" "assert" "async" "await" "bin" "bool"
    "break" "breakpoint" "bytearray" "bytes" "callable" "chr" "class" "classmethod"
    "compile" "complex" "continue" "copyright" "credits" "def" "del" "delattr" "dict"
    "dir" "divmod" "elif" "else" "enumerate" "eval" "except" "exec" "exit" "filter"
    "finally" "float" "for" "format" "from" "frozenset" "getattr" "global" "globals"
    "hasattr" "hash" "help" "hex" "id" "if" "import" "in" "input" "int" "is"
    "isinstance" "issubclass" "iter" "lambda" "len" "license" "list" "locals" "map"
    "max" "memoryview" "min" "next" "nonlocal" "not" "object" "oct" "open" "or" "ord"
    "pass" "pow" "print" "property" "quit" "raise" "range" "repr" "return" "reversed"
    "round" "set" "setattr" "slice" "sorted" "staticmethod" "str" "sum" "super" "try"
    "tuple" "type" "vars" "while" "with" "yield" "zip")
      (tup "math" "re" "cdy_rt"))
    empty-map))

;; The characters py-mangle spells as letters.
(sig MANGLED (Map String String))
(def MANGLED (map-set (map-set (map-set empty-map "-" "_") "?" "_p") "!" "_x"))

;; A Candy name as a Python identifier: `-` to `_`, `?` to `_p`, `!` to `_x`, any other
;; character but an ASCII letter, digit or `_` to `_uXXXX`; a reserved name, or one
;; starting `_cdy_`, gets a trailing `_`.
(sig py-mangle (Fn (String) String))
(defn py-mangle (name)
  (let ((out (mangle-chars name 0 "")))
    (if (or (map-has PY_RESERVED out) (= (slice out 0 5) "_cdy_")) (+ out "_") out)))

(sig mangle-chars (Fn (String Int String) String))
(defn mangle-chars (name i acc)
  (if (= i (len name))
    acc
    (mangle-chars name (+ i 1) (+ acc (mangle-char (slice name i (+ i 1)))))))

(sig mangle-char (Fn (String) String))
(defn mangle-char (ch)
  (cond
    ((or (<= "a" ch "z") (<= "A" ch "Z") (<= "0" ch "9") (= ch "_")) ch)
    ((map-has MANGLED ch) (map-get MANGLED ch))
    (else (+ "_u" (hex (char-code ch) 4)))))

(sig HEX_DIGITS String)
(def HEX_DIGITS "0123456789abcdef")

;; `n` (not negative) in lower-case hexadecimal, with at least `width` digits.
(sig hex (Fn (Int Int) String))
(defn hex (n width)
  (let ((digit (slice HEX_DIGITS (- n (* 16 (quot n 16))) (+ (- n (* 16 (quot n 16))) 1))))
    (if (and (< n 16) (<= width 1)) digit (+ (hex (quot n 16) (- width 1)) digit))))

;; The string `s` as a Python literal, as Python's repr writes it: in single quotes, or in
;; double quotes if it has a single quote and no double quote; the quote, backslash,
;; newline, return and tab escaped, and other control characters as `\xhh`. Unlike repr, it
;; leaves other characters as they are (backlog [[B74]]).
(sig py-str (Fn (String) String))
(defn py-str (s)
  (let ((q (if (and (in "'" s) (not (in "\"" s))) "\"" "'")))
    (+ q (escape-chars s q 0 "") q)))

(sig escape-chars (Fn (String String Int String) String))
(defn escape-chars (s q i acc)
  (if (= i (len s))
    acc
    (escape-chars s q (+ i 1) (+ acc (escape-char (slice s i (+ i 1)) q)))))

(sig escape-char (Fn (String String) String))
(defn escape-char (ch q)
  (let ((code (char-code ch)))
    (cond
      ((or (= ch q) (= ch "\\")) (+ "\\" ch))
      ((= ch "\n") "\\n")
      ((= ch "\r") "\\r")
      ((= ch "\t") "\\t")
      ((or (< code 32) (<= 127 code 160)) (+ "\\x" (hex code 2)))
      (else ch))))

;; --- names ---

(sig global-names (Fn ((List Top) Env) Env))
(defn global-names (tops env)
  (if (= (len tops) 0)
    env
    (global-names (rest tops) (add-globals (top-names-of (at tops 0)) env))))

(sig add-globals (Fn ((List String) Env) Env))
(defn add-globals (names env)
  (if (= (len names) 0)
    env
    (let ((name (at names 0))
          (py (py-mangle name)))
      (if (and (map-has (get env taken) py) (not (map-has (get env globals) name)))
        (fail
          (format
            "{(candy-name (holder py (map-keys (get env globals)) (get env globals)))} and {(candy-name name)} are one name in Python ({py})"))
        (add-globals
          (rest names)
          (assoc env
            globals (map-set (get env globals) name py)
            taken (map-set (get env taken) py true)))))))

;; The Candy name in `names` whose Python name in `globals` is `py`.
(sig holder (Fn (String (List String) (Map String String)) String))
(defn holder (py names globals)
  (cond
    ((= (len names) 0) py)
    ((= (map-get globals (at names 0)) py) (at names 0))
    (else (holder py (rest names) globals))))

;; A top-level name as its program wrote it: `util__greet`, module `util`'s `greet`, is
;; `greet (in util)` (a name can't hold `__`, so the first `__` ends the module's prefix).
(sig candy-name (Fn (String) String))
(defn candy-name (name)
  (let ((parts (split name "__"))
        (own (join (rest parts) "__")))
    (if (= (len parts) 1) name (format "{own} (in {(at parts 0)})"))))

;; The top-level names a definition makes: a sum makes its type and its variants.
(sig top-names-of (Fn (Top) (List String)))
(defn top-names-of (top)
  (match top
    ((TDeftSum name _ variants) (+ (to-list name) (variant-list-names variants empty-list)))
    (else (if (= (top-name top) "") empty-list (to-list (top-name top))))))

(sig variant-list-names (Fn ((List Variant) (List String)) (List String)))
(defn variant-list-names (variants acc)
  (if (= (len variants) 0)
    acc
    (variant-list-names
      (rest variants)
      (+ acc (to-list (get (at variants 0) name))))))

(sig top-name (Fn (Top) String))
(defn top-name (top)
  (match top
    ((TDeft name _ _) name)
    ((TDef name _ _) name)
    ((TDefn name _ _ _) name)
    (else "")))

;; The variants of the generic sums in `tops`, added to `acc`.
(sig generic-variants (Fn ((List Top) (Map String Bool)) (Map String Bool)))
(defn generic-variants (tops acc)
  (if (= (len tops) 0)
    acc
    (generic-variants
      (rest tops)
      (match (at tops 0)
        ((TDeftSum _ tvars variants)
          (if (= (len tvars) 0) acc (mark-all (variant-list-names variants empty-list) acc)))
        (else acc)))))

(sig mark-all (Fn ((List String) (Map String Bool)) (Map String Bool)))
(defn mark-all (names acc)
  (if (= (len names) 0)
    acc
    (mark-all (rest names) (map-set acc (at names 0) true))))

;; A local's Python name, chosen when its scope was entered (bind-locals).
(sig local-py (Fn (String Int Env) String))
(defn local-py (name id env)
  (if (map-has (get env locals) id)
    (map-get (get env locals) id)
    (fail (format "emit: local {name} has no Python name"))))

;; Python names for locals bound in a new scope: each its own name, unless that is taken
;; here (by a top-level name, an enclosing local or an earlier local of this scope).
(sig bind-locals (Fn ((List Expr) Env) Env))
(defn bind-locals (locs env)
  (if (= (len locs) 0)
    env
    (bind-locals
      (rest locs)
      (match (at locs 0)
        ((Local name id)
          (if (map-has (get env locals) id)
            env
            (let ((base (py-mangle name))
                  (py (if (map-has (get env taken) base) (format "_cdy_{base}_{id}") base)))
              (assoc env
                locals (map-set (get env locals) id py)
                taken (map-set (get env taken) py true)))))
        (else env)))))

;; The locals assigned in stmts, in order (not looking inside nested functions).
(sig bound-locals (Fn ((List Stmt) (List Expr)) (List Expr)))
(defn bound-locals (stmts acc)
  (if (= (len stmts) 0)
    acc
    (bound-locals
      (rest stmts)
      (match (at stmts 0)
        ((SAssign target _)
          (match target
            ((Local _ _) (+ acc (to-list target)))
            (else acc)))
        ((SIf _ then other) (bound-locals other (bound-locals then acc)))
        ((SMatch _ _ cases default) (bound-in-cases cases (bound-in-lists default acc)))
        ((SLoop body) (bound-locals body acc))
        (else acc)))))

(sig bound-in-cases (Fn ((List Case) (List Expr)) (List Expr)))
(defn bound-in-cases (cases acc)
  (if (= (len cases) 0)
    acc
    (let ((c (at cases 0)))
      (bound-in-cases
        (rest cases)
        (bound-locals (get c body) (+ acc (bind-locs (get c binds) empty-list)))))))

(sig bind-locs (Fn ((List (Tup String Expr)) (List Expr)) (List Expr)))
(defn bind-locs (binds acc)
  (if (= (len binds) 0)
    acc
    (let (((_ loc) (at binds 0)))
      (bind-locs (rest binds) (+ acc (to-list loc))))))

(sig bound-in-lists (Fn ((List (List Stmt)) (List Expr)) (List Expr)))
(defn bound-in-lists (lists acc)
  (if (= (len lists) 0)
    acc
    (bound-in-lists (rest lists) (bound-locals (at lists 0) acc))))

;; --- expressions ---

(sig emit-expr (Fn (Expr Env) String))
(defn emit-expr (e env)
  (match e
    ((Lit form) (emit-lit form))
    ((Local name id) (local-py name id env))
    ((Global name) (map-get (get env globals) name))
    ((Prim name) (emit-prim name env))
    ((Call callee args) (emit-call callee args env))
    ((If test then other)
      (format "({(emit-expr then env)} if {(emit-expr test env)} else {(emit-expr other env)})"))
    ((Do _) (fail "emit: a do inside an expression (lower should have removed it)"))
    ((MatchE _ _ _) (fail "emit: a match inside an expression (lower should have removed it)"))
    ((Lambda params body)
      (let ((inner (bind-locals params env)))
        (format "(lambda {(comma-join (emit-exprs params inner empty-list))}: {(emit-expr body inner)})")))
    ((Tuple items)
      (let ((strs (emit-exprs items env empty-list)))
        (if (= (len strs) 1) (format "({(at strs 0)},)") (format "({(comma-join strs)})"))))
    ((Fmt parts) (emit-format parts env))
    ((Field obj field) (format "{(emit-expr obj env)}.{(py-mangle field)}"))
    ((Assoc obj fields)
      (format "{(emit-expr obj env)}._replace({(comma-join (emit-fields fields env empty-list))})"))
    ((Temp id) (format "_cdy_t{id}"))))

;; A format string as a concatenation: literal text, and str() of each hole.
(sig emit-format (Fn ((List FPart) Env) String))
(defn emit-format (parts env)
  (if (= (len parts) 0)
    "''"
    (format "({(join (emit-parts parts env empty-list) \" + \")})")))

(sig emit-parts (Fn ((List FPart) Env (List String)) (List String)))
(defn emit-parts (parts env acc)
  (if (= (len parts) 0)
    acc
    (emit-parts
      (rest parts)
      env
      (+ acc
         (to-list
           (match (at parts 0)
             ((FText text) (py-str text))
             ((FHole e) (format "str({(emit-expr e env)})"))))))))

(sig emit-fields (Fn ((List (Tup String Expr)) Env (List String)) (List String)))
(defn emit-fields (fields env acc)
  (if (= (len fields) 0)
    acc
    (let (((f v) (at fields 0)))
      (emit-fields
        (rest fields)
        env
        (+ acc (to-list (format "{(py-mangle f)}={(emit-expr v env)}")))))))

(sig emit-exprs (Fn ((List Expr) Env (List String)) (List String)))
(defn emit-exprs (exprs env acc)
  (if (= (len exprs) 0)
    acc
    (emit-exprs (rest exprs) env (+ acc (to-list (emit-expr (at exprs 0) env))))))

(sig emit-lit (Fn (Form) String))
(defn emit-lit (form)
  (match form
    ((Txt v) (py-str v))
    ((CharLit v) (py-str v))
    ((IntLit v) (format "{v}"))
    ((LongLit v) (format "{v}"))
    ((ByteLit v) (format "{v}"))
    ((FloatLit v) (format "{v}"))
    ((DoubleLit v) (format "{v}"))
    ((BoolLit v) (format "{v}"))
    (else (fail "emit: not a literal"))))

(sig emit-prim (Fn (String Env) String))
(defn emit-prim (name env)
  (if (in (spelling-kind (get env spellings) name) TYPED_KINDS)
    (at (map-get (get env spellings) name) 0)
    (fail (format "the operator {name} can't be used as a value yet; wrap it in a fn"))))

(sig emit-call (Fn (Expr (List Expr) Env) String))
(defn emit-call (callee args env)
  (let ((strs (emit-exprs args env empty-list)))
    (match callee
      ((Prim name) (emit-prim-call name strs env))
      (else (format "{(emit-expr callee env)}({(comma-join strs)})")))))

(sig emit-prim-call (Fn (String (List String) Env) String))
(defn emit-prim-call (name strs env)
  (let ((kind (at (map-get (get env spellings) name) 1))
        (py (at (map-get (get env spellings) name) 0))
        (op (+ " " py " ")))
    (cond
      ((in kind (tup "binop" "compare" "boolop")) (format "({(join strs op)})"))
      ((= kind "unary") (format "({py} {(at strs 0)})"))
      ((= kind "index") (format "{(at strs 0)}[{(at strs 1)}]"))
      ((= kind "slice") (format "{(at strs 0)}[{(at strs 1)}:{(at strs 2)}]"))
      (else (format "{py}({(comma-join strs)})")))))

;; --- types ---

(sig emit-type (Fn (CType Env) String))
(defn emit-type (t env)
  (match t
    ((TVar name) (py-mangle name))
    ((TFn params ret)
      (format "_cdy_Callable[[{(comma-join (emit-types params env empty-list))}], {(emit-type ret env)}]"))
    ((TCon name args) (emit-tcon name (emit-types args env empty-list) (get env spellings)))))

(sig emit-types (Fn ((List CType) Env (List String)) (List String)))
(defn emit-types (types env acc)
  (if (= (len types) 0)
    acc
    (emit-types (rest types) env (+ acc (to-list (emit-type (at types 0) env))))))

;; A built-in type's spelling.py entry (kind "type") is its Python text, with `{}` for its
;; arguments.
(sig emit-tcon (Fn (String (List String) (Map String (Tup String String))) String))
(defn emit-tcon (name args spellings)
  (cond
    ((and (map-has spellings name) (= (at (map-get spellings name) 1) "type"))
      (replace (at (map-get spellings name) 0) "{}" (comma-join args)))
    ((in name (tup "Int" "Long" "Byte")) "int")
    ((in name (tup "Float" "Double")) "float")
    ((= name "Bool") "bool")
    ((in name (tup "Char" "String")) "str")
    ((= name "Unit") "None")
    ((= name "Any") "_cdy_Any")
    ((= name "Maybe") (format "{(at args 0)} | None"))
    ((= name "List") (format "tuple[{(at args 0)}, ...]"))
    ((= name "Tup") (format "tuple[{(comma-join args)}]"))
    ((= name "Map") (format "_cdy_Mapping[{(comma-join args)}]"))
    ((= (len args) 0) (py-mangle name))
    (else (format "{(py-mangle name)}[{(comma-join args)}]"))))

;; The type variables in the types, in order of first use, without repeats.
(sig type-vars (Fn ((List CType) (List String)) (List String)))
(defn type-vars (types acc)
  (if (= (len types) 0)
    acc
    (type-vars
      (rest types)
      (match (at types 0)
        ((TVar name) (if (in name acc) acc (+ acc (to-list name))))
        ((TCon _ args) (type-vars args acc))
        ((TFn params ret) (type-vars (+ params (to-list ret)) acc))))))

;; --- statements ---

(sig emit-stmt (Fn (Stmt Int Env) String))
(defn emit-stmt (s level env)
  (match s
    ((SRecord name tvars fields)
      (+ "\n"
         (line level
           (format "class {(map-get (get env globals) name)}{(type-params tvars)}(_cdy_NamedTuple):"))
         (emit-record-fields fields (+ level 1) env "")))
    ((SSum name tvars variants)
      (+ (emit-variants variants tvars level env "")
         (line level
           (format "type {(map-get (get env globals) name)}{(type-params tvars)} = {(join (variant-refs variants tvars env empty-list) \" | \")}"))))
    ((SMatch temp subject cases default)
      (let ((t (emit-expr temp env))
            (val (emit-expr subject env))
            (generic (map-has (get env generic) (get (at cases 0) variant))))
        (+ (line level (if generic (format "{t} = {val}") (format "{t}: object = {val}")))
           (emit-match t cases default (and (not generic) (= (len default) 0)) "if" level env))))
    ((SLoop body) (+ (line level "while True:") (emit-block body (+ level 1) env)))
    ((SRebind targets vals)
      (line level
        (if (= (len targets) 1)
          (format "{(emit-expr (at targets 0) env)} = {(emit-expr (at vals 0) env)}")
          (format "{(comma-join (emit-exprs targets env empty-list))} = ({(comma-join (emit-exprs vals env empty-list))})"))))
    ((SContinue) (line level "continue"))
    ((SAssign target val)
      (line level (format "{(emit-expr target env)} = {(emit-expr val env)}")))
    ((SDefAssign name val t)
      (line level
        (format "{(map-get (get env globals) name)}: {(emit-type t env)} = {(emit-expr val env)}")))
    ((SExpr e) (line level (emit-expr e env)))
    ((SReturn e) (line level (format "return {(emit-expr e env)}")))
    ((SIf test then other) (emit-if "if" test then other level env))
    ((SFunc name params body t) (emit-func name params body t level env))
    ((SLocalFunc target params body)
      (let ((inner (bind-locals (+ params (bound-locals body empty-list)) env))
            (args (comma-join (emit-any-params params inner empty-list))))
        (+ (line level (format "def {(emit-expr target env)}({args}) -> _cdy_Any:"))
           (emit-block body (+ level 1) inner))))))

;; An if statement, or (`keyword` "elif") the rest of one. An else holding just an if
;; becomes an elif, so that a long cond doesn't nest one level deeper per clause (Python
;; allows 100).
(sig emit-if (Fn (String Expr (List Stmt) (List Stmt) Int Env) String))
(defn emit-if (keyword test then other level env)
  (+ (line level (format "{keyword} {(emit-expr test env)}:"))
     (emit-block then (+ level 1) env)
     (cond
       ((= (len other) 0) "")
       ((= (len other) 1)
         (match (at other 0)
           ((SIf test2 then2 other2) (emit-if "elif" test2 then2 other2 level env))
           (else (+ (line level "else:") (emit-block other (+ level 1) env)))))
       (else (+ (line level "else:") (emit-block other (+ level 1) env))))))

(sig emit-any-params (Fn ((List Expr) Env (List String)) (List String)))
(defn emit-any-params (params env acc)
  (if (= (len params) 0)
    acc
    (emit-any-params
      (rest params)
      env
      (+ acc (to-list (format "{(emit-expr (at params 0) env)}: _cdy_Any"))))))

;; PEP 695 type parameters: "" or "[a, b]".
(sig type-params (Fn ((List String)) String))
(defn type-params (tvars)
  (if (= (len tvars) 0) "" (format "[{(comma-join (mangle-all tvars empty-list))}]")))

(sig mangle-all (Fn ((List String) (List String)) (List String)))
(defn mangle-all (names acc)
  (if (= (len names) 0)
    acc
    (mangle-all (rest names) (+ acc (to-list (py-mangle (at names 0)))))))

(sig emit-record-fields (Fn ((List (Tup String CType)) Int Env String) String))
(defn emit-record-fields (fields level env acc)
  (if (= (len fields) 0)
    acc
    (let (((f t) (at fields 0)))
      (emit-record-fields
        (rest fields)
        level
        env
        (+ acc (line level (format "{(py-mangle f)}: {(emit-type t env)}")))))))

;; --- sums and match ---

;; The type variables of the sum that a variant's fields use, in the sum's order.
(sig used-tvars (Fn ((List String) (List String) (List String)) (List String)))
(defn used-tvars (tvars used acc)
  (if (= (len tvars) 0)
    acc
    (used-tvars
      (rest tvars)
      used
      (if (in (at tvars 0) used) (+ acc (to-list (at tvars 0))) acc))))

(sig field-types (Fn ((List (Tup String CType)) (List CType)) (List CType)))
(defn field-types (fields acc)
  (if (= (len fields) 0)
    acc
    (let (((_ t) (at fields 0)))
      (field-types (rest fields) (+ acc (to-list t))))))

(sig variant-tvars (Fn (Variant (List String)) (List String)))
(defn variant-tvars (v tvars)
  (used-tvars tvars (type-vars (field-types (get v fields) empty-list) empty-list) empty-list))

;; One NamedTuple class per variant; a variant with no fields gets `pass`.
(sig emit-variants (Fn ((List Variant) (List String) Int Env String) String))
(defn emit-variants (variants tvars level env acc)
  (if (= (len variants) 0)
    acc
    (let ((v (at variants 0))
          (head (format "class {(map-get (get env globals) (get v name))}{(type-params (variant-tvars v tvars))}(_cdy_NamedTuple):"))
          (body (if (= (len (get v fields)) 0)
                  (line (+ level 1) "pass")
                  (emit-record-fields (get v fields) (+ level 1) env ""))))
      (emit-variants (rest variants) tvars level env (+ acc "\n" (line level head) body)))))

;; Each variant as a member of the sum's union: `Leaf`, `Node[a]`.
(sig variant-refs (Fn ((List Variant) (List String) Env (List String)) (List String)))
(defn variant-refs (variants tvars env acc)
  (if (= (len variants) 0)
    acc
    (let ((v (at variants 0))
          (vt (variant-tvars v tvars)))
      (variant-refs
        (rest variants)
        tvars
        env
        (+ acc (to-list (+ (map-get (get env globals) (get v name)) (type-params vt))))))))

;; match as an isinstance chain on the temporary `subj` (mypy keeps generic type arguments
;; that way), each named field bound by attribute. The temporary is typed object unless the
;; sum is generic, which keeps mypy fast (doc/hl_rqmt/sum_types.md); then, with no else clause,
;; the last case is an else that asserts its variant (`assert-last`).
(sig emit-match (Fn (String (List Case) (List (List Stmt)) Bool String Int Env) String))
(defn emit-match (subj cases default assert-last keyword level env)
  (cond
    ((= (len cases) 0)
      (if (= (len default) 0)
        ""
        (+ (line level "else:") (emit-block (at default 0) (+ level 1) env))))
    ((and assert-last (= (len cases) 1))
      (let ((c (at cases 0))
            (inner (if (= keyword "if") level (+ level 1))))
        (+ (if (= keyword "if") "" (line level "else:"))
           (line inner (format "assert isinstance({subj}, {(map-get (get env globals) (get c variant))})"))
           (emit-binds (get c binds) subj inner env "")
           (emit-stmts (get c body) inner env ""))))
    (else
      (let ((c (at cases 0))
            (test (format "{keyword} isinstance({subj}, {(map-get (get env globals) (get c variant))}):"))
            (binds (emit-binds (get c binds) subj (+ level 1) env ""))
            (body (if (= (len (get c body)) 0)
                    (if (= binds "") (line (+ level 1) "pass") "")
                    (emit-stmts (get c body) (+ level 1) env ""))))
        (+ (line level test) binds body
           (emit-match subj (rest cases) default assert-last "elif" level env))))))

(sig emit-binds (Fn ((List (Tup String Expr)) String Int Env String) String))
(defn emit-binds (binds subj level env acc)
  (if (= (len binds) 0)
    acc
    (let (((f loc) (at binds 0)))
      (emit-binds
        (rest binds)
        subj
        level
        env
        (+ acc (line level (format "{(emit-expr loc env)} = {subj}.{(py-mangle f)}")))))))

(sig emit-stmts (Fn ((List Stmt) Int Env String) String))
(defn emit-stmts (stmts level env acc)
  (if (= (len stmts) 0)
    acc
    (emit-stmts (rest stmts) level env (+ acc (emit-stmt (at stmts 0) level env)))))

(sig emit-block (Fn ((List Stmt) Int Env) String))
(defn emit-block (stmts level env)
  (if (= (len stmts) 0) (line level "pass") (emit-stmts stmts level env "")))

(sig emit-params (Fn ((List Expr) (List CType) Env (List String)) (List String)))
(defn emit-params (params types env acc)
  (if (= (len params) 0)
    acc
    (emit-params
      (rest params)
      (rest types)
      env
      (+ acc (to-list (format "{(emit-expr (at params 0) env)}: {(emit-type (at types 0) env)}"))))))

(sig emit-func (Fn (String (List Expr) (List Stmt) CType Int Env) String))
(defn emit-func (name params body t level env)
  (match t
    ((TFn types ret)
      (let ((inner (bind-locals (+ params (bound-locals body empty-list)) env))
            (tvars (type-vars (+ types (to-list ret)) empty-list))
            (tparams (type-params tvars))
            (args (comma-join (emit-params params types inner empty-list))))
        (+ "\n"
           (line level
             (format "def {(map-get (get env globals) name)}{tparams}({args}) -> {(emit-type ret env)}:"))
           (emit-block body (+ level 1) inner))))
    (else (fail (format "defn {name}: its sig must be a function type")))))

;; --- module ---

(sig emit-imports (Fn ((List String) String) String))
(defn emit-imports (modules acc)
  (if (= (len modules) 0)
    acc
    (emit-imports (rest modules) (+ acc (format "import {(at modules 0)}\n")))))

;; Run `main` when the module is run, not imported (see has-main in core.cdy).
(sig emit-main (Fn (Env) String))
(defn emit-main (env)
  (let ((name (map-get (get env globals) "main")))
    (format "\n\nif __name__ == \"__main__\":\n{(indent 1)}cdy_rt.primitives.run_main({name})\n")))
