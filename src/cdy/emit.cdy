;;; Emit: lowered statements as Python source text (the third step; the Python backend).
;;; Unlike py_cdy/emit_py.py, which builds Python's ast, this writes text, as smz's
;;; render.py did. Every operator gets parentheses, so precedence never matters.

;; Python names: top-level names (Candy name -> Python name) and the Python names they
;; take, which a local must not reuse.
(deft Env ((globals (Map String String)) (taken (Map String Bool)) (table Any)))

(sig HEADER String)
(def HEADER "from __future__ import annotations

from collections.abc import Callable as _cdy_Callable, Mapping as _cdy_Mapping
from typing import Any as _cdy_Any, NamedTuple as _cdy_NamedTuple
")

(sig comma-join (Fn ((List String)) String))
(defn comma-join (strs) (join strs ", "))

(sig line (Fn (Int String) String))
(defn line (level text) (+ (get-indent level) text "\n"))

;; --- names ---

(sig global-names (Fn ((List Top) Env) Env))
(defn global-names (tops env)
  (if (= (len tops) 0)
    env
    (let ((name (top-name (at tops 0)))
          (py (py-mangle name)))
      (global-names
        (slice tops 1 (len tops))
        (if (= name "")
          env
          (assoc env
            globals (map-set (get env globals) name py)
            taken (map-set (get env taken) py true)))))))

(sig top-name (Fn (Top) String))
(defn top-name (top)
  (match top
    ((TDef name _ _) name)
    ((TDefn name _ _ _) name)
    (else "")))

;; A local's Python name: its own, unless a top-level name already took it.
(sig local-py (Fn (String Int Env) String))
(defn local-py (name id env)
  (let ((py (py-mangle name)))
    (if (map-has (get env taken) py) (format "_cdy_{py}_{id}") py)))

;; --- expressions ---

(sig emit-expr (Fn (Expr Env) String))
(defn emit-expr (e env)
  (match e
    ((Lit form) (emit-lit form))
    ((Local name id) (local-py name id env))
    ((Global name) (map-get (get env globals) name))
    ((Prim name) (emit-prim name env))
    ((Call callee args) (emit-call callee args env))
    ((If test then other)
      (format "({(emit-expr then env)} if {(emit-expr test env)} else {(emit-expr other env)})"))
    ((Do _) (fail "emit: a do inside an expression (lower should have removed it)"))
    ((Temp id) (format "_cdy_t{id}"))))

(sig emit-exprs (Fn ((List Expr) Env (List String)) (List String)))
(defn emit-exprs (exprs env acc)
  (if (= (len exprs) 0)
    acc
    (emit-exprs (slice exprs 1 (len exprs)) env (+ acc (to-list (emit-expr (at exprs 0) env))))))

(sig emit-lit (Fn (Form) String))
(defn emit-lit (form)
  (match form
    ((Txt v) (py-repr v))
    ((CharLit v) (py-repr v))
    ((IntLit v) (py-repr v))
    ((LongLit v) (py-repr v))
    ((ByteLit v) (py-repr v))
    ((FloatLit v) (py-repr v))
    ((DoubleLit v) (py-repr v))
    ((BoolLit v) (py-repr v))
    (else (fail "emit: not a literal"))))

(sig emit-prim (Fn (String Env) String))
(defn emit-prim (name env)
  (if (in (table-get-kind (get env table) name) (tup "call" "value" "index" "slice"))
    (table-get-py (get env table) name)
    (fail (format "the operator {name} can't be used as a value yet; wrap it in a fn"))))

(sig emit-call (Fn (Expr (List Expr) Env) String))
(defn emit-call (callee args env)
  (let ((strs (emit-exprs args env empty-list)))
    (match callee
      ((Prim name) (emit-prim-call name strs env))
      (else (format "{(emit-expr callee env)}({(comma-join strs)})")))))

(sig emit-prim-call (Fn (String (List String) Env) String))
(defn emit-prim-call (name strs env)
  (let ((kind (table-get-kind (get env table) name))
        (py (table-get-py (get env table) name))
        (op (+ " " py " ")))
    (cond
      ((in kind (tup "binop" "compare" "boolop")) (format "({(join strs op)})"))
      ((= kind "unary") (format "({py} {(at strs 0)})"))
      ((= kind "index") (format "{(at strs 0)}[{(at strs 1)}]"))
      ((= kind "slice") (format "{(at strs 0)}[{(at strs 1)}:{(at strs 2)}]"))
      (else (format "{py}({(comma-join strs)})")))))

;; --- types ---

(sig emit-type (Fn (CType Env) String))
(defn emit-type (t env)
  (match t
    ((TVar name) (py-mangle name))
    ((TFn params ret)
      (format "_cdy_Callable[[{(comma-join (emit-types params env empty-list))}], {(emit-type ret env)}]"))
    ((TCon name args) (emit-tcon name (emit-types args env empty-list)))))

(sig emit-types (Fn ((List CType) Env (List String)) (List String)))
(defn emit-types (types env acc)
  (if (= (len types) 0)
    acc
    (emit-types (slice types 1 (len types)) env (+ acc (to-list (emit-type (at types 0) env))))))

(sig emit-tcon (Fn (String (List String)) String))
(defn emit-tcon (name args)
  (cond
    ((in name (tup "Int" "Long" "Byte")) "int")
    ((in name (tup "Float" "Double")) "float")
    ((= name "Bool") "bool")
    ((in name (tup "Char" "String")) "str")
    ((= name "Unit") "None")
    ((= name "Any") "_cdy_Any")
    ((= name "Maybe") (format "{(at args 0)} | None"))
    ((= name "List") (format "tuple[{(at args 0)}, ...]"))
    ((= name "Tup") (format "tuple[{(comma-join args)}]"))
    ((= name "Map") (format "_cdy_Mapping[{(comma-join args)}]"))
    ((= (len args) 0) (py-mangle name))
    (else (format "{(py-mangle name)}[{(comma-join args)}]"))))

;; The type variables in the types, in order of first use, without repeats.
(sig type-vars (Fn ((List CType) (List String)) (List String)))
(defn type-vars (types acc)
  (if (= (len types) 0)
    acc
    (type-vars
      (slice types 1 (len types))
      (match (at types 0)
        ((TVar name) (if (in name acc) acc (+ acc (to-list name))))
        ((TCon _ args) (type-vars args acc))
        ((TFn params ret) (type-vars (+ params (to-list ret)) acc))))))

;; --- statements ---

(sig emit-stmt (Fn (Stmt Int Env) String))
(defn emit-stmt (s level env)
  (match s
    ((SAssign target val)
      (line level (format "{(emit-expr target env)} = {(emit-expr val env)}")))
    ((SDefAssign name val t)
      (line level
        (format "{(map-get (get env globals) name)}: {(emit-type t env)} = {(emit-expr val env)}")))
    ((SExpr e) (line level (emit-expr e env)))
    ((SReturn e) (line level (format "return {(emit-expr e env)}")))
    ((SIf test then other)
      (+ (line level (format "if {(emit-expr test env)}:"))
         (emit-block then (+ level 1) env)
         (if (= (len other) 0) "" (+ (line level "else:") (emit-block other (+ level 1) env)))))
    ((SFunc name params body t) (emit-func name params body t level env))))

(sig emit-stmts (Fn ((List Stmt) Int Env String) String))
(defn emit-stmts (stmts level env acc)
  (if (= (len stmts) 0)
    acc
    (emit-stmts (slice stmts 1 (len stmts)) level env (+ acc (emit-stmt (at stmts 0) level env)))))

(sig emit-block (Fn ((List Stmt) Int Env) String))
(defn emit-block (stmts level env)
  (if (= (len stmts) 0) (line level "pass") (emit-stmts stmts level env "")))

(sig emit-params (Fn ((List Expr) (List CType) Env (List String)) (List String)))
(defn emit-params (params types env acc)
  (if (= (len params) 0)
    acc
    (emit-params
      (slice params 1 (len params))
      (slice types 1 (len types))
      env
      (+ acc (to-list (format "{(emit-expr (at params 0) env)}: {(emit-type (at types 0) env)}"))))))

(sig emit-func (Fn (String (List Expr) (List Stmt) CType Int Env) String))
(defn emit-func (name params body t level env)
  (match t
    ((TFn types ret)
      (let ((tvars (type-vars (+ types (to-list ret)) empty-list))
            (tparams (if (= (len tvars) 0) "" (format "[{(comma-join tvars)}]")))
            (args (comma-join (emit-params params types env empty-list))))
        (+ "\n"
           (line level
             (format "def {(map-get (get env globals) name)}{tparams}({args}) -> {(emit-type ret env)}:"))
           (emit-block body (+ level 1) env))))
    (else (fail (format "defn {name}: its sig must be a function type")))))

;; --- module ---

(sig emit-imports (Fn ((List String) String) String))
(defn emit-imports (modules acc)
  (if (= (len modules) 0)
    acc
    (emit-imports (slice modules 1 (len modules)) (+ acc (format "import {(at modules 0)}\n")))))

;; --- the whole translator: forms in, Python source out ---

(sig translate (Fn ((List Form)) String))
(defn translate (forms)
  (let ((tops (analyse-program forms initial-table))
        (stmts (lower-program tops 0 empty-list))
        (env (global-names tops (Env empty-map empty-map initial-table))))
    (+ HEADER (emit-imports PY_IMPORTS "") "\n" (emit-stmts stmts 0 env ""))))
