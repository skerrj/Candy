;;; Lower: Core expressions split into statements (the second step; target-neutral).
;;; Mirrored the Python translator's lower_cdy.py (at tag self-host-py), in value, tail
;;; and effect modes. Unlike that translator, statements hold Core Exprs (plus Temp) instead
;;; of separate IR expressions; an If left in an expression is a conditional expression,
;;; and a Lambda a lambda.
;;; A let arrives as applied Lambdas and becomes assignments again.

(import core)

(deft Stmt
  (SRecord ((name String) (tvars (List String)) (fields (List (Tup String CType)))))
  (SSum ((name String) (tvars (List String)) (variants (List Variant))))
  ;; `subject` is evaluated once, into `temp` (a Temp). `default` is empty, or the else
  ;; clause's statements.
  (SMatch ((temp Expr) (subject Expr) (cases (List Case)) (default (List (List Stmt)))))
  (SAssign ((target Expr) (val Expr)))
  (SDefAssign ((name String) (val Expr) (t CType)))
  (SExpr ((expr Expr)))
  (SReturn ((val Expr)))
  (SIf ((test Expr) (then (List Stmt)) (other (List Stmt))))
  (SFunc ((name String) (params (List Expr)) (body (List Stmt)) (t CType)))
  ;; A nested function (a fn whose body needs statements), named by a Temp; typed Any.
  (SLocalFunc ((target Expr) (params (List Expr)) (body (List Stmt))))
  ;; A self tail call as a loop: `while True:`, the parameters rebound all at once, then
  ;; `continue`.
  (SLoop ((body (List Stmt))))
  (SRebind ((targets (List Expr)) (vals (List Expr))))
  (SContinue))

(deft Case ((variant String) (binds (List (Tup String Expr))) (body (List Stmt))))

;; An expression lowered in value mode: statements to run first, the value, the next Temp id.
(deft Low ((stmts (List Stmt)) (expr Expr) (n Int)))

;; Whether an expression can be evaluated later, out of order, with the same result.
(sig is-simple (Fn (Expr) Bool))
(defn is-simple (e)
  (match e
    ((Lit _) true)
    ((Local _ _) true)
    ((Global _) true)
    ((Prim _) true)
    ((Temp _) true)
    (else false)))

;; --- applied Lambdas (let) ---

;; Whether e is ((fn (a b) body) x y), as let desugars to.
(sig is-applied (Fn (Expr) Bool))
(defn is-applied (e)
  (match e
    ((Call callee args)
      (match callee
        ((Lambda params _) (= (len params) (len args)))
        (else false)))
    (else false)))

;; The assignments for an applied Lambda's parameters, and its body.
(sig bind-applied (Fn (Expr Int) (Tup (List Stmt) Expr Int)))
(defn bind-applied (e n)
  (match e
    ((Call callee args)
      (match callee
        ((Lambda params body)
          (let (((stmts vals n1) (value-seq args n)))
            (tup (+ stmts (assigns params vals empty-list)) body n1)))
        (else (fail "lower: not an applied fn"))))
    (else (fail "lower: not an applied fn"))))

(sig assigns (Fn ((List Expr) (List Expr) (List Stmt)) (List Stmt)))
(defn assigns (targets vals acc)
  (if (= (len targets) 0)
    acc
    (assigns
      (rest targets)
      (rest vals)
      (+ acc (to-list (SAssign (at targets 0) (at vals 0)))))))

;; --- value mode ---

(sig value (Fn (Expr Int) Low))
(defn value (e n)
  (if (is-applied e)
    (let (((stmts body n1) (bind-applied e n))
          (low (value body n1)))
      (Low (+ stmts (get low stmts)) (get low expr) (get low n)))
    (match e
      ((Call callee args) (value-call callee args n))
      ((If test then other) (value-if test then other n))
      ((Do body) (value-do body n))
      ((Lambda params body) (value-fn params body n))
      ((Tuple items)
        (let (((stmts vals n1) (value-seq items n)))
          (Low stmts (Tuple vals) n1)))
      ((Fmt parts)
        (let (((stmts vals n1) (value-seq (holes parts empty-list) n)))
          (Low stmts (Fmt (fill-holes parts vals empty-list)) n1)))
      ((Field obj field)
        (let ((low (value obj n)))
          (Low (get low stmts) (Field (get low expr) field) (get low n))))
      ((Assoc obj fields)
        (let (((stmts vals n1) (value-seq (+ (to-list obj) (field-vals fields empty-list)) n)))
          (Low stmts (Assoc (at vals 0) (refill fields (rest vals) empty-list)) n1)))
      ((MatchE _ _ _)
        (let ((tmp (Temp n))
              ((stmts n1) (lower-match e "value" tmp (+ n 1))))
          (Low stmts tmp n1)))
      (else (Low empty-list e n)))))

;; match as an SMatch, each clause's body lowered in `mode` ("value" assigns `tmp`).
(sig lower-match (Fn (Expr String Expr Int) (Tup (List Stmt) Int)))
(defn lower-match (e mode tmp n)
  (match e
    ((MatchE subject clauses default)
      (let ((low (value subject n))
            (temp (Temp (get low n)))
            ((cases n2) (lower-cases clauses mode tmp (+ (get low n) 1) empty-list))
            ((default-stmts n3) (lower-default default mode tmp n2)))
        (tup (+ (get low stmts) (to-list (SMatch temp (get low expr) cases default-stmts))) n3)))
    (else (fail "lower: not a match"))))

;; The else clause's statements: none, or one list.
(sig lower-default (Fn ((List Expr) String Expr Int) (Tup (List (List Stmt)) Int)))
(defn lower-default (default mode tmp n)
  (if (= (len default) 0)
    (tup empty-list n)
    (let (((stmts n1) (lower-body (at default 0) mode tmp n)))
      (tup (to-list stmts) n1))))

(sig lower-cases (Fn ((List Clause) String Expr Int (List Case)) (Tup (List Case) Int)))
(defn lower-cases (clauses mode tmp n acc)
  (if (= (len clauses) 0)
    (tup acc n)
    (let ((clause (at clauses 0))
          ((body n1) (lower-body (get clause body) mode tmp n)))
      (lower-cases
        (rest clauses)
        mode
        tmp
        n1
        (+ acc (to-list (Case (get clause variant) (get clause binds) body)))))))

(sig lower-body (Fn (Expr String Expr Int) (Tup (List Stmt) Int)))
(defn lower-body (e mode tmp n)
  (cond
    ((= mode "tail") (tail e n))
    ((= mode "effect") (effect e n))
    (else
      (let ((low (value e n)))
        (tup (+ (get low stmts) (to-list (SAssign tmp (get low expr)))) (get low n))))))

;; fn: a lambda if its body is one expression, otherwise a nested function.
(sig value-fn (Fn ((List Expr) Expr Int) Low))
(defn value-fn (params body n)
  (let (((stmts n1) (tail body n)))
    (match (if (= (len stmts) 1) (at stmts 0) (SExpr NIL))
      ((SReturn result) (Low empty-list (Lambda params result) n1))
      (else
        (Low (to-list (SLocalFunc (Temp n1) params stmts)) (Temp n1) (+ n1 1))))))

(sig holes (Fn ((List FPart) (List Expr)) (List Expr)))
(defn holes (parts acc)
  (if (= (len parts) 0)
    acc
    (holes
      (rest parts)
      (match (at parts 0)
        ((FHole e) (+ acc (to-list e)))
        ((FText _) acc)))))

;; The parts again, with the holes' lowered values in place.
(sig fill-holes (Fn ((List FPart) (List Expr) (List FPart)) (List FPart)))
(defn fill-holes (parts vals acc)
  (if (= (len parts) 0)
    acc
    (match (at parts 0)
      ((FHole _)
        (fill-holes (rest parts) (rest vals) (+ acc (to-list (FHole (at vals 0))))))
      ((FText text) (fill-holes (rest parts) vals (+ acc (to-list (FText text))))))))

(sig field-vals (Fn ((List (Tup String Expr)) (List Expr)) (List Expr)))
(defn field-vals (fields acc)
  (if (= (len fields) 0)
    acc
    (let (((_ v) (at fields 0)))
      (field-vals (rest fields) (+ acc (to-list v))))))

(sig refill (Fn ((List (Tup String Expr)) (List Expr) (List (Tup String Expr))) (List (Tup String Expr))))
(defn refill (fields vals acc)
  (if (= (len fields) 0)
    acc
    (let (((f _) (at fields 0)))
      (refill (rest fields) (rest vals) (+ acc (to-list (tup f (at vals 0))))))))

(sig value-call (Fn (Expr (List Expr) Int) Low))
(defn value-call (callee args n)
  (if (in (prim-name callee) (tup "and" "or"))
    (value-boolop callee args n)
    (let (((stmts items n1) (value-seq (+ (to-list callee) args) n)))
      (Low stmts (Call (at items 0) (rest items)) n1))))

(sig prim-name (Fn (Expr) String))
(defn prim-name (e)
  (match e
    ((Prim name) name)
    (else "")))

;; `and`/`or`: one Call, unless a later argument needs statements. They short-circuit, so
;; those statements can't run first: (and a b) becomes t = a; if t: t = b, and `or` tests
;; (not t).
(sig value-boolop (Fn (Expr (List Expr) Int) Low))
(defn value-boolop (op args n)
  (let (((lows n1) (low-all args n empty-list))
        (first (at lows 0))
        (later (rest lows)))
    (if (has-stmts later)
      (let ((tmp (Temp n1)))
        (Low
          (+ (get first stmts)
             (to-list (SAssign tmp (get first expr)))
             (to-list (guard op tmp (guarded op later tmp))))
          tmp
          (+ n1 1)))
      (Low (get first stmts) (Call op (low-exprs lows empty-list)) n1))))

;; The rest of `and`/`or`: each argument's statements, then its value into `tmp`, and the
;; ones after it only if that didn't decide the result.
(sig guarded (Fn (Expr (List Low) Expr) (List Stmt)))
(defn guarded (op lows tmp)
  (let ((low (at lows 0))
        (assign (+ (get low stmts) (to-list (SAssign tmp (get low expr))))))
    (if (= (len lows) 1)
      assign
      (+ assign (to-list (guard op tmp (guarded op (rest lows) tmp)))))))

(sig guard (Fn (Expr Expr (List Stmt)) Stmt))
(defn guard (op tmp body)
  (SIf (if (= (prim-name op) "and") tmp (Call (Prim "not") (to-list tmp))) body empty-list))

(sig low-exprs (Fn ((List Low) (List Expr)) (List Expr)))
(defn low-exprs (lows acc)
  (if (= (len lows) 0)
    acc
    (low-exprs (rest lows) (+ acc (to-list (get (at lows 0) expr))))))

;; Each expression in value mode, keeping left-to-right order: an earlier value that isn't
;; simple goes in a Temp if a later one needs statements.
(sig value-seq (Fn ((List Expr) Int) (Tup (List Stmt) (List Expr) Int)))
(defn value-seq (exprs n)
  (let (((lows n1) (low-all exprs n empty-list)))
    (seq-build lows n1 empty-list empty-list)))

(sig low-all (Fn ((List Expr) Int (List Low)) (Tup (List Low) Int)))
(defn low-all (exprs n acc)
  (if (= (len exprs) 0)
    (tup acc n)
    (let ((low (value (at exprs 0) n)))
      (low-all (rest exprs) (get low n) (+ acc (to-list low))))))

(sig has-stmts (Fn ((List Low)) Bool))
(defn has-stmts (lows)
  (cond
    ((= (len lows) 0) false)
    ((> (len (get (at lows 0) stmts)) 0) true)
    (else (has-stmts (rest lows)))))

(sig seq-build (Fn ((List Low) Int (List Stmt) (List Expr)) (Tup (List Stmt) (List Expr) Int)))
(defn seq-build (lows n stmts out)
  (if (= (len lows) 0)
    (tup stmts out n)
    (let ((low (at lows 0))
          (later (rest lows)))
      (if (and (has-stmts later) (not (is-simple (get low expr))))
        (seq-build
          later
          (+ n 1)
          (+ stmts (get low stmts) (to-list (SAssign (Temp n) (get low expr))))
          (+ out (to-list (Temp n))))
        (seq-build later n (+ stmts (get low stmts)) (+ out (to-list (get low expr))))))))

(sig value-if (Fn (Expr Expr Expr Int) Low))
(defn value-if (test then other n)
  (let ((t (value test n))
        (a (value then (get t n)))
        (b (value other (get a n))))
    (cond
      ((and (= (len (get a stmts)) 0) (= (len (get b stmts)) 0))
        (Low (get t stmts) (If (get t expr) (get a expr) (get b expr)) (get b n)))
      ;; The else is itself an if that assigns its Temp (as from a cond's next clause): this
      ;; if assigns the same Temp, so the else holds just that if, which emits as an elif.
      ((is-if-into (get b stmts) (get b expr))
        (let ((tmp (get b expr)))
          (Low
            (+ (get t stmts)
               (to-list
                 (SIf
                   (get t expr)
                   (+ (get a stmts) (to-list (SAssign tmp (get a expr))))
                   (get b stmts))))
            tmp
            (get b n))))
      (else
        (let ((tmp (Temp (get b n))))
          (Low
            (+ (get t stmts)
               (to-list
                 (SIf
                   (get t expr)
                   (+ (get a stmts) (to-list (SAssign tmp (get a expr))))
                   (+ (get b stmts) (to-list (SAssign tmp (get b expr)))))))
            tmp
            (+ (get b n) 1)))))))

;; Whether `stmts` and `e` are what value-if makes when it needs statements: one SIf, and
;; the Temp it assigns in every branch. (Nothing else lowers to just an SIf and a Temp: a
;; match makes an SMatch, and and/or an SAssign first.)
(sig is-if-into (Fn ((List Stmt) Expr) Bool))
(defn is-if-into (stmts e)
  (and (= (len stmts) 1)
       (match (at stmts 0)
         ((SIf _ _ _) true)
         (else false))
       (match e
         ((Temp _) true)
         (else false))))

(sig all-but-last (Fn ((List Expr)) (List Expr)))
(defn all-but-last (exprs) (slice exprs 0 (- (len exprs) 1)))

(sig last-of (Fn ((List Expr)) Expr))
(defn last-of (exprs) (at exprs (- (len exprs) 1)))

(sig value-do (Fn ((List Expr) Int) Low))
(defn value-do (body n)
  (let (((stmts n1) (effect-all (all-but-last body) n empty-list))
        (low (value (last-of body) n1)))
    (Low (+ stmts (get low stmts)) (get low expr) (get low n))))

;; --- tail and effect modes ---

(sig tail (Fn (Expr Int) (Tup (List Stmt) Int)))
(defn tail (e n)
  (if (is-applied e)
    (let (((stmts body n1) (bind-applied e n))
          ((more n2) (tail body n1)))
      (tup (+ stmts more) n2))
    (tail-plain e n)))

(sig tail-plain (Fn (Expr Int) (Tup (List Stmt) Int)))
(defn tail-plain (e n)
  (match e
    ((If test then other)
      (let ((t (value test n))
            ((a n1) (tail then (get t n)))
            ((b n2) (tail other n1)))
        (tup (+ (get t stmts) (to-list (SIf (get t expr) a b))) n2)))
    ((Do body)
      (let (((stmts n1) (effect-all (all-but-last body) n empty-list))
            ((last n2) (tail (last-of body) n1)))
        (tup (+ stmts last) n2)))
    ((MatchE _ _ _) (lower-match e "tail" NIL n))
    (else
      (let ((low (value e n)))
        (tup (+ (get low stmts) (to-list (SReturn (get low expr)))) (get low n))))))

(sig effect (Fn (Expr Int) (Tup (List Stmt) Int)))
(defn effect (e n)
  (if (is-applied e)
    (let (((stmts body n1) (bind-applied e n))
          ((more n2) (effect body n1)))
      (tup (+ stmts more) n2))
    (effect-plain e n)))

(sig effect-plain (Fn (Expr Int) (Tup (List Stmt) Int)))
(defn effect-plain (e n)
  (match e
    ((If test then other)
      (let ((t (value test n))
            ((a n1) (effect then (get t n)))
            ((b n2) (effect other n1)))
        (tup (+ (get t stmts) (to-list (SIf (get t expr) a b))) n2)))
    ((Do body) (effect-all body n empty-list))
    ((MatchE _ _ _) (lower-match e "effect" NIL n))
    (else
      (if (is-simple e)
        (tup empty-list n)
        (let ((low (value e n)))
          (tup (+ (get low stmts) (to-list (SExpr (get low expr)))) (get low n)))))))

(sig effect-all (Fn ((List Expr) Int (List Stmt)) (Tup (List Stmt) Int)))
(defn effect-all (exprs n acc)
  (if (= (len exprs) 0)
    (tup acc n)
    (let (((stmts n1) (effect (at exprs 0) n)))
      (effect-all (rest exprs) n1 (+ acc stmts)))))

;; --- top level ---

;; Whether a function type returns Unit (its body then runs for its effect only).
(sig returns-unit (Fn (CType) Bool))
(defn returns-unit (t)
  (match t
    ((TFn _ ret)
      (match ret
        ((TCon name _) (= name "Unit"))
        (else false)))
    (else false)))

(sig lower-top (Fn (Top Int) (Tup (List Stmt) Int)))
(defn lower-top (top n)
  (match top
    ((TDeft name tvars fields) (tup (to-list (SRecord name tvars fields)) n))
    ((TDeftSum name tvars variants) (tup (to-list (SSum name tvars variants)) n))
    ((TDef name init t)
      (let ((low (value init n)))
        (tup (+ (get low stmts) (to-list (SDefAssign name (get low expr) t))) (get low n))))
    ((TDefn name params body t)
      (let (((stmts n1) (if (returns-unit t) (effect body n) (tail body n))))
        (tup (to-list (SFunc name params (loop-tail-calls name params stmts (returns-unit t)) t)) n1)))
    ((TExpr e) (effect e n))))

;; --- self tail calls ---

;; The body as a loop, if its tail position calls the function itself. A function that makes
;; a closure is left alone: the closure would see the loop's later values. A Unit function
;; can fall off the end of its body, so its loop ends with a return.
(sig loop-tail-calls (Fn (String (List Expr) (List Stmt) Bool) (List Stmt)))
(defn loop-tail-calls (name params body unit)
  (if (stmts-have-closure body)
    body
    (let ((looped (retail-all body name params)))
      (if (= looped body)
        body
        (to-list (SLoop (if unit (+ looped (to-list (SReturn NIL))) looped)))))))

(sig retail-all (Fn ((List Stmt) String (List Expr)) (List Stmt)))
(defn retail-all (stmts name params)
  (if (= (len stmts) 0)
    stmts
    (+ (slice stmts 0 (- (len stmts) 1)) (retail (at stmts (- (len stmts) 1)) name params))))

;; A statement with its tail-position self calls replaced by jumps.
(sig retail (Fn (Stmt String (List Expr)) (List Stmt)))
(defn retail (s name params)
  (match s
    ((SReturn val) (if (is-self-call val name params) (jump params (call-args val)) (to-list s)))
    ((SExpr e) (if (is-self-call e name params) (jump params (call-args e)) (to-list s)))
    ((SIf test then other)
      (to-list (SIf test (retail-all then name params) (retail-all other name params))))
    ((SMatch temp subject cases default)
      (to-list
        (SMatch temp subject (retail-cases cases name params empty-list) (retail-lists default name params empty-list))))
    (else (to-list s))))

(sig retail-cases (Fn ((List Case) String (List Expr) (List Case)) (List Case)))
(defn retail-cases (cases name params acc)
  (if (= (len cases) 0)
    acc
    (let ((c (at cases 0)))
      (retail-cases
        (rest cases)
        name
        params
        (+ acc (to-list (assoc c body (retail-all (get c body) name params))))))))

(sig retail-lists (Fn ((List (List Stmt)) String (List Expr) (List (List Stmt))) (List (List Stmt))))
(defn retail-lists (lists name params acc)
  (if (= (len lists) 0)
    acc
    (retail-lists (rest lists) name params (+ acc (to-list (retail-all (at lists 0) name params))))))

(sig is-self-call (Fn (Expr String (List Expr)) Bool))
(defn is-self-call (e name params)
  (match e
    ((Call callee args)
      (match callee
        ((Global g) (and (= g name) (= (len args) (len params))))
        (else false)))
    (else false)))

(sig call-args (Fn (Expr) (List Expr)))
(defn call-args (e)
  (match e
    ((Call _ args) args)
    (else empty-list)))

;; Instead of calling the function again: new values for the parameters that change, then
;; go round.
(sig jump (Fn ((List Expr) (List Expr)) (List Stmt)))
(defn jump (params args)
  (let (((targets vals) (changed params args empty-list empty-list)))
    (if (= (len targets) 0)
      (to-list SContinue)
      (+ (to-list (SRebind targets vals)) (to-list SContinue)))))

(sig changed (Fn ((List Expr) (List Expr) (List Expr) (List Expr)) (Tup (List Expr) (List Expr))))
(defn changed (params args targets vals)
  (cond
    ((= (len params) 0) (tup targets vals))
    ((= (at params 0) (at args 0))
      (changed (rest params) (rest args) targets vals))
    (else
      (changed
        (rest params)
        (rest args)
        (+ targets (to-list (at params 0)))
        (+ vals (to-list (at args 0)))))))

;; Whether statements make a function (a nested def, or a lambda in any expression).
(sig stmts-have-closure (Fn ((List Stmt)) Bool))
(defn stmts-have-closure (stmts)
  (cond
    ((= (len stmts) 0) false)
    ((stmt-has-closure (at stmts 0)) true)
    (else (stmts-have-closure (rest stmts)))))

(sig stmt-has-closure (Fn (Stmt) Bool))
(defn stmt-has-closure (s)
  (match s
    ((SLocalFunc _ _ _) true)
    ((SAssign target val) (or (has-lambda target) (has-lambda val)))
    ((SDefAssign _ val _) (has-lambda val))
    ((SExpr e) (has-lambda e))
    ((SReturn val) (has-lambda val))
    ((SIf test then other)
      (or (has-lambda test) (stmts-have-closure then) (stmts-have-closure other)))
    ((SMatch _ subject cases default)
      (or (has-lambda subject) (cases-have-closure cases) (lists-have-closure default)))
    ((SLoop body) (stmts-have-closure body))
    ((SRebind _ vals) (any-lambda vals))
    (else false)))

(sig cases-have-closure (Fn ((List Case)) Bool))
(defn cases-have-closure (cases)
  (cond
    ((= (len cases) 0) false)
    ((stmts-have-closure (get (at cases 0) body)) true)
    (else (cases-have-closure (rest cases)))))

(sig lists-have-closure (Fn ((List (List Stmt))) Bool))
(defn lists-have-closure (lists)
  (cond
    ((= (len lists) 0) false)
    ((stmts-have-closure (at lists 0)) true)
    (else (lists-have-closure (rest lists)))))

(sig any-lambda (Fn ((List Expr)) Bool))
(defn any-lambda (exprs)
  (cond
    ((= (len exprs) 0) false)
    ((has-lambda (at exprs 0)) true)
    (else (any-lambda (rest exprs)))))

(sig has-lambda (Fn (Expr) Bool))
(defn has-lambda (e)
  (match e
    ((Lambda _ _) true)
    ((Call callee args) (or (has-lambda callee) (any-lambda args)))
    ((If test then other) (or (has-lambda test) (has-lambda then) (has-lambda other)))
    ((Do body) (any-lambda body))
    ((Tuple items) (any-lambda items))
    ((Fmt parts) (any-lambda (holes parts empty-list)))
    ((Field obj _) (has-lambda obj))
    ((Assoc obj fields) (or (has-lambda obj) (any-lambda (field-vals fields empty-list))))
    ((MatchE subject _ _) (has-lambda subject))
    (else false)))

(sig lower-program (Fn ((List Top) Int (List Stmt)) (List Stmt)))
(defn lower-program (tops n acc)
  (if (= (len tops) 0)
    acc
    (let (((stmts n1) (lower-top (at tops 0) n)))
      (lower-program (rest tops) n1 (+ acc stmts)))))
